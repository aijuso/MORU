[
  {
    "name": "theme_info",
    "theme_name": "MORU LIVING",
    "theme_version": "0.1.0",
    "theme_author": "MORU LIVING",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_display_font",
        "default": "cormorant_n4",
        "label": "t:labels.display_font",
        "info": "t:info.display_font"
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "default": "zen_kaku_gothic_new_n4",
        "label": "t:labels.heading_font",
        "info": "t:info.heading_font"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "default": "zen_kaku_gothic_new_n4",
        "label": "t:labels.body_font",
        "info": "t:info.body_font"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "header",
        "content": "t:labels.base_colors"
      },
      {
        "type": "color",
        "id": "background_color",
        "default": "#FAF8F5",
        "label": "t:labels.background",
        "info": "t:info.background"
      },
      {
        "type": "color",
        "id": "background_alt_color",
        "default": "#ECE6DE",
        "label": "t:labels.background_alt",
        "info": "t:info.background_alt"
      },
      {
        "type": "color",
        "id": "logo_color",
        "default": "#A8452F",
        "label": "t:labels.logo_color",
        "info": "t:info.logo_color"
      },
      {
        "type": "color",
        "id": "wood_color",
        "default": "#C69A6A",
        "label": "t:labels.wood",
        "info": "t:info.wood"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#242220",
        "label": "t:labels.foreground",
        "info": "t:info.foreground"
      },
      {
        "type": "color",
        "id": "muted_text_color",
        "default": "#5C5854",
        "label": "t:labels.muted_text",
        "info": "t:info.muted_text"
      },
      {
        "type": "color",
        "id": "border_color",
        "default": "#E6E0D8",
        "label": "t:labels.border",
        "info": "t:info.border"
      },
      {
        "type": "color",
        "id": "sale_color",
        "default": "#B85850",
        "label": "t:labels.sale",
        "info": "t:info.sale"
      },
      {
        "type": "header",
        "content": "t:labels.accent_colors",
        "info": "t:info.accent_colors"
      },
      {
        "type": "color",
        "id": "accent_olive_color",
        "default": "#777A52",
        "label": "t:labels.accent_olive"
      },
      {
        "type": "color",
        "id": "accent_terracotta_color",
        "default": "#C9653D",
        "label": "t:labels.accent_terracotta"
      },
      {
        "type": "color",
        "id": "accent_blue_color",
        "default": "#71899A",
        "label": "t:labels.accent_blue"
      },
      {
        "type": "color",
        "id": "accent_burgundy_color",
        "default": "#713C3D",
        "label": "t:labels.accent_burgundy"
      },
      {
        "type": "header",
        "content": "t:labels.shape"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 0
      },
      {
        "type": "range",
        "id": "card_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.card_corner_radius",
        "default": 2
      }
    ]
  },
  {
    "name": "t:labels.swatches",
    "settings": [
      {
        "type": "paragraph",
        "content": "t:info.swatch_color_map"
      },
      {
        "type": "textarea",
        "id": "swatch_color_map",
        "label": "t:labels.swatch_color_map",
        "default": "アイボリー:#E7D6CA\nオリーブグリーン:#7A7455"
      }
    ]
  }
]
