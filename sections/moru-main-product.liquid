{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign swatch_names = section.settings.swatch_option_names | downcase | split: ','
  assign has_real_options = false
  if product != blank and product.has_only_default_variant == false
    assign has_real_options = true
  endif
%}

<div class="moru-product" data-moru-product data-section-id="{{ section.id }}">
  {% if section.settings.show_breadcrumbs %}
    <nav class="moru-breadcrumbs" aria-label="{{ 'moru.product.breadcrumbs' | t }}">
      <ol>
        <li><a href="{{ routes.root_url }}">{{ 'moru.product.home' | t }}</a></li>
        {% if collection %}
          <li><a href="{{ collection.url }}">{{ collection.title }}</a></li>
        {% endif %}
        <li aria-current="page">{%- if product != blank -%}{{ product.title }}{%- else -%}{{ 'moru.placeholder.product_title' | t }}{%- endif -%}</li>
      </ol>
    </nav>
  {% endif %}

  <div class="moru-product__main">
    <moru-product-gallery class="moru-product__gallery">
      <div class="moru-product__stage">
        {% if section.settings.badge_text != blank %}
          <span class="moru-product__badge">{{ section.settings.badge_text }}</span>
        {% endif %}

        <div class="moru-product__stage-media">
          {% if product.media.size > 0 %}
            {% for media in product.media %}
              <div
                class="moru-product__slide{% if forloop.first %} is-active{% endif %}"
                data-media-id="{{ media.id }}"
              >
                {% liquid
                  assign media_loading = 'lazy'
                  if forloop.first
                    assign media_loading = 'eager'
                  endif
                %}
                {{ media.preview_image | image_url: width: 1400 | image_tag: loading: media_loading, widths: '400, 700, 1000, 1400', sizes: '(min-width: 990px) 55vw, 100vw', alt: media.alt }}
              </div>
            {% endfor %}
          {% else %}
            {% for i in (1..5) %}
              <div class="moru-product__slide{% if forloop.first %} is-active{% endif %}" data-media-id="ph-{{ forloop.index }}">
                {{ 'product-1' | placeholder_svg_tag: 'moru-product__placeholder' }}
              </div>
            {% endfor %}
          {% endif %}
        </div>

        <button type="button" class="moru-product__nav moru-product__nav--prev" data-gallery-prev aria-label="{{ 'moru.product.prev_image' | t }}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
        <button type="button" class="moru-product__nav moru-product__nav--next" data-gallery-next aria-label="{{ 'moru.product.next_image' | t }}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>

        <button type="button" class="moru-product__zoom" data-gallery-zoom aria-label="{{ 'moru.product.zoom' | t }}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            <line x1="11" y1="8" x2="11" y2="14"></line>
            <line x1="8" y1="11" x2="14" y2="11"></line>
          </svg>
        </button>
      </div>

      <ul class="moru-product__thumbs" role="list">
        {% if product.media.size > 0 %}
          {% for media in product.media %}
            <li>
              <button
                type="button"
                class="moru-product__thumb{% if forloop.first %} is-active{% endif %}"
                data-gallery-thumb
                data-media-id="{{ media.id }}"
                aria-label="{{ 'moru.product.thumbnail' | t: index: forloop.index }}"
              >
                {{ media.preview_image | image_url: width: 300, height: 300, crop: 'center' | image_tag: loading: 'lazy', alt: media.alt }}
              </button>
            </li>
          {% endfor %}
        {% else %}
          {% for i in (1..5) %}
            <li>
              <button
                type="button"
                class="moru-product__thumb{% if forloop.first %} is-active{% endif %}"
                data-gallery-thumb
                data-media-id="ph-{{ forloop.index }}"
                aria-label="{{ 'moru.product.thumbnail' | t: index: forloop.index }}"
              >
                {{ 'product-1' | placeholder_svg_tag }}
              </button>
            </li>
          {% endfor %}
        {% endif %}
      </ul>

      <dialog class="moru-product__lightbox" data-gallery-dialog scroll-lock>
        <button type="button" class="moru-product__lightbox-close" data-gallery-close aria-label="{{ 'moru.product.close' | t }}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" focusable="false">
            <line x1="6" y1="6" x2="18" y2="18"></line>
            <line x1="18" y1="6" x2="6" y2="18"></line>
          </svg>
        </button>
        <div class="moru-product__lightbox-media" data-gallery-dialog-media></div>
      </dialog>
    </moru-product-gallery>

    <div class="moru-product__info">
      <h1 class="moru-product__title">{%- if product != blank -%}{{ product.title }}{%- else -%}{{ 'moru.placeholder.product_title' | t }}{%- endif -%}</h1>

      <p class="moru-product__subtitle" data-moru-variant-subtitle>
        {%- if has_real_options -%}
          {{ current_variant.title }}
        {%- elsif product.metafields.custom.subtitle != blank -%}
          {{ product.metafields.custom.subtitle.value }}
        {%- else -%}
          {{ section.settings.subtitle }}
        {%- endif -%}
      </p>

      {% if section.settings.show_rating %}
        {% liquid
          assign rating_value = product.metafields.reviews.rating.value
          assign rating_count = product.metafields.reviews.rating_count.value | default: 0
        %}
        <div class="moru-product__rating">
          {% if rating_value != blank %}
            {% assign rating_rounded = rating_value.rating | round %}
            <span class="moru-rating-stars" aria-hidden="true">
              {%- for i in (1..5) -%}
                {%- if i <= rating_rounded -%}★{%- else -%}☆{%- endif -%}
              {%- endfor -%}
            </span>
            <strong>{{ rating_value.rating }}</strong>
            <span class="moru-product__rating-count">{{ 'moru.product.review_count' | t: count: rating_count }}</span>
          {% else %}
            <span class="moru-rating-stars moru-rating-stars--empty" aria-hidden="true">☆☆☆☆☆</span>
            <span class="moru-product__rating-count">{{ 'moru.product.rating_pending' | t }}</span>
          {% endif %}
        </div>
      {% endif %}

      <div class="moru-product__price-row">
        <span class="moru-product__price" data-moru-price>
          {%- if product != blank -%}
            {{ current_variant.price | money }}
          {%- else -%}
            {{ 'moru.placeholder.price' | t }}
          {%- endif -%}
        </span>
        {% if current_variant.compare_at_price > current_variant.price %}
          <s class="moru-product__compare" data-moru-compare>{{ current_variant.compare_at_price | money }}</s>
        {% else %}
          <s class="moru-product__compare" data-moru-compare hidden></s>
        {% endif %}
        {% if section.settings.tax_note != blank %}
          <span class="moru-product__tax-note">{{ section.settings.tax_note }}</span>
        {% endif %}
      </div>

      {%- liquid
        assign lead_text = product.metafields.custom.catch_copy.value
        if lead_text == blank
          assign lead_text = section.settings.short_description
        endif
      -%}
      {% if lead_text != blank %}
        <p class="moru-product__lead">{{ lead_text | newline_to_br }}</p>
      {% endif %}

      {% form 'product', product, class: 'moru-product__form', novalidate: 'novalidate' %}
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-moru-variant-id>

        {% if has_real_options %}
          <moru-variant-picker class="moru-product__options" data-url="{{ product.url }}">
            {% for option in product.options_with_values %}
              {% liquid
                assign option_name_down = option.name | downcase
                assign is_swatch = false
                for swatch_name in swatch_names
                  assign trimmed = swatch_name | strip
                  if option_name_down == trimmed
                    assign is_swatch = true
                  endif
                endfor
              %}
              <fieldset class="moru-option{% if is_swatch %} moru-option--swatch{% endif %}">
                <legend class="moru-option__label">
                  {{ option.name }}
                  {% if is_swatch %}
                    <span class="moru-option__value" data-moru-option-value="{{ option.position }}">
                      {{- option.selected_value -}}
                    </span>
                  {% endif %}
                </legend>

                <div class="moru-option__list">
                  {% for value in option.values %}
                    {% liquid
                      assign input_id = section.id | append: '-opt-' | append: option.position | append: '-' | append: forloop.index
                    %}
                    <input
                      type="radio"
                      class="moru-option__input"
                      id="{{ input_id }}"
                      name="{{ section.id }}-option-{{ option.position }}"
                      value="{{ value | escape }}"
                      data-option-position="{{ option.position }}"
                      {% if value.selected %}checked{% endif %}
                      {% unless value.available %}data-unavailable="true"{% endunless %}
                    >
                    <label class="moru-option__item" for="{{ input_id }}">
                      {% if is_swatch %}
                        {%- capture swatch_hex -%}
                          {%- render 'moru-swatch-color', value_name: value.name, swatch_color: value.swatch.color, product: product -%}
                        {%- endcapture -%}
                        {%- assign swatch_hex = swatch_hex | strip -%}
                        <span
                          class="moru-option__swatch"
                          {% if swatch_hex != blank %}style="--swatch-color: {{ swatch_hex }}"{% endif %}
                        >
                          {% if value.swatch.image %}
                            {{ value.swatch.image | image_url: width: 80, height: 80, crop: 'center' | image_tag: loading: 'lazy', alt: '' }}
                          {% endif %}
                        </span>
                        <span class="moru-option__swatch-name">{{ value }}</span>
                      {% else %}
                        <span class="moru-option__pill">{{ value }}</span>
                      {% endif %}
                    </label>
                  {% endfor %}
                </div>
              </fieldset>
            {% endfor %}

            <script type="application/json" data-variant-json>
              {{ product.variants | json }}
            </script>
          </moru-variant-picker>
        {% elsif section.settings.show_sample_options %}
          <div class="moru-product__options moru-product__options--sample">
            <fieldset class="moru-option moru-option--swatch">
              <legend class="moru-option__label">
                {{ 'moru.product.sample_color' | t }}
                <span class="moru-option__value">{{ 'moru.product.sample_color_1' | t }}</span>
              </legend>
              <div class="moru-option__list">
                {% for i in (1..3) %}
                  {% liquid
                    assign sample_id = section.id | append: '-sample-color-' | append: forloop.index
                    assign sample_name = 'moru.product.sample_color_' | append: forloop.index
                  %}
                  <input
                    type="radio"
                    class="moru-option__input"
                    id="{{ sample_id }}"
                    name="{{ section.id }}-sample-color"
                    {% if forloop.first %}checked{% endif %}
                  >
                  <label class="moru-option__item" for="{{ sample_id }}">
                    <span class="moru-option__swatch moru-option__swatch--sample-{{ forloop.index }}"></span>
                    <span class="moru-option__swatch-name">{{ sample_name | t }}</span>
                  </label>
                {% endfor %}
              </div>
            </fieldset>

            <fieldset class="moru-option">
              <legend class="moru-option__label">{{ 'moru.product.sample_size' | t }}</legend>
              <div class="moru-option__list">
                {% for i in (1..2) %}
                  {% liquid
                    assign sample_id = section.id | append: '-sample-size-' | append: forloop.index
                    assign sample_name = 'moru.product.sample_size_' | append: forloop.index
                  %}
                  <input
                    type="radio"
                    class="moru-option__input"
                    id="{{ sample_id }}"
                    name="{{ section.id }}-sample-size"
                    {% if forloop.first %}checked{% endif %}
                  >
                  <label class="moru-option__item" for="{{ sample_id }}">
                    <span class="moru-option__pill">{{ sample_name | t }}</span>
                  </label>
                {% endfor %}
              </div>
            </fieldset>

            <p class="moru-product__sample-note">{{ 'moru.product.sample_note' | t }}</p>
          </div>
        {% endif %}

        {%- capture cart_json -%}
          {
          {%- for line_item in cart.items -%}
            "{{ line_item.variant_id }}": {{ line_item.quantity }}{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
          }
        {%- endcapture -%}

        {%- capture inventory_json -%}
          {
          {%- for variant in product.variants -%}
            "{{ variant.id }}": {{ variant.inventory_quantity | default: 0 }}{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
          }
        {%- endcapture -%}

        {%- liquid
          assign stock_mode = section.settings.stock_display
          assign low_threshold = section.settings.low_stock_threshold
          assign sold_out_text = 'moru.product.sold_out' | t
          assign stock_label = ''

          assign remaining_text = ''
          assign tracked_quantity = 0
          if current_variant.inventory_management != blank
            assign tracked_quantity = current_variant.inventory_quantity
          endif

          # Show what is left for THIS shopper: real stock minus what they
          # already hold in their own cart. Nobody else's cart is involved and
          # the inventory itself is untouched — only the number shown changes.
          assign in_cart = 0
          assign hold_until = 0
          assign hold_ms = settings.cart_hold_hours | times: 3600000
          for line_item in cart.items
            if line_item.variant_id == current_variant.id
              assign in_cart = in_cart | plus: line_item.quantity
              if line_item.properties._added_at != blank
                assign candidate = line_item.properties._added_at | plus: hold_ms
                if hold_until == 0 or candidate < hold_until
                  assign hold_until = candidate
                endif
              endif
            endif
          endfor
          assign tracked_quantity = tracked_quantity | minus: in_cart
          if tracked_quantity < 0
            assign tracked_quantity = 0
          endif

          if tracked_quantity > 0
            assign remaining_text = 'moru.product.remaining' | t: count: tracked_quantity
          endif

          if product == blank
            unless stock_mode == 'hidden'
              assign stock_label = section.settings.low_stock_text
            endunless
          elsif current_variant.available == false
            assign stock_label = sold_out_text
          elsif tracked_quantity == 0 and in_cart > 0
            assign stock_label = 'moru.product.all_in_cart' | t
          elsif stock_mode == 'always'
            assign stock_label = section.settings.low_stock_text | append: ' ' | append: remaining_text | strip
          elsif stock_mode == 'inventory'
            if tracked_quantity > 0 and tracked_quantity <= low_threshold
              assign stock_label = section.settings.low_stock_text | append: ' ' | append: remaining_text | strip
            endif
          endif
        -%}

        <div class="moru-product__qty-row">
          <div class="moru-product__qty">
            <span class="moru-product__qty-label">{{ 'moru.product.quantity' | t }}</span>
            <moru-quantity class="moru-product__stepper">
              <button type="button" data-qty-minus aria-label="{{ 'moru.product.qty_minus' | t }}">&minus;</button>
              <input
                type="number"
                name="quantity"
                value="1"
                min="1"
                step="1"
                aria-label="{{ 'moru.product.quantity' | t }}"
                data-qty-input
              >
              <button type="button" data-qty-plus aria-label="{{ 'moru.product.qty_plus' | t }}">&plus;</button>
            </moru-quantity>
          </div>

          <span
            class="moru-product__stock"
            data-moru-stock
            data-mode="{{ stock_mode }}"
            data-inventory="{{ inventory_json | strip | escape }}"
            data-in-cart="{{ cart_json | strip | escape }}"
            data-threshold="{{ low_threshold }}"
            data-label="{{ section.settings.low_stock_text | escape }}"
            data-remaining="{{ 'moru.product.remaining' | t: count: '__COUNT__' | escape }}"
            data-sold-out="{{ 'moru.product.sold_out' | t | escape }}"
            data-all-in-cart="{{ 'moru.product.all_in_cart' | t | escape }}"
          >{{ stock_label }}</span>
        </div>

        {% if settings.cart_hold_enabled and hold_until > 0 %}
          <p
            class="moru-product__hold"
            data-hold-until="{{ hold_until }}"
            data-hold-template="{{ 'moru.product.hold_remaining' | t: time: '__TIME__' | escape }}"
            data-hold-expired="{{ 'moru.cart.hold_expired' | t | escape }}"
          ></p>
        {% endif %}

        <div class="moru-product__actions">
          <button
            type="submit"
            name="add"
            class="moru-product__add"
            data-moru-add-button
            {% if product != blank and current_variant.available == false %}disabled{% endif %}
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"></path>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <path d="M16 10a4 4 0 0 1-8 0"></path>
            </svg>
            <span
              data-moru-add-label
              data-available="{{ 'moru.product.add_to_cart' | t | escape }}"
              data-sold-out="{{ 'moru.product.sold_out' | t | escape }}"
            data-all-in-cart="{{ 'moru.product.all_in_cart' | t | escape }}"
            >
              {%- if product != blank and current_variant.available == false -%}
                {{ 'moru.product.sold_out' | t }}
              {%- else -%}
                {{ 'moru.product.add_to_cart' | t }}
              {%- endif -%}
            </span>
          </button>

          {% if section.settings.show_wishlist %}
            <button type="button" class="moru-product__wishlist" data-moru-wishlist aria-pressed="false">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path>
              </svg>
              <span
                data-moru-wishlist-label
                data-add="{{ 'moru.product.wishlist' | t | escape }}"
                data-added="{{ 'moru.product.wishlist_added' | t | escape }}"
              >{{ 'moru.product.wishlist' | t }}</span>
            </button>
          {% endif %}
        </div>

        {% if section.settings.show_express_checkout %}
          <div class="moru-product__express">
            <div class="moru-product__express-divider">
              <span>{{ 'moru.product.express_checkout' | t }}</span>
            </div>
            {{ form | payment_button }}
          </div>
        {% endif %}
      {% endform %}
    </div>
  </div>

  {% if section.blocks.size > 0 %}
    <ul class="moru-product__trust" role="list">
      {% for block in section.blocks %}
        <li class="moru-product__trust-item" {{ block.shopify_attributes }}>
          <span class="moru-product__trust-icon">
            {% case block.settings.icon %}
              {% when 'truck' %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                  <rect x="1" y="4" width="14" height="12" rx="1"></rect>
                  <path d="M15 9h4l3 3v4h-7V9Z"></path>
                  <circle cx="5.5" cy="18.5" r="2"></circle>
                  <circle cx="18.5" cy="18.5" r="2"></circle>
                </svg>
              {% when 'return' %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                  <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
                  <path d="M3 3v5h5"></path>
                </svg>
              {% when 'lock' %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                  <rect x="3" y="11" width="18" height="11" rx="2"></rect>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
              {% else %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                  <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"></path>
                  <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                  <line x1="12" y1="22.08" x2="12" y2="12"></line>
                </svg>
            {% endcase %}
          </span>
          <span class="moru-product__trust-text">
            <span class="moru-product__trust-title">{{ block.settings.title }}</span>
            {% if block.settings.text != blank %}
              <span class="moru-product__trust-desc">{{ block.settings.text | newline_to_br }}</span>
            {% endif %}
          </span>
        </li>
      {% endfor %}
    </ul>
  {% endif %}

  {% if section.settings.delivery_title != blank %}
    <div class="moru-delivery">
      <div class="moru-delivery__info">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <rect x="1" y="4" width="14" height="12" rx="1"></rect>
          <path d="M15 9h4l3 3v4h-7V9Z"></path>
          <circle cx="5.5" cy="18.5" r="2"></circle>
          <circle cx="18.5" cy="18.5" r="2"></circle>
        </svg>
        <span class="moru-delivery__title">{{ section.settings.delivery_title }}</span>
        <span class="moru-delivery__dates">
          {% if section.settings.delivery_main != blank %}
            <span class="moru-delivery__main">{{ section.settings.delivery_main }}</span>
          {% endif %}
          {% if section.settings.delivery_sub != blank %}
            <span class="moru-delivery__sub">{{ section.settings.delivery_sub }}</span>
          {% endif %}
        </span>
      </div>

      {% if section.settings.zip_label != blank %}
        <a class="moru-delivery__zip" href="{{ section.settings.zip_link | default: '#' }}">
          {{ section.settings.zip_label }}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      {% endif %}
    </div>
  {% endif %}
</div>

{% stylesheet %}
  .moru-product {
    padding-block: var(--space-sm) var(--space-xl);
  }

  .moru-product h1,
  .moru-product h2,
  .moru-product h3 {
    font-family: var(--font-body--family);
    letter-spacing: 0.04em;
  }

  .moru-product__main {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: var(--space-2xl);
    margin-block-end: var(--space-xl);
  }

  /* Gallery */
  .moru-product__gallery {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

