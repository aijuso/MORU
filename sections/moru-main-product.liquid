{% javascript %}
  /**
   * Stock label = real inventory minus what THIS shopper already holds in
   * their own cart. Shopify's cart is per browser session, so two people
   * looking at the same page each see their own number and the inventory
   * itself never moves. Backend stock only changes when an order is placed.
   */
  function moruParseJson(value) {
    try {
      return JSON.parse(value);
    } catch (error) {
      return {};
    }
  }

  function renderStock(stockEl, variantId, available) {
    const mode = stockEl.dataset.mode;
    const inventory = moruParseJson(stockEl.dataset.inventory);
    const inCart = moruParseJson(stockEl.dataset.inCart);
    const threshold = parseInt(stockEl.dataset.threshold, 10) || 0;
    const label = stockEl.dataset.label || '';

    const stock = inventory[variantId];
    let remaining = typeof stock === 'number' ? stock - (inCart[variantId] || 0) : undefined;
    if (typeof remaining === 'number' && remaining < 0) remaining = 0;

    const remainingText =
      typeof remaining === 'number' && remaining > 0
        ? (stockEl.dataset.remaining || '').replace('__COUNT__', remaining)
        : '';

    const held = inCart[variantId] || 0;

    if (!available && held === 0) {
      stockEl.textContent = stockEl.dataset.soldOut || '';
    } else if (mode === 'hidden') {
      stockEl.textContent = '';
    } else if (remaining === 0 && held > 0) {
      // Not sold out — this shopper simply holds every remaining unit.
      stockEl.textContent = stockEl.dataset.allInCart || '';
    } else if (remaining === 0) {
      stockEl.textContent = stockEl.dataset.soldOut || '';
    } else if (mode === 'always') {
      stockEl.textContent = (label + ' ' + remainingText).trim();
    } else if (typeof remaining === 'number' && remaining > 0 && remaining <= threshold) {
      stockEl.textContent = (label + ' ' + remainingText).trim();
    } else {
      stockEl.textContent = '';
    }
  }

  // Re-read the cart after any add / quantity change and repaint the label.
  async function moruRefreshStockFromCart() {
    const stockEls = document.querySelectorAll('[data-moru-stock]');
    if (stockEls.length === 0) return;

    const root = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
    let cart;
    try {
      const response = await fetch(root + 'cart.js', { headers: { Accept: 'application/json' } });
      cart = await response.json();
    } catch (error) {
      return;
    }

    const counts = {};
    (cart.items || []).forEach((item) => {
      counts[item.variant_id] = (counts[item.variant_id] || 0) + item.quantity;
    });

    stockEls.forEach((stockEl) => {
      stockEl.dataset.inCart = JSON.stringify(counts);
      const form = stockEl.closest('.moru-product__info') || document;
      const idInput = form.querySelector('[data-moru-variant-id]');
      const variantId = idInput ? Number(idInput.value) : NaN;
      if (!variantId) return;
      const inventory = moruParseJson(stockEl.dataset.inventory);
      renderStock(stockEl, variantId, (inventory[variantId] || 0) > 0);
    });
  }

  document.addEventListener('moru:cart:updated', moruRefreshStockFromCart);

  class MoruProductGallery extends HTMLElement {
    connectedCallback() {
      this.slides = Array.from(this.querySelectorAll('.moru-product__slide'));
      this.thumbs = Array.from(this.querySelectorAll('[data-gallery-thumb]'));
      this.dialog = this.querySelector('[data-gallery-dialog]');
      this.dialogMedia = this.querySelector('[data-gallery-dialog-media]');
      this.index = 0;

      this.thumbs.forEach((thumb, i) => {
        thumb.addEventListener('click', () => this.select(i));
      });

      const prev = this.querySelector('[data-gallery-prev]');
      const next = this.querySelector('[data-gallery-next]');
      if (prev) prev.addEventListener('click', () => this.select(this.index - 1));
      if (next) next.addEventListener('click', () => this.select(this.index + 1));

      const zoom = this.querySelector('[data-gallery-zoom]');
      if (zoom && this.dialog) zoom.addEventListener('click', () => this.openZoom());

      const close = this.querySelector('[data-gallery-close]');
      if (close && this.dialog) close.addEventListener('click', () => this.dialog.close());
      if (this.dialog) {
        this.dialog.addEventListener('click', (event) => {
          if (event.target === this.dialog) this.dialog.close();
        });
      }
    }

    select(index) {
      if (!this.slides.length) return;
      const total = this.slides.length;
      this.index = (index + total) % total;
      this.slides.forEach((slide, i) => slide.classList.toggle('is-active', i === this.index));
      this.thumbs.forEach((thumb, i) => thumb.classList.toggle('is-active', i === this.index));
    }

    selectByMediaId(mediaId) {
      const target = this.slides.findIndex((slide) => slide.dataset.mediaId === String(mediaId));
      if (target > -1) this.select(target);
    }

    openZoom() {
      const active = this.slides[this.index];
      const media = active && active.querySelector('img, svg');
      if (!media) return;
      this.dialogMedia.innerHTML = '';
      const clone = media.cloneNode(true);
      clone.removeAttribute('sizes');
      clone.removeAttribute('loading');
      this.dialogMedia.appendChild(clone);
      this.dialog.showModal();
    }
  }

  class MoruQuantity extends HTMLElement {
    connectedCallback() {
      this.input = this.querySelector('[data-qty-input]');
      const minus = this.querySelector('[data-qty-minus]');
      const plus = this.querySelector('[data-qty-plus]');
      if (minus) minus.addEventListener('click', () => this.step(-1));
      if (plus) plus.addEventListener('click', () => this.step(1));
    }

    step(delta) {
      const current = parseInt(this.input.value, 10) || 1;
      this.input.value = Math.max(1, current + delta);
      this.input.dispatchEvent(new Event('change', { bubbles: true }));
    }
  }

  class MoruVariantPicker extends HTMLElement {
    connectedCallback() {
      const json = this.querySelector('[data-variant-json]');
      this.variants = json ? JSON.parse(json.textContent) : [];
      this.product = this.closest('[data-moru-product]');
      this.addEventListener('change', () => this.onChange());
    }

    get selectedValues() {
      return Array.from(this.querySelectorAll('input[type="radio"]:checked')).map((input) => input.value);
    }

    formatMoney(cents) {
      if (window.Shopify && typeof window.Shopify.formatMoney === 'function') {
        return window.Shopify.formatMoney(cents);
      }
      return '¥' + Math.round(cents / 100).toLocaleString('ja-JP');
    }

    onChange() {
      const values = this.selectedValues;
      const variant = this.variants.find((candidate) =>
        candidate.options.every((option, index) => option === values[index])
      );

      this.querySelectorAll('[data-moru-option-value]').forEach((el) => {
        const position = parseInt(el.dataset.moruOptionValue, 10);
        if (values[position - 1]) el.textContent = values[position - 1];
      });

      const idInput = this.product.querySelector('[data-moru-variant-id]');
      const priceEl = this.product.querySelector('[data-moru-price]');
      const compareEl = this.product.querySelector('[data-moru-compare]');
      const subtitleEl = this.product.querySelector('[data-moru-variant-subtitle]');
      const addButton = this.product.querySelector('[data-moru-add-button]');
      const addLabel = this.product.querySelector('[data-moru-add-label]');
      const stockEl = this.product.querySelector('[data-moru-stock]');
      const gallery = this.product.querySelector('moru-product-gallery');

      if (!variant) {
        if (addButton) addButton.disabled = true;
        if (addLabel) addLabel.textContent = addLabel.dataset.soldOut;
        return;
      }

      if (idInput) idInput.value = variant.id;
      if (subtitleEl) subtitleEl.textContent = variant.title;
      if (priceEl) priceEl.textContent = this.formatMoney(variant.price);

      if (compareEl) {
        if (variant.compare_at_price && variant.compare_at_price > variant.price) {
          compareEl.textContent = this.formatMoney(variant.compare_at_price);
          compareEl.hidden = false;
        } else {
          compareEl.hidden = true;
        }
      }

      if (addButton) addButton.disabled = !variant.available;
      if (addLabel) {
        addLabel.textContent = variant.available ? addLabel.dataset.available : addLabel.dataset.soldOut;
      }

      if (stockEl) renderStock(stockEl, variant.id, variant.available);

      if (gallery && variant.featured_media) {
        gallery.selectByMediaId(variant.featured_media.id);
      }

      if (this.dataset.url) {
        const url = new URL(window.location.href);
        url.searchParams.set('variant', variant.id);
        window.history.replaceState({}, '', url.toString());
      }
    }
  }

  if (!customElements.get('moru-product-gallery')) {
    customElements.define('moru-product-gallery', MoruProductGallery);
  }
  if (!customElements.get('moru-quantity')) {
    customElements.define('moru-quantity', MoruQuantity);
  }
  if (!customElements.get('moru-variant-picker')) {
    customElements.define('moru-variant-picker', MoruVariantPicker);
  }

  document.addEventListener('click', (event) => {
    const button = event.target.closest('[data-moru-wishlist]');
    if (!button) return;
    const pressed = button.getAttribute('aria-pressed') === 'true';
    button.setAttribute('aria-pressed', pressed ? 'false' : 'true');
    const label = button.querySelector('[data-moru-wishlist-label]');
    if (label) label.textContent = pressed ? label.dataset.add : label.dataset.added;
  });
{% endjavascript %}

