{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign swatch_names = section.settings.swatch_option_names | downcase | split: ','
%}

<div class="moru-product" data-moru-product data-section-id="{{ section.id }}">
  {% if section.settings.show_breadcrumbs %}
    <nav class="moru-breadcrumbs" aria-label="{{ 'moru.product.breadcrumbs' | t }}">
      <ol>
        <li><a href="{{ routes.root_url }}">{{ 'moru.product.home' | t }}</a></li>
        {% if collection %}
          <li><a href="{{ collection.url }}">{{ collection.title }}</a></li>
        {% endif %}
        <li aria-current="page">{{ product.title }}</li>
      </ol>
    </nav>
  {% endif %}

  <div class="moru-product__main">
    <moru-product-gallery class="moru-product__gallery">
      <div class="moru-product__stage">
        {% if section.settings.badge_text != blank %}
          <span class="moru-product__badge">{{ section.settings.badge_text }}</span>
        {% endif %}

        <div class="moru-product__stage-media">
          {% if product.media.size > 0 %}
            {% for media in product.media %}
              <div
                class="moru-product__slide{% if forloop.first %} is-active{% endif %}"
                data-media-id="{{ media.id }}"
              >
                {% liquid
                  assign media_loading = 'lazy'
                  if forloop.first
                    assign media_loading = 'eager'
                  endif
                %}
                {{ media.preview_image | image_url: width: 1400 | image_tag: loading: media_loading, widths: '400, 700, 1000, 1400', sizes: '(min-width: 990px) 55vw, 100vw', alt: media.alt }}
              </div>
            {% endfor %}
          {% else %}
            <div class="moru-product__slide is-active">
              {{ 'product-1' | placeholder_svg_tag: 'moru-product__placeholder' }}
            </div>
          {% endif %}
        </div>

        {% if product.media.size > 1 %}
          <button type="button" class="moru-product__nav moru-product__nav--prev" data-gallery-prev aria-label="{{ 'moru.product.prev_image' | t }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>
          <button type="button" class="moru-product__nav moru-product__nav--next" data-gallery-next aria-label="{{ 'moru.product.next_image' | t }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>
        {% endif %}

        {% if product.media.size > 0 %}
          <button type="button" class="moru-product__zoom" data-gallery-zoom aria-label="{{ 'moru.product.zoom' | t }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              <line x1="11" y1="8" x2="11" y2="14"></line>
              <line x1="8" y1="11" x2="14" y2="11"></line>
            </svg>
          </button>
        {% endif %}
      </div>

      {% if product.media.size > 1 %}
        <ul class="moru-product__thumbs" role="list">
          {% for media in product.media %}
            <li>
              <button
                type="button"
                class="moru-product__thumb{% if forloop.first %} is-active{% endif %}"
                data-gallery-thumb
                data-media-id="{{ media.id }}"
                aria-label="{{ 'moru.product.thumbnail' | t: index: forloop.index }}"
              >
                {{ media.preview_image | image_url: width: 300, height: 300, crop: 'center' | image_tag: loading: 'lazy', alt: media.alt }}
              </button>
            </li>
          {% endfor %}
        </ul>
      {% endif %}

      {% if product.media.size > 0 %}
        <dialog class="moru-product__lightbox" data-gallery-dialog scroll-lock>
          <button type="button" class="moru-product__lightbox-close" data-gallery-close aria-label="{{ 'moru.product.close' | t }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" focusable="false">
              <line x1="6" y1="6" x2="18" y2="18"></line>
              <line x1="18" y1="6" x2="6" y2="18"></line>
            </svg>
          </button>
          <div class="moru-product__lightbox-media" data-gallery-dialog-media></div>
        </dialog>
      {% endif %}
    </moru-product-gallery>

    <div class="moru-product__info">
      <h1 class="moru-product__title">{{ product.title }}</h1>

      <p class="moru-product__subtitle" data-moru-variant-subtitle>
        {%- if product.has_only_default_variant -%}
          {{ section.settings.subtitle }}
        {%- else -%}
          {{ current_variant.title }}
        {%- endif -%}
      </p>

      {% if section.settings.show_rating and product.metafields.reviews.rating.value != blank %}
        {% liquid
          assign rating = product.metafields.reviews.rating.value.rating
          assign rating_count = product.metafields.reviews.rating_count.value | default: 0
          assign rating_rounded = rating | round
        %}
        <div class="moru-product__rating">
          <span class="moru-rating-stars" aria-hidden="true">
            {%- for i in (1..5) -%}
              {%- if i <= rating_rounded -%}★{%- else -%}☆{%- endif -%}
            {%- endfor -%}
          </span>
          <strong>{{ rating }}</strong>
          <span class="moru-product__rating-count">{{ 'moru.product.review_count' | t: count: rating_count }}</span>
        </div>
      {% endif %}

      <div class="moru-product__price-row">
        <span class="moru-product__price" data-moru-price>{{ current_variant.price | money }}</span>
        {% if section.settings.tax_note != blank %}
          <span class="moru-product__tax-note">{{ section.settings.tax_note }}</span>
        {% endif %}
      </div>

      {% if section.settings.short_description != blank %}
        <p class="moru-product__lead">{{ section.settings.short_description }}</p>
      {% endif %}

      {% form 'product', product, class: 'moru-product__form', novalidate: 'novalidate' %}
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-moru-variant-id>

        {% unless product.has_only_default_variant %}
          <moru-variant-picker class="moru-product__options" data-url="{{ product.url }}">
            {% for option in product.options_with_values %}
              {% liquid
                assign option_name_down = option.name | downcase
                assign is_swatch = false
                for swatch_name in swatch_names
                  assign trimmed = swatch_name | strip
                  if option_name_down == trimmed
                    assign is_swatch = true
                  endif
                endfor
              %}
              <fieldset class="moru-option{% if is_swatch %} moru-option--swatch{% endif %}">
                <legend class="moru-option__label">
                  {{ option.name }}
                  <span class="moru-option__value" data-moru-option-value="{{ option.position }}">
                    {{- option.selected_value -}}
                  </span>
                </legend>

                <div class="moru-option__list">
                  {% for value in option.values %}
                    {% liquid
                      assign input_id = section.id | append: '-opt-' | append: option.position | append: '-' | append: forloop.index
                    %}
                    <input
                      type="radio"
                      class="moru-option__input"
                      id="{{ input_id }}"
                      name="{{ section.id }}-option-{{ option.position }}"
                      value="{{ value | escape }}"
                      data-option-position="{{ option.position }}"
                      {% if value.selected %}checked{% endif %}
                      {% unless value.available %}data-unavailable="true"{% endunless %}
                    >
                    <label class="moru-option__item" for="{{ input_id }}">
                      {% if is_swatch %}
                        <span
                          class="moru-option__swatch"
                          {% if value.swatch.color %}style="--swatch-color: {{ value.swatch.color }}"{% endif %}
                        >
                          {% if value.swatch.image %}
                            {{ value.swatch.image | image_url: width: 80, height: 80, crop: 'center' | image_tag: loading: 'lazy', alt: '' }}
                          {% endif %}
                        </span>
                        <span class="moru-option__swatch-name">{{ value }}</span>
                      {% else %}
                        <span class="moru-option__pill">{{ value }}</span>
                      {% endif %}
                    </label>
                  {% endfor %}
                </div>
              </fieldset>
            {% endfor %}

            <script type="application/json" data-variant-json>
              {{ product.variants | json }}
            </script>
          </moru-variant-picker>
        {% endunless %}

        <div class="moru-product__qty-row">
          <div class="moru-product__qty">
            <span class="moru-product__qty-label">{{ 'moru.product.quantity' | t }}</span>
            <moru-quantity class="moru-product__stepper">
              <button type="button" data-qty-minus aria-label="{{ 'moru.product.qty_minus' | t }}">&minus;</button>
              <input
                type="number"
                name="quantity"
                value="1"
                min="1"
                step="1"
                aria-label="{{ 'moru.product.quantity' | t }}"
                data-qty-input
              >
              <button type="button" data-qty-plus aria-label="{{ 'moru.product.qty_plus' | t }}">&plus;</button>
            </moru-quantity>
          </div>

          {%- capture inventory_json -%}
            {
            {%- for variant in product.variants -%}
              "{{ variant.id }}": {{ variant.inventory_quantity | default: 0 }}{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
            }
          {%- endcapture -%}
          <span
            class="moru-product__stock"
            data-moru-stock
            data-inventory="{{ inventory_json | strip | escape }}"
            data-threshold="{{ section.settings.low_stock_threshold }}"
            data-sold-out="{{ 'moru.product.sold_out' | t | escape }}"
            data-low-stock="{{ 'moru.product.low_stock' | t: count: '__COUNT__' | escape }}"
          >
            {%- liquid
              assign low_threshold = section.settings.low_stock_threshold
              assign stock_state = ''
              unless current_variant.available
                assign stock_state = 'soldout'
              endunless
              if current_variant.available and current_variant.inventory_management != blank and current_variant.inventory_policy == 'deny'
                if current_variant.inventory_quantity > 0 and current_variant.inventory_quantity <= low_threshold
                  assign stock_state = 'low'
                endif
              endif
            -%}
            {%- if stock_state == 'soldout' -%}
              {{ 'moru.product.sold_out' | t }}
            {%- elsif stock_state == 'low' -%}
              {{ 'moru.product.low_stock' | t: count: current_variant.inventory_quantity }}
            {%- endif -%}
          </span>
        </div>

        <div class="moru-product__actions">
          <button
            type="submit"
            name="add"
            class="moru-product__add"
            data-moru-add-button
            {% unless current_variant.available %}disabled{% endunless %}
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"></path>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <path d="M16 10a4 4 0 0 1-8 0"></path>
            </svg>
            <span
              data-moru-add-label
              data-available="{{ 'moru.product.add_to_cart' | t | escape }}"
              data-sold-out="{{ 'moru.product.sold_out' | t | escape }}"
            >
              {%- if current_variant.available -%}
                {{ 'moru.product.add_to_cart' | t }}
              {%- else -%}
                {{ 'moru.product.sold_out' | t }}
              {%- endif -%}
            </span>
          </button>

          {% if section.settings.show_wishlist %}
            <button type="button" class="moru-product__wishlist" data-moru-wishlist>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path>
              </svg>
              {{ 'moru.product.wishlist' | t }}
            </button>
          {% endif %}
        </div>

        {% if section.settings.show_express_checkout %}
          <div class="moru-product__express">
            <div class="moru-product__express-divider">
              <span>{{ 'moru.product.express_checkout' | t }}</span>
            </div>
            {{ form | payment_button }}
          </div>
        {% endif %}
      {% endform %}

      {% if section.settings.delivery_title != blank %}
        <div class="moru-product__delivery">
          <div class="moru-product__delivery-head">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <rect x="1" y="4" width="14" height="12" rx="1"></rect>
              <path d="M15 9h4l3 3v4h-7V9Z"></path>
              <circle cx="5.5" cy="18.5" r="2"></circle>
              <circle cx="18.5" cy="18.5" r="2"></circle>
            </svg>
            <span class="moru-product__delivery-title">{{ section.settings.delivery_title }}</span>
          </div>
          {% if section.settings.delivery_text != blank %}
            <p class="moru-product__delivery-text">{{ section.settings.delivery_text | newline_to_br }}</p>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>

  {% if section.blocks.size > 0 %}
    <ul class="moru-product__trust" role="list">
      {% for block in section.blocks %}
        <li class="moru-product__trust-item" {{ block.shopify_attributes }}>
          <span class="moru-product__trust-icon">
            {% case block.settings.icon %}
              {% when 'truck' %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                  <rect x="1" y="4" width="14" height="12" rx="1"></rect>
                  <path d="M15 9h4l3 3v4h-7V9Z"></path>
                  <circle cx="5.5" cy="18.5" r="2"></circle>
                  <circle cx="18.5" cy="18.5" r="2"></circle>
                </svg>
              {% when 'return' %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                  <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
                  <path d="M3 3v5h5"></path>
                </svg>
              {% when 'lock' %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                  <rect x="3" y="11" width="18" height="11" rx="2"></rect>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
              {% else %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                  <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"></path>
                  <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                  <line x1="12" y1="22.08" x2="12" y2="12"></line>
                </svg>
            {% endcase %}
          </span>
          <span class="moru-product__trust-text">
            <span class="moru-product__trust-title">{{ block.settings.title }}</span>
            {% if block.settings.text != blank %}
              <span class="moru-product__trust-desc">{{ block.settings.text | newline_to_br }}</span>
            {% endif %}
          </span>
        </li>
      {% endfor %}
    </ul>
  {% endif %}
</div>

{% stylesheet %}
  .moru-product {
    padding-block: var(--space-md) var(--space-2xl);
  }

  .moru-breadcrumbs {
    padding-block: var(--space-sm) var(--space-md);
    font-size: var(--font-size-xs);
    color: var(--color-muted);
  }

  .moru-breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .moru-breadcrumbs li + li::before {
    content: '›';
    margin-inline-end: var(--space-xs);
    color: var(--color-border);
  }

  .moru-breadcrumbs a {
    color: inherit;
    text-decoration: none;
  }

  .moru-breadcrumbs a:hover {
    text-decoration: underline;
  }

  .moru-product__main {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: var(--space-2xl);
    margin-block-end: var(--space-xl);
  }

  /* Gallery */
  .moru-product__gallery {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .moru-product__stage {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: var(--radius-card);
    background-color: var(--color-bg-alt);
  }

  .moru-product__stage-media,
  .moru-product__slide {
    position: absolute;
    inset: 0;
  }

  .moru-product__slide {
    opacity: 0;
    visibility: hidden;
    transition: opacity 300ms ease, visibility 300ms;
  }

  .moru-product__slide.is-active {
    opacity: 1;
    visibility: visible;
  }

  .moru-product__slide img,
  .moru-product__slide svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .moru-product__badge {
    position: absolute;
    top: var(--space-md);
    left: var(--space-md);
    z-index: 3;
    padding: var(--space-2xs) var(--space-sm);
    border-radius: 12px;
    background-color: color-mix(in srgb, var(--color-bg-alt) 92%, transparent);
    color: var(--color-text);
    font-size: var(--font-size-xs);
    letter-spacing: 0.05em;
  }

  .moru-product__nav,
  .moru-product__zoom {
    position: absolute;
    z-index: 3;
    display: grid;
    place-items: center;
    border: none;
    border-radius: 50%;
    background-color: color-mix(in srgb, var(--color-surface) 88%, transparent);
    color: var(--color-text);
    box-shadow: 0 2px 8px rgb(0 0 0 / 0.08);
    cursor: pointer;
    transition: background-color 200ms ease, transform 200ms ease;
  }

  .moru-product__nav {
    top: 50%;
    width: 2.375rem;
    height: 2.375rem;
    transform: translateY(-50%);
  }

  .moru-product__nav:hover,
  .moru-product__zoom:hover {
    background-color: var(--color-surface);
  }

  .moru-product__nav--prev {
    left: var(--space-sm);
  }

  .moru-product__nav--next {
    right: var(--space-sm);
  }

  .moru-product__zoom {
    right: var(--space-md);
    bottom: var(--space-md);
    width: 2.25rem;
    height: 2.25rem;
  }

  .moru-product__nav svg,
  .moru-product__zoom svg {
    width: 1.125rem;
    height: 1.125rem;
  }

  .moru-product__thumbs {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .moru-product__thumb {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    padding: 0;
    overflow: hidden;
    border: 1px solid transparent;
    border-radius: var(--style-border-radius-inputs);
    background-color: var(--color-bg-alt);
    opacity: 0.75;
    cursor: pointer;
    transition: opacity 200ms ease, border-color 200ms ease;
  }

  .moru-product__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .moru-product__thumb:hover,
  .moru-product__thumb.is-active {
    opacity: 1;
    border-color: var(--color-text);
  }

  .moru-product__lightbox {
    width: min(92vw, 60rem);
    max-width: none;
    padding: 0;
    border: none;
    border-radius: var(--radius-card);
    background-color: var(--color-bg);
  }

  .moru-product__lightbox::backdrop {
    background-color: rgb(0 0 0 / 0.6);
  }

  .moru-product__lightbox-media img {
    width: 100%;
    height: auto;
  }

  .moru-product__lightbox-close {
    position: absolute;
    top: var(--space-sm);
    right: var(--space-sm);
    z-index: 2;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: none;
    border-radius: 50%;
    background-color: var(--color-surface);
    color: var(--color-text);
    cursor: pointer;
  }

  .moru-product__lightbox-close svg {
    width: 1.125rem;
    height: 1.125rem;
  }

  /* Info column */
  .moru-product__info {
    display: flex;
    flex-direction: column;
  }

  .moru-product__title {
    margin: 0 0 var(--space-2xs);
    font-size: var(--font-size-xl);
    line-height: 1.35;
    letter-spacing: 0.04em;
  }

  .moru-product__subtitle {
    margin: 0 0 var(--space-sm);
    font-size: var(--font-size-sm);
    color: var(--color-muted);
  }

  .moru-product__rating {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    margin-block-end: var(--space-md);
    font-size: var(--font-size-sm);
  }

  .moru-rating-stars {
    letter-spacing: 2px;
    color: var(--color-text);
  }

  .moru-product__rating-count {
    color: var(--color-muted);
  }

  .moru-product__price-row {
    display: flex;
    align-items: baseline;
    gap: var(--space-xs);
    margin-block-end: var(--space-sm);
  }

  .moru-product__price {
    font-size: var(--font-size-xl);
    font-weight: 600;
  }

  .moru-product__tax-note {
    font-size: var(--font-size-sm);
    color: var(--color-muted);
  }

  .moru-product__lead {
    margin: 0 0 var(--space-md);
    padding-block-end: var(--space-md);
    border-block-end: 1px solid var(--color-border);
    font-size: var(--font-size-sm);
    line-height: 1.7;
  }

  .moru-product__form {
    margin: 0;
  }

  /* Options */
  .moru-option {
    margin: 0 0 var(--space-md);
    padding: 0;
    border: none;
  }

  .moru-option__label {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    padding: 0;
    margin-block-end: var(--space-xs);
    font-size: var(--font-size-sm);
    font-weight: 500;
  }

  .moru-option__value {
    font-weight: 400;
    color: var(--color-muted);
  }

  .moru-option__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .moru-option--swatch .moru-option__list {
    gap: var(--space-lg);
  }

  .moru-option__input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .moru-option__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2xs);
    cursor: pointer;
  }

  .moru-option__swatch {
    position: relative;
    display: block;
    width: 2.125rem;
    height: 2.125rem;
    overflow: hidden;
    border-radius: 50%;
    background-color: var(--swatch-color, var(--color-bg-alt));
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.1);
    transition: transform 200ms ease;
  }

  .moru-option__swatch img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .moru-option__input:checked + .moru-option__item .moru-option__swatch::after {
    content: '';
    position: absolute;
    inset: -4px;
    border: 1.5px solid var(--color-text);
    border-radius: 50%;
  }

  .moru-option__input:checked + .moru-option__item .moru-option__swatch {
    overflow: visible;
  }

  .moru-option__swatch-name {
    max-width: 5rem;
    font-size: var(--font-size-xs);
    line-height: 1.3;
    text-align: center;
    color: var(--color-muted);
  }

  .moru-option__pill {
    display: block;
    min-width: 5rem;
    padding: var(--space-xs) var(--space-md);
    border: 1px solid var(--color-border);
    border-radius: var(--style-border-radius-inputs);
    background-color: var(--color-surface);
    font-size: var(--font-size-sm);
    text-align: center;
  }

  .moru-option__input:checked + .moru-option__item .moru-option__pill {
    border-color: var(--color-text);
    box-shadow: inset 0 0 0 1px var(--color-text);
    font-weight: 600;
  }

  .moru-option__input[data-unavailable="true"] + .moru-option__item {
    opacity: 0.4;
  }

  .moru-option__input:focus-visible + .moru-option__item {
    outline: 2px solid var(--color-accent-terracotta);
    outline-offset: 3px;
  }

  /* Quantity + stock */
  .moru-product__qty-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    margin-block-end: var(--space-md);
  }

  .moru-product__qty {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .moru-product__qty-label {
    font-size: var(--font-size-sm);
    font-weight: 500;
  }

  .moru-product__stepper {
    display: flex;
    align-items: center;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--style-border-radius-inputs);
    background-color: var(--color-surface);
  }

  .moru-product__stepper button {
    width: 2rem;
    height: 2rem;
    display: grid;
    place-items: center;
    border: none;
    background: transparent;
    color: var(--color-text);
    font-size: var(--font-size-sm);
    cursor: pointer;
    transition: background-color 150ms ease;
  }

  .moru-product__stepper button:hover {
    background-color: var(--color-bg-alt);
  }

  .moru-product__stepper input {
    width: 2.5rem;
    border: none;
    background: transparent;
    text-align: center;
    font-size: var(--font-size-sm);
    -moz-appearance: textfield;
  }

  .moru-product__stepper input::-webkit-outer-spin-button,
  .moru-product__stepper input::-webkit-inner-spin-button {
    appearance: none;
    margin: 0;
  }

  .moru-product__stock {
    font-size: var(--font-size-xs);
    font-weight: 500;
    color: var(--color-accent-terracotta);
  }

  /* Actions */
  .moru-product__actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    margin-block-end: var(--space-md);
  }

  .moru-product__add {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-xs);
    height: 3rem;
    border: 1px solid var(--color-text);
    border-radius: var(--style-border-radius-inputs);
    background-color: var(--color-text);
    color: var(--color-bg);
    font-family: inherit;
    font-size: var(--font-size-sm);
    font-weight: 500;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: opacity 200ms ease;
  }

  .moru-product__add:hover {
    opacity: 0.85;
  }

  .moru-product__add[disabled] {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .moru-product__add svg {
    width: 1.125rem;
    height: 1.125rem;
  }

  .moru-product__wishlist {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-xs);
    height: 2.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--style-border-radius-inputs);
    background-color: var(--color-surface);
    color: var(--color-text);
    font-family: inherit;
    font-size: var(--font-size-sm);
    cursor: pointer;
    transition: border-color 200ms ease, background-color 200ms ease;
  }

  .moru-product__wishlist:hover {
    border-color: var(--color-muted);
    background-color: var(--color-bg-alt);
  }

  .moru-product__wishlist svg {
    width: 1rem;
    height: 1rem;
  }

  .moru-product__wishlist[aria-pressed="true"] {
    border-color: var(--color-text);
    background-color: var(--color-bg-alt);
  }

  /* Express checkout */
  .moru-product__express-divider {
    display: flex;
    align-items: center;
    margin-block-end: var(--space-sm);
    font-size: var(--font-size-xs);
    letter-spacing: var(--letter-spacing-wide);
    color: var(--color-muted);
  }

  .moru-product__express-divider::before,
  .moru-product__express-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background-color: var(--color-border);
  }

  .moru-product__express-divider span {
    padding-inline: var(--space-sm);
  }

  /* Delivery */
  .moru-product__delivery {
    margin-block-start: var(--space-md);
    padding: var(--space-md);
    border-radius: var(--radius-card);
    background-color: var(--color-bg-alt);
  }

  .moru-product__delivery-head {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .moru-product__delivery-head svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .moru-product__delivery-title {
    font-size: var(--font-size-sm);
    font-weight: 600;
  }

  .moru-product__delivery-text {
    margin: var(--space-xs) 0 0;
    font-size: var(--font-size-xs);
    line-height: 1.7;
    color: var(--color-muted);
  }

  /* Trust badges */
  .moru-product__trust {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
    margin: 0;
    padding: var(--space-md);
    list-style: none;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background-color: var(--color-bg-alt);
  }

  .moru-product__trust-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
  }

  .moru-product__trust-icon svg {
    width: 1.5rem;
    height: 1.5rem;
  }

  .moru-product__trust-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .moru-product__trust-title {
    font-size: var(--font-size-sm);
    font-weight: 600;
  }

  .moru-product__trust-desc {
    font-size: var(--font-size-xs);
    line-height: 1.5;
    color: var(--color-muted);
  }

  @media (max-width: 989px) {
    .moru-product__main {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }

    .moru-product__trust {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 599px) {
    .moru-product__trust {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% javascript %}
  class MoruProductGallery extends HTMLElement {
    connectedCallback() {
      this.slides = Array.from(this.querySelectorAll('.moru-product__slide'));
      this.thumbs = Array.from(this.querySelectorAll('[data-gallery-thumb]'));
      this.dialog = this.querySelector('[data-gallery-dialog]');
      this.dialogMedia = this.querySelector('[data-gallery-dialog-media]');
      this.index = 0;

      this.thumbs.forEach((thumb, i) => {
        thumb.addEventListener('click', () => this.select(i));
      });

      const prev = this.querySelector('[data-gallery-prev]');
      const next = this.querySelector('[data-gallery-next]');
      if (prev) prev.addEventListener('click', () => this.select(this.index - 1));
      if (next) next.addEventListener('click', () => this.select(this.index + 1));

      const zoom = this.querySelector('[data-gallery-zoom]');
      if (zoom && this.dialog) zoom.addEventListener('click', () => this.openZoom());

      const close = this.querySelector('[data-gallery-close]');
      if (close && this.dialog) close.addEventListener('click', () => this.dialog.close());
      if (this.dialog) {
        this.dialog.addEventListener('click', (e) => {
          if (e.target === this.dialog) this.dialog.close();
        });
      }
    }

    select(index) {
      if (!this.slides.length) return;
      const total = this.slides.length;
      this.index = (index + total) % total;
      this.slides.forEach((slide, i) => slide.classList.toggle('is-active', i === this.index));
      this.thumbs.forEach((thumb, i) => thumb.classList.toggle('is-active', i === this.index));
    }

    selectByMediaId(mediaId) {
      const target = this.slides.findIndex((slide) => slide.dataset.mediaId === String(mediaId));
      if (target > -1) this.select(target);
    }

    openZoom() {
      const active = this.slides[this.index];
      const img = active && active.querySelector('img');
      if (!img) return;
      this.dialogMedia.innerHTML = '';
      const clone = img.cloneNode(true);
      clone.removeAttribute('sizes');
      clone.removeAttribute('loading');
      this.dialogMedia.appendChild(clone);
      this.dialog.showModal();
    }
  }

  class MoruQuantity extends HTMLElement {
    connectedCallback() {
      this.input = this.querySelector('[data-qty-input]');
      const minus = this.querySelector('[data-qty-minus]');
      const plus = this.querySelector('[data-qty-plus]');
      if (minus) minus.addEventListener('click', () => this.step(-1));
      if (plus) plus.addEventListener('click', () => this.step(1));
    }

    step(delta) {
      const current = parseInt(this.input.value, 10) || 1;
      this.input.value = Math.max(1, current + delta);
      this.input.dispatchEvent(new Event('change', { bubbles: true }));
    }
  }

  class MoruVariantPicker extends HTMLElement {
    connectedCallback() {
      const json = this.querySelector('[data-variant-json]');
      this.variants = json ? JSON.parse(json.textContent) : [];
      this.product = this.closest('[data-moru-product]');
      this.addEventListener('change', () => this.onChange());
    }

    get selectedValues() {
      return Array.from(this.querySelectorAll('input[type="radio"]:checked')).map((input) => input.value);
    }

    onChange() {
      const values = this.selectedValues;
      const variant = this.variants.find((candidate) =>
        candidate.options.every((option, index) => option === values[index])
      );

      this.querySelectorAll('[data-moru-option-value]').forEach((el) => {
        const position = parseInt(el.dataset.moruOptionValue, 10);
        if (values[position - 1]) el.textContent = values[position - 1];
      });

      const idInput = this.product.querySelector('[data-moru-variant-id]');
      const priceEl = this.product.querySelector('[data-moru-price]');
      const subtitleEl = this.product.querySelector('[data-moru-variant-subtitle]');
      const addButton = this.product.querySelector('[data-moru-add-button]');
      const addLabel = this.product.querySelector('[data-moru-add-label]');
      const stockEl = this.product.querySelector('[data-moru-stock]');
      const gallery = this.product.querySelector('moru-product-gallery');

      if (!variant) {
        if (addButton) addButton.disabled = true;
        if (addLabel) addLabel.textContent = addLabel.dataset.soldOut || addLabel.textContent;
        return;
      }

      if (idInput) idInput.value = variant.id;
      if (subtitleEl) subtitleEl.textContent = variant.title;
      if (priceEl && window.Shopify && window.Shopify.formatMoney) {
        priceEl.textContent = window.Shopify.formatMoney(variant.price);
      } else if (priceEl && variant.price != null) {
        priceEl.textContent = '¥' + Math.round(variant.price / 100).toLocaleString('ja-JP');
      }

      if (addButton) addButton.disabled = !variant.available;
      if (addLabel) {
        addLabel.textContent = variant.available
          ? addLabel.dataset.available || addLabel.textContent
          : addLabel.dataset.soldOut || addLabel.textContent;
      }

      if (stockEl) {
        const inventory = stockEl.dataset.inventory ? JSON.parse(stockEl.dataset.inventory) : {};
        const threshold = parseInt(stockEl.dataset.threshold, 10) || 0;
        const remaining = inventory[variant.id];
        if (!variant.available) {
          stockEl.textContent = stockEl.dataset.soldOut || '';
        } else if (typeof remaining === 'number' && remaining > 0 && remaining <= threshold) {
          stockEl.textContent = (stockEl.dataset.lowStock || '').replace('__COUNT__', remaining);
        } else {
          stockEl.textContent = '';
        }
      }

      if (gallery && variant.featured_media) {
        gallery.selectByMediaId(variant.featured_media.id);
      }

      if (this.dataset.url) {
        const url = new URL(window.location.href);
        url.searchParams.set('variant', variant.id);
        window.history.replaceState({}, '', url.toString());
      }
    }
  }

  if (!customElements.get('moru-product-gallery')) {
    customElements.define('moru-product-gallery', MoruProductGallery);
  }
  if (!customElements.get('moru-quantity')) {
    customElements.define('moru-quantity', MoruQuantity);
  }
  if (!customElements.get('moru-variant-picker')) {
    customElements.define('moru-variant-picker', MoruVariantPicker);
  }

  document.addEventListener('click', (event) => {
    const button = event.target.closest('[data-moru-wishlist]');
    if (!button) return;
    const pressed = button.getAttribute('aria-pressed') === 'true';
    button.setAttribute('aria-pressed', pressed ? 'false' : 'true');
  });
{% endjavascript %}

