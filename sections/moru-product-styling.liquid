<div class="moru-styling">
  <div class="moru-section-header">
    <h2>{{ section.settings.title }}</h2>
    {% if section.settings.view_all_link != blank %}
      <a class="moru-section-header__link" href="{{ section.settings.view_all_link }}">
        {{ section.settings.view_all_label }} &rarr;
      </a>
    {% endif %}
  </div>

  <ul class="moru-styling__grid" role="list">
    {% for block in section.blocks %}
      <li class="moru-styling__card moru-card" {{ block.shopify_attributes }}>
        {% if block.settings.link != blank %}
          <a href="{{ block.settings.link }}">
            {% if block.settings.image %}
              {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450, 900', alt: block.settings.image.alt }}
            {% else %}
              {{ 'lifestyle-1' | placeholder_svg_tag }}
            {% endif %}
          </a>
        {% else %}
          {% if block.settings.image %}
            {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450, 900', alt: block.settings.image.alt }}
          {% else %}
            {{ 'lifestyle-1' | placeholder_svg_tag }}
          {% endif %}
        {% endif %}
      </li>
    {% else %}
      {% for i in (1..3) %}
        <li class="moru-styling__card moru-card">{{ 'lifestyle-2' | placeholder_svg_tag }}</li>
      {% endfor %}
    {% endfor %}
  </ul>
</div>

{% stylesheet %}
  .moru-styling {
    padding-block: var(--space-lg) var(--space-2xl);
  }

  .moru-styling__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .moru-styling__card {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background-color: var(--color-bg-alt);
  }

  .moru-styling__card a {
    display: block;
    width: 100%;
    height: 100%;
  }

  .moru-styling__card img,
  .moru-styling__card svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms ease;
  }

  .moru-styling__card:hover img {
    transform: scale(1.04);
  }

  @media (max-width: 989px) {
    .moru-styling__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 599px) {
    .moru-styling__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:moru.styling.name",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:moru.common.title",
      "default": "t:moru.styling.title_default"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "t:moru.category_browser.view_all_link_label"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "t:moru.common.view_all_label",
      "default": "t:moru.common.view_all_default"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "t:moru.styling.block_image_name",
      "limit": 6,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:moru.common.image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:moru.common.link"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "presets": [
    {
      "name": "t:moru.styling.name",
      "blocks": [
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        }
      ]
    }
  ]
}
{% endschema %}
