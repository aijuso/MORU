{% liquid
  assign terms = search.terms | strip
  assign terms_display = terms | escape
  assign has_terms = false
  if terms != blank
    assign has_terms = true
  endif

  assign type_count = search.types.size
  assign type_is_all = false
  if type_count == 0 or type_count > 2
    assign type_is_all = true
  endif

  assign type_is_product = false
  assign type_is_article = false
  assign type_is_page = false
  unless type_is_all
    if search.types contains 'product'
      assign type_is_product = true
    endif
    if search.types contains 'article'
      assign type_is_article = true
    endif
    if search.types contains 'page'
      assign type_is_page = true
    endif
  endunless

  assign base_query = terms | url_encode
  assign keyword_blocks = section.blocks | where: 'type', 'keyword'
%}

{% paginate search.results by section.settings.results_per_page %}
  {% liquid
    assign shown = paginate.current_offset | plus: paginate.page_size
    if shown > paginate.items
      assign shown = paginate.items
    endif
  %}

  <div class="moru-search" data-search-results data-section-id="{{ section.id }}" style="--grid-columns: {{ section.settings.columns }}">
    {% if section.settings.show_breadcrumbs %}
      <nav class="moru-breadcrumbs" aria-label="{{ 'moru.product.breadcrumbs' | t }}">
        <ol>
          <li><a href="{{ routes.root_url }}">{{ 'moru.product.home' | t }}</a></li>
          <li aria-current="page">{{ 'moru.search.heading' | t }}</li>
        </ol>
      </nav>
    {% endif %}

    <header class="moru-search__header">
      <p class="moru-display moru-search__eyebrow">{{ 'moru.search.eyebrow' | t }}</p>
      <h1 class="moru-search__title">
        {%- if has_terms -%}
          {{ 'moru.search.results_for' | t: terms: terms_display }}
        {%- else -%}
          {{ 'moru.search.heading' | t }}
        {%- endif -%}
      </h1>

      <form class="moru-search__form" action="{{ routes.search_url }}" method="get" role="search">
        <input type="hidden" name="options[prefix]" value="last">
        <label class="moru-search__form-label" for="{{ section.id }}-q">{{ 'moru.search.heading' | t }}</label>
        <input
          class="moru-search__input"
          id="{{ section.id }}-q"
          type="search"
          name="q"
          value="{{ terms_display }}"
          placeholder="{{ 'moru.search.placeholder' | t }}"
        >
        <button class="moru-search__submit" type="submit">{{ 'moru.search.submit' | t }}</button>
      </form>
    </header>

    {% if has_terms %}
      <div class="moru-search__toolbar">
        {% if section.settings.show_type_filter %}
          <div class="moru-search__pills">
            <a class="moru-pill{% if type_is_all %} is-active{% endif %}" href="{{ routes.search_url }}?q={{ base_query }}&options%5Bprefix%5D=last">
              {{- 'moru.search.type_all' | t -}}
            </a>
            <a class="moru-pill{% if type_is_product %} is-active{% endif %}" href="{{ routes.search_url }}?q={{ base_query }}&type=product&options%5Bprefix%5D=last">
              {{- 'moru.search.type_product' | t -}}
            </a>
            <a class="moru-pill{% if type_is_article %} is-active{% endif %}" href="{{ routes.search_url }}?q={{ base_query }}&type=article&options%5Bprefix%5D=last">
              {{- 'moru.search.type_article' | t -}}
            </a>
            <a class="moru-pill{% if type_is_page %} is-active{% endif %}" href="{{ routes.search_url }}?q={{ base_query }}&type=page&options%5Bprefix%5D=last">
              {{- 'moru.search.type_page' | t -}}
            </a>
          </div>
        {% else %}
          <div class="moru-search__pills"></div>
        {% endif %}

        <div class="moru-search__toolbar-right">
          {% if section.settings.show_sort and search.sort_options.size > 0 %}
            <form class="moru-search__sort" method="get" action="{{ routes.search_url }}">
              <input type="hidden" name="q" value="{{ terms_display }}">
              <input type="hidden" name="options[prefix]" value="last">
              {% unless type_is_all %}
                <input type="hidden" name="type" value="{{ search.types | join: ',' }}">
              {% endunless %}
              <label class="moru-search__sort-label" for="{{ section.id }}-sort">{{ 'moru.collection.sort_by' | t }}</label>
              <div class="moru-search__sort-control">
                <select id="{{ section.id }}-sort" name="sort_by" data-search-sort>
                  {% assign current_sort = search.sort_by | default: search.default_sort_by %}
                  {% for option in search.sort_options %}
                    <option value="{{ option.value }}" {% if option.value == current_sort %}selected{% endif %}>
                      {{ option.name }}
                    </option>
                  {% endfor %}
                </select>
                <svg viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                  <path d="M1 1l4 4 4-4"></path>
                </svg>
              </div>
              <noscript>
                <button type="submit" class="moru-search__sort-submit">{{ 'moru.collection.apply' | t }}</button>
              </noscript>
            </form>
          {% endif %}

          <span class="moru-search__count">{{ 'moru.collection.count' | t: count: paginate.items }}</span>
        </div>
      </div>
    {% endif %}

    {% if has_terms and paginate.items > 0 %}
      <ul class="moru-search__grid" role="list" data-search-items>
        {% for item in search.results %}
          <li>
            {%- if item.object_type == 'product' -%}
              {% render 'moru-product-card',
                product: item,
                show_swatches: section.settings.show_swatches,
                swatch_option_names: section.settings.swatch_option_names,
                show_subtitle: section.settings.show_subtitle
              %}
            {%- else -%}
              <a class="moru-search__doc" href="{{ item.url }}">
                <span class="moru-search__doc-type">
                  {%- if item.object_type == 'article' -%}
                    {{ 'moru.search.type_article' | t }}
                  {%- else -%}
                    {{ 'moru.search.type_page' | t }}
                  {%- endif -%}
                </span>
                <span class="moru-search__doc-title">{{ item.title }}</span>
                {% assign excerpt = item.content | strip_html | truncatewords: 34 %}
                {% if excerpt != blank %}
                  <span class="moru-search__doc-excerpt">{{ excerpt }}</span>
                {% endif %}
              </a>
            {%- endif -%}
          </li>
        {% endfor %}
      </ul>

      <div class="moru-search__footer">
        <p class="moru-search__shown" data-search-shown>
          {{ 'moru.collection.shown' | t: shown: shown, total: paginate.items }}
        </p>

        {% if paginate.next %}
          <a class="moru-search__more" href="{{ paginate.next.url }}" data-search-more>
            {{ 'moru.collection.load_more' | t }}
          </a>
        {% else %}
          <p class="moru-search__all-shown">{{ 'moru.collection.all_shown' | t }}</p>
        {% endif %}
      </div>
    {% else %}
      <div class="moru-search__empty">
        {% if has_terms %}
          <p class="moru-search__empty-heading">{{ 'moru.search.empty_heading' | t: terms: terms_display }}</p>
          <p class="moru-search__empty-help">{{ 'moru.search.empty_help' | t }}</p>
        {% else %}
          <p class="moru-search__empty-heading">{{ 'moru.search.prompt' | t }}</p>
        {% endif %}

        {% if keyword_blocks.size > 0 %}
          <div class="moru-search__suggestions">
            <p class="moru-search__suggestions-title">{{ 'moru.search.suggestions' | t }}</p>
            <div class="moru-search__pills">
              {% for block in keyword_blocks %}
                {% if block.settings.keyword != blank %}
                  <a
                    class="moru-pill"
                    href="{{ routes.search_url }}?q={{ block.settings.keyword | url_encode }}&options%5Bprefix%5D=last"
                    {{ block.shopify_attributes }}
                  >{{ block.settings.keyword }}</a>
                {% endif %}
              {% endfor %}
            </div>
          </div>
        {% endif %}

        <a class="moru-button moru-button--outline" href="{{ routes.all_products_collection_url }}">
          {{ 'moru.search.browse_all' | t }}
        </a>
      </div>
    {% endif %}
  </div>
{% endpaginate %}

{% stylesheet %}
  .moru-search {
    padding-block: var(--space-sm) var(--space-2xl);
  }

  .moru-search__header {
    margin-block-end: var(--space-xl);
    text-align: center;
  }

  .moru-search__eyebrow {
    margin: 0 0 var(--space-xs);
    font-size: var(--font-size-xs);
    color: var(--color-muted);
  }

  .moru-search__title {
    margin: 0 0 var(--space-lg);
    font-size: var(--font-size-2xl);
  }

  .moru-search__form {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    max-width: 620px;
    margin: 0 auto;
    padding-block-end: var(--space-2xs);
    border-block-end: 1px solid var(--color-text);
  }

  .moru-search__form-label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .moru-search__input {
    flex: 1;
    padding: var(--space-xs) var(--space-2xs);
    border: none;
    outline: none;
    background: transparent;
    color: var(--color-text);
    font-family: inherit;
    font-size: var(--font-size-sm);
    letter-spacing: 0.05em;
  }

  .moru-search__input::placeholder {
    color: var(--color-muted);
    opacity: 0.75;
  }

  .moru-search__submit {
    padding: var(--space-2xs) var(--space-md);
    border: none;
    background: none;
    color: var(--color-text);
    font-family: inherit;
    font-size: var(--font-size-xs);
    letter-spacing: var(--letter-spacing-wide);
    cursor: pointer;
  }

  .moru-search__toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    margin-block-end: var(--space-lg);
  }

  .moru-search__pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .moru-search__toolbar-right {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    font-size: var(--font-size-xs);
  }

  .moru-search__sort {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    margin: 0;
  }

  .moru-search__sort-label {
    white-space: nowrap;
  }

  .moru-search__sort-control {
    position: relative;
    display: flex;
    align-items: center;
  }

  .moru-search__sort-control select {
    appearance: none;
    padding: 0 var(--space-md) 0 0;
    border: none;
    background: transparent;
    color: var(--color-text);
    font-family: inherit;
    font-size: var(--font-size-xs);
    cursor: pointer;
  }

  .moru-search__sort-control svg {
    position: absolute;
    right: 0;
    width: 10px;
    height: 6px;
    pointer-events: none;
  }

  .moru-search__sort-submit {
    margin-inline-start: var(--space-xs);
    padding: 2px var(--space-xs);
    border: 1px solid var(--color-border);
    background: transparent;
    font-family: inherit;
    font-size: var(--font-size-xs);
    cursor: pointer;
  }

  .moru-search__count {
    color: var(--color-muted);
    white-space: nowrap;
  }

  .moru-search__grid {
    display: grid;
    grid-template-columns: repeat(var(--grid-columns, 4), 1fr);
    column-gap: var(--space-md);
    row-gap: var(--space-xl);
    margin: 0 0 var(--space-2xl);
    padding: 0;
    list-style: none;
  }

  .moru-search__doc {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    height: 100%;
    padding: var(--space-md);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    color: var(--color-text);
    text-decoration: none;
    transition: border-color 200ms ease;
  }

  .moru-search__doc:hover {
    border-color: var(--color-text);
    color: var(--color-text);
  }

  .moru-search__doc-type {
    font-size: 10px;
    letter-spacing: var(--letter-spacing-wide);
    color: var(--color-muted);
  }

  .moru-search__doc-title {
    font-size: var(--font-size-sm);
    font-weight: 500;
    line-height: 1.6;
  }

  .moru-search__doc-excerpt {
    font-size: var(--font-size-xs);
    line-height: 1.8;
    color: var(--color-muted);
  }

  .moru-search__footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
  }

  .moru-search__shown,
  .moru-search__all-shown {
    margin: 0;
    font-size: var(--font-size-xs);
    color: var(--color-muted);
  }

  .moru-search__more {
    padding: 10px var(--space-2xl);
    border: 1px solid var(--color-text);
    border-radius: 2px;
    color: var(--color-text);
    font-size: var(--font-size-xs);
    letter-spacing: 0.06em;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 200ms ease, color 200ms ease;
  }

  .moru-search__more:hover {
    background-color: var(--color-text);
    color: var(--color-bg);
  }

  .moru-search__more[aria-disabled='true'] {
    opacity: 0.6;
    pointer-events: none;
  }

  .moru-search__empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    padding-block: var(--space-xl) var(--space-2xl);
    text-align: center;
  }

  .moru-search__empty-heading {
    margin: 0;
    font-size: var(--font-size-lg);
  }

  .moru-search__empty-help {
    max-width: 34em;
    margin: 0;
    font-size: var(--font-size-sm);
    line-height: 1.9;
    color: var(--color-muted);
  }

  .moru-search__suggestions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
    margin-block-start: var(--space-sm);
  }

  .moru-search__suggestions-title {
    margin: 0;
    font-size: var(--font-size-xs);
    letter-spacing: var(--letter-spacing-wide);
    color: var(--color-muted);
  }

  @media (max-width: 1024px) {
    .moru-search__grid {
      grid-template-columns: repeat(min(var(--grid-columns, 4), 3), 1fr);
      row-gap: var(--space-lg);
    }
  }

  @media (max-width: 768px) {
    .moru-search__grid {
      grid-template-columns: repeat(2, 1fr);
      column-gap: var(--space-sm);
      row-gap: var(--space-lg);
    }
  }

  @media (max-width: 480px) {
    .moru-search__toolbar {
      flex-direction: column;
      align-items: flex-start;
    }

    .moru-search__toolbar-right {
      width: 100%;
      justify-content: space-between;
      gap: var(--space-sm);
    }
  }
{% endstylesheet %}

{% javascript %}
  class MoruSearchResults {
    constructor(root) {
      this.root = root;
      this.sectionId = root.dataset.sectionId;
      this.items = root.querySelector('[data-search-items]');
      this.button = root.querySelector('[data-search-more]');
      this.shownText = root.querySelector('[data-search-shown]');

      const sortSelect = root.querySelector('[data-search-sort]');
      if (sortSelect) {
        sortSelect.addEventListener('change', () => {
          const form = sortSelect.closest('form');
          if (form) form.submit();
        });
      }

      if (this.button) {
        this.button.addEventListener('click', (event) => {
          event.preventDefault();
          this.loadMore();
        });
      }
    }

    async loadMore() {
      const url = this.button.getAttribute('href');
      if (!url) return;

      const original = this.button.textContent;
      this.button.setAttribute('aria-disabled', 'true');

      try {
        const separator = url.indexOf('?') > -1 ? '&' : '?';
        const response = await fetch(url + separator + 'sections=' + this.sectionId);
        const data = await response.json();
        const parsed = new DOMParser().parseFromString(data[this.sectionId], 'text/html');

        const newItems = parsed.querySelector('[data-search-items]');
        if (newItems) {
          Array.from(newItems.children).forEach((child) => this.items.appendChild(child));
        }

        const newShown = parsed.querySelector('[data-search-shown]');
        if (newShown && this.shownText) this.shownText.textContent = newShown.textContent;

        const newButton = parsed.querySelector('[data-search-more]');
        if (newButton) {
          this.button.setAttribute('href', newButton.getAttribute('href'));
          this.button.removeAttribute('aria-disabled');
        } else {
          this.button.remove();
        }
      } catch (error) {
        this.button.textContent = original;
        this.button.removeAttribute('aria-disabled');
      }
    }
  }

  document.querySelectorAll('[data-search-results]').forEach((root) => {
    if (root.dataset.moruInit === 'true') return;
    root.dataset.moruInit = 'true';
    new MoruSearchResults(root);
  });
{% endjavascript %}

{% schema %}
{
  "name": "t:moru.search.name",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "t:moru.main_product.show_breadcrumbs_label",
      "default": true
    },
    {
      "type": "range",
      "id": "results_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "label": "t:moru.collection_grid.products_per_page_label",
      "default": 16
    },
    {
      "type": "select",
      "id": "columns",
      "label": "t:moru.product_grid.columns_label",
      "options": [
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        }
      ],
      "default": "4"
    },
    {
      "type": "header",
      "content": "t:moru.collection_grid.filter_header"
    },
    {
      "type": "checkbox",
      "id": "show_type_filter",
      "label": "t:moru.search.show_type_filter_label",
      "info": "t:moru.search.show_type_filter_info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sort",
      "label": "t:moru.collection_grid.show_sort_label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:moru.collection_grid.card_header"
    },
    {
      "type": "checkbox",
      "id": "show_swatches",
      "label": "t:moru.collection_grid.show_swatches_label",
      "default": true
    },
    {
      "type": "text",
      "id": "swatch_option_names",
      "label": "t:moru.main_product.swatch_option_names_label",
      "default": "t:moru.main_product.swatch_option_names_default"
    },
    {
      "type": "checkbox",
      "id": "show_subtitle",
      "label": "t:moru.product_grid.show_subtitle_label",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "keyword",
      "name": "t:moru.search.keyword_block",
      "settings": [
        {
          "type": "text",
          "id": "keyword",
          "label": "t:moru.search.keyword_label",
          "info": "t:moru.search.keyword_info"
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "presets": [
    {
      "name": "t:moru.search.name"
    }
  ]
}
{% endschema %}
