{% liquid
  assign has_header = false
  if section.settings.title != blank
    assign has_header = true
  endif

  assign current_product_id = blank
  if product != blank
    assign current_product_id = product.id
  endif

  assign available_product_count = 0
  if section.settings.collection != blank
    for grid_product in section.settings.collection.products
      unless current_product_id != blank and grid_product.id == current_product_id
        assign available_product_count = available_product_count | plus: 1
      endunless
    endfor
  endif
%}

{% if available_product_count > 0 %}
  <div class="moru-product-grid" style="--grid-columns: {{ section.settings.columns }}">
    {% if has_header %}
      <div class="moru-section-header">
        <h2>{{ section.settings.title }}</h2>
        {% if section.settings.show_view_all and section.settings.collection != blank %}
          <a class="moru-section-header__link" href="{{ section.settings.collection.url }}">{{ section.settings.view_all_label }} &rarr;</a>
        {% endif %}
      </div>
    {% endif %}

    <ul class="moru-product-grid__grid" role="list">
      {% assign rendered_products = 0 %}
      {% for grid_product in section.settings.collection.products %}
        {% unless current_product_id != blank and grid_product.id == current_product_id %}
          <li>
            {% render 'moru-product-card',
              product: grid_product,
              show_new_badge: section.settings.show_new_badge,
              show_subtitle: section.settings.show_subtitle
            %}
          </li>
          {% assign rendered_products = rendered_products | plus: 1 %}
          {% if rendered_products >= section.settings.products_to_show %}
            {% break %}
          {% endif %}
        {% endunless %}
      {% endfor %}
    </ul>

    {% if section.settings.bottom_button_label != blank %}
      <div class="moru-product-grid__footer">
        <a class="moru-button moru-button--outline moru-product-grid__button" href="{{ section.settings.collection.url }}">
          {{ section.settings.bottom_button_label }}
        </a>
      </div>
    {% endif %}
  </div>
{% elsif request.design_mode %}
  <div class="moru-product-grid" style="--grid-columns: {{ section.settings.columns }}">
    {% if has_header %}
      <div class="moru-section-header">
        <h2>{{ section.settings.title }}</h2>
      </div>
    {% endif %}
    <ul class="moru-product-grid__grid" role="list">
      {% for i in (1..section.settings.products_to_show) %}
        <li>
          {% render 'moru-product-card',
            ph_index: forloop.index,
            show_new_badge: section.settings.show_new_badge,
            show_subtitle: section.settings.show_subtitle
          %}
        </li>
      {% endfor %}
    </ul>
    <p class="moru-product-grid__hint">{{ 'moru.placeholder.select_collection' | t }}</p>
  </div>
{% endif %}

{% stylesheet %}
  .moru-product-grid {
    padding-block: var(--space-2xl);
  }

  /* スマホは縦のリズムを詰める(Owner 指示 2026-08-28)。
     PC は元の 4rem のまま */
  @media (max-width: 749px) {
    .moru-product-grid { padding-block: var(--space-lg); }
  }

  .moru-product-grid__grid {
    display: grid;
    grid-template-columns: repeat(var(--grid-columns, 4), 1fr);
    gap: var(--space-md) var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .moru-product-grid__footer {
    display: flex;
    justify-content: center;
    margin-block-start: var(--space-xl);
  }

  .moru-product-grid__button {
    padding-inline: var(--space-2xl);
  }

  .moru-product-grid__hint {
    margin-block-start: var(--space-md);
    font-size: var(--font-size-xs);
    opacity: 0.6;
  }

  @media (max-width: 1023px) {
    .moru-product-grid__grid {
      grid-template-columns: repeat(min(var(--grid-columns, 4), 3), 1fr);
    }
  }

  @media (max-width: 749px) {
    .moru-product-grid__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-sm) var(--space-xs);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:moru.product_grid.name",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:moru.common.title",
      "info": "t:moru.product_grid.title_info",
      "default": "t:moru.product_grid.title_default"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:moru.common.collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 3,
      "max": 12,
      "step": 1,
      "label": "t:moru.product_grid.products_to_show_label",
      "default": 8
    },
    {
      "type": "select",
      "id": "columns",
      "label": "t:moru.product_grid.columns_label",
      "options": [
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        }
      ],
      "default": "4"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "t:moru.product_grid.show_view_all_label",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "t:moru.common.view_all_label",
      "default": "t:moru.common.view_all_default"
    },
    {
      "type": "checkbox",
      "id": "show_new_badge",
      "label": "t:moru.product_grid.show_new_badge_label",
      "info": "t:moru.product_grid.show_new_badge_info",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_subtitle",
      "label": "t:moru.product_grid.show_subtitle_label",
      "default": false
    },
    {
      "type": "text",
      "id": "bottom_button_label",
      "label": "t:moru.product_grid.bottom_button_label_label",
      "info": "t:moru.product_grid.bottom_button_label_info"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "presets": [
    {
      "name": "t:moru.product_grid.name"
    }
  ]
}
{% endschema %}
