{% liquid
  assign sale_collection = collections['sale']
  assign sale_collection_available = false
  if sale_collection != blank and sale_collection.products_count > 0
    assign sale_collection_available = true
  endif

  assign sale_eligible = false
  if sale_collection_available
    for product_collection in product.collections
      if product_collection.handle == 'sale'
        assign sale_eligible = true
        break
      endif
    endfor
  endif

  assign pair_eligible = false
  assign pair_companion_title = ''
  assign pair_companion_url = ''
  if product.handle == 'cloud-side-table'
    assign pair_eligible = true
    assign pair_companion_title = 'マッシュルーム コードレステーブルランプ'
    assign pair_companion_url = '/products/mushroom-cordless-table-lamp'
  elsif product.handle == 'mushroom-cordless-table-lamp'
    assign pair_eligible = true
    assign pair_companion_title = 'クラウド サイドテーブル'
    assign pair_companion_url = '/products/cloud-side-table'
  endif

  assign show_promos = false
  if sale_eligible or pair_eligible
    assign show_promos = true
  endif
%}

{% if show_promos %}
<section class="moru-product-promos" aria-labelledby="MoruProductPromos-{{ section.id }}">
  <div class="moru-product-promos__inner">
    <div class="moru-product-promos__head">
      <div><p class="moru-product-promos__eyebrow">MORE WAYS TO SAVE</p><h2 id="MoruProductPromos-{{ section.id }}" class="moru-product-promos__title">キャンペーン</h2></div>
    </div>
    <div class="moru-product-promos__grid{% if sale_eligible and pair_eligible == false or pair_eligible and sale_eligible == false %} is-single{% endif %}">
      {% if sale_eligible %}
        <a class="moru-product-promos__card" href="{{ sale_collection.url }}#promo">
          <div class="moru-product-promos__card-head"><span class="moru-product-promos__kind moru-product-promos__kind--sale">SALE</span><strong>{{ section.settings.sale_rate }}% OFF</strong></div>
          <p>この商品はSUMMER SALE対象です。</p><small>チェックアウトで対象条件に応じて自動適用されます。{% if product.handle == 'haru-dining-chair' %}一部バリエーションは対象外です。{% endif %}</small>
        </a>
      {% endif %}
      {% if pair_eligible %}
        <a class="moru-product-promos__card" href="{{ pair_companion_url }}">
          <div class="moru-product-promos__card-head"><span class="moru-product-promos__kind moru-product-promos__kind--pair">PAIR</span><strong>対象2点で {{ section.settings.pair_rate }}% OFF</strong></div>
          <p>{{ pair_companion_title }}と一緒に選ぶとPAIR対象です。</p><small>組み合わせを見る →</small>
        </a>
      {% endif %}
    </div>
    <p class="moru-product-promos__footnote">まとめ買い対象商品は購入欄の「まとめて買うとお得」から選べます。同じ1点への割引は重複しません。</p>
  </div>
</section>
{% endif %}

{% stylesheet %}
  .moru-product-promos{padding:clamp(34px,5vw,60px) var(--page-margin)}.moru-product-promos__inner{max-width:72rem;margin:0 auto}.moru-product-promos__head{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:18px}.moru-product-promos__eyebrow{margin:0 0 7px;color:var(--color-accent-blue);font-size:10px;font-weight:700;letter-spacing:.16em}.moru-product-promos__title{margin:0;font-size:clamp(24px,3vw,34px)}.moru-product-promos__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.moru-product-promos__grid.is-single{grid-template-columns:1fr}.moru-product-promos__card{display:block;min-height:160px;padding:20px;border:1px solid var(--color-border);background:var(--color-bg);color:var(--color-text);text-decoration:none;transition:transform 180ms ease,border-color 180ms ease}.moru-product-promos__grid.is-single .moru-product-promos__card{min-height:140px}.moru-product-promos__card:hover{transform:translateY(-2px);border-color:var(--color-text)}.moru-product-promos__card-head{display:flex;align-items:center;justify-content:space-between;gap:10px}.moru-product-promos__card-head strong{font-size:14px}.moru-product-promos__kind{font-size:9px;font-weight:800;letter-spacing:.13em}.moru-product-promos__kind--sale{color:var(--color-accent-terracotta)}.moru-product-promos__kind--pair{color:var(--color-accent-blue)}.moru-product-promos__card p{margin:28px 0 6px;font-size:var(--font-size-sm);line-height:1.7}.moru-product-promos__card small{color:var(--color-muted);font-size:10px;line-height:1.6}.moru-product-promos__footnote{margin:12px 0 0;color:var(--color-muted);font-size:10px;line-height:1.7}@media(max-width:749px){.moru-product-promos__head{align-items:start}.moru-product-promos__grid{grid-template-columns:1fr}.moru-product-promos__card{min-height:0}}@media(prefers-reduced-motion:reduce){.moru-product-promos__card{transition:none}}
{% endstylesheet %}

{% schema %}
{"name":"商品：キャンペーン","tag":"section","settings":[{"type":"range","id":"sale_rate","label":"SALE","min":0,"max":30,"step":5,"unit":"%","default":10},{"type":"range","id":"pair_rate","label":"PAIR割引","min":0,"max":30,"step":5,"unit":"%","default":15},{"type":"checkbox","id":"preview_mode","label":"互換用DEVプレビュー","default":false}],"presets":[{"name":"商品：キャンペーン"}]}
{% endschema %}