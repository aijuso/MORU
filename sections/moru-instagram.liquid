<div class="moru-instagram">
  <div class="moru-instagram__layout">
    <div class="moru-instagram__info">
      <span class="moru-instagram__handle">{{ section.settings.handle }}</span>
      <a
        class="moru-instagram__link"
        href="{{ section.settings.link | default: '#' }}"
        {% if section.settings.link != blank %}target="_blank" rel="noopener noreferrer"{% endif %}
      >
        {{ 'moru.instagram.view_link' | t }}
        <svg width="12" height="9" viewBox="0 0 14 10" fill="none" aria-hidden="true" focusable="false">
          <path d="M9 1L13 5M13 5L9 9M13 5L1 5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>

    <ul class="moru-instagram__grid" role="list">
      {% for block in section.blocks %}
        <li class="moru-instagram__item" {{ block.shopify_attributes }}>
          {% liquid
            assign item_url = block.settings.url | default: section.settings.link
          %}
          <a
            href="{{ item_url | default: '#' }}"
            {% if item_url != blank %}target="_blank" rel="noopener noreferrer"{% endif %}
          >
            {% if block.settings.image %}
              {{ block.settings.image | image_url: width: 480, height: 480, crop: 'center' | image_tag: loading: 'lazy' }}
            {% else %}
              {{ 'image' | placeholder_svg_tag }}
            {% endif %}
            <span class="moru-instagram__overlay">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" focusable="false">
                <rect x="3" y="3" width="18" height="18" rx="5"></rect>
                <circle cx="12" cy="12" r="4"></circle>
                <circle cx="17.2" cy="6.8" r="0.9" fill="currentColor" stroke="none"></circle>
              </svg>
            </span>
          </a>
        </li>
      {% else %}
        {% for i in (1..5) %}
          <li class="moru-instagram__item">
            {{ 'image' | placeholder_svg_tag }}
          </li>
        {% endfor %}
      {% endfor %}
    </ul>
  </div>
</div>

{% stylesheet %}
  .moru-instagram {
    padding-block: var(--space-lg);
    border-block: 1px solid var(--color-border);
  }

  .moru-instagram__layout {
    display: flex;
    align-items: center;
    gap: var(--space-xl);
  }

  .moru-instagram__info {
    flex: 0 0 10.5rem;
  }

  .moru-instagram__handle {
    display: block;
    font-family: var(--font-display--family);
    font-size: var(--font-size-lg);
    font-weight: 600;
    letter-spacing: var(--letter-spacing-wide);
    margin-block-end: var(--space-xs);
  }

  .moru-instagram__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--font-size-xs);
    letter-spacing: 0.1em;
    color: var(--color-muted);
    text-decoration: none;
    text-transform: uppercase;
    transition: gap 200ms ease, color 200ms ease;
  }

  .moru-instagram__link:hover {
    gap: 9px;
    color: var(--color-text);
  }

  .moru-instagram__grid {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .moru-instagram__item {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background-color: var(--color-bg-alt);
  }

  .moru-instagram__item a {
    display: block;
    width: 100%;
    height: 100%;
  }

  .moru-instagram__item img,
  .moru-instagram__item > svg,
  .moru-instagram__item a > svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms ease, filter 300ms ease;
  }

  .moru-instagram__item a:hover img {
    transform: scale(1.08);
    filter: brightness(0.92);
  }

  .moru-instagram__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgb(0 0 0 / 0.25);
    color: #fff;
    opacity: 0;
    transition: opacity 300ms ease;
  }

  .moru-instagram__overlay svg {
    width: 22px;
    height: 22px;
  }

  .moru-instagram__item a:hover .moru-instagram__overlay {
    opacity: 1;
  }

  @media (max-width: 899px) {
    .moru-instagram__layout {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-md);
    }

    .moru-instagram__grid {
      width: 100%;
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 599px) {
    .moru-instagram__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:moru.instagram.name",
  "settings": [
    {
      "type": "text",
      "id": "handle",
      "label": "t:moru.instagram.handle_label",
      "default": "t:moru.instagram.handle_default"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:moru.instagram.link_label"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "t:moru.instagram.block_image_name",
      "limit": 7,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:moru.common.image"
        },
        {
          "type": "url",
          "id": "url",
          "label": "t:moru.instagram.block_url_label"
        }
      ]
    }
  ],
  "max_blocks": 7,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "presets": [
    {
      "name": "t:moru.instagram.name",
      "blocks": [
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        }
      ]
    }
  ]
}
{% endschema %}
