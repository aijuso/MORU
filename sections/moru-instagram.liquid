<div class="moru-instagram">
  <p class="moru-instagram__handle">
    {% if section.settings.link != blank %}
      <a href="{{ section.settings.link }}">{{ section.settings.handle }}</a>
    {% else %}
      {{ section.settings.handle }}
    {% endif %}
  </p>

  <ul class="moru-instagram__strip" role="list">
    {% for block in section.blocks %}
      <li class="moru-instagram__item moru-card" {{ block.shopify_attributes }}>
        {% if block.settings.url != blank %}
          <a href="{{ block.settings.url }}">
            {% if block.settings.image %}
              {{ block.settings.image | image_url: width: 480, height: 480, crop: 'center' | image_tag: loading: 'lazy' }}
            {% else %}
              {{ 'image' | placeholder_svg_tag }}
            {% endif %}
          </a>
        {% else %}
          {% if block.settings.image %}
            {{ block.settings.image | image_url: width: 480, height: 480, crop: 'center' | image_tag: loading: 'lazy' }}
          {% else %}
            {{ 'image' | placeholder_svg_tag }}
          {% endif %}
        {% endif %}
      </li>
    {% else %}
      {% for i in (1..6) %}
        <li class="moru-instagram__item moru-card">{{ 'image' | placeholder_svg_tag }}</li>
      {% endfor %}
    {% endfor %}
  </ul>
</div>

{% stylesheet %}
  .moru-instagram {
    padding-block: var(--section-padding-block);
  }

  .moru-instagram__handle {
    margin: 0 0 var(--space-md);
    text-align: center;
    font-size: var(--font-size-sm);
    letter-spacing: var(--letter-spacing-wide);
  }

  .moru-instagram__handle a {
    color: var(--color-text);
    text-decoration: none;
  }

  .moru-instagram__strip {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: var(--space-xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .moru-instagram__item {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background-color: var(--color-bg-alt);
  }

  .moru-instagram__item img,
  .moru-instagram__item svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 749px) {
    .moru-instagram__strip {
      display: flex;
      overflow-x: auto;
    }

    .moru-instagram__item {
      flex: 0 0 40%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:moru.instagram.name",
  "settings": [
    {
      "type": "text",
      "id": "handle",
      "label": "t:moru.instagram.handle_label",
      "default": "t:moru.instagram.handle_default"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:moru.instagram.link_label"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "t:moru.instagram.block_image_name",
      "limit": 6,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:moru.common.image"
        },
        {
          "type": "url",
          "id": "url",
          "label": "t:moru.instagram.block_url_label"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "presets": [
    {
      "name": "t:moru.instagram.name",
      "blocks": [
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        }
      ]
    }
  ]
}
{% endschema %}
