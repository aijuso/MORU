{% javascript %}
  class MoruCart {
    constructor(root) {
      this.root = root;
      this.sectionId = root.dataset.sectionId;
      root.addEventListener('click', (event) => {
        const minus = event.target.closest('[data-cart-minus]');
        const plus = event.target.closest('[data-cart-plus]');
        const remove = event.target.closest('[data-cart-remove]');
        const coupon = event.target.closest('[data-coupon-apply]');
        const couponClear = event.target.closest('[data-coupon-clear]');
        const upsell = event.target.closest('[data-upsell-add]');
        if (minus || plus) {
          const item = (minus || plus).closest('[data-line]');
          const input = item.querySelector('[data-cart-qty]');
          const next = Math.max(0, (parseInt(input.value, 10) || 0) + (plus ? 1 : -1));
          this.change(item.dataset.line, next);
        } else if (remove) {
          event.preventDefault();
          const item = remove.closest('[data-line]');
          this.change(item.dataset.line, 0);
        } else if (coupon) this.applyCoupon();
        else if (couponClear) this.clearCoupons();
        else if (upsell) this.addUpsell(upsell);
      });
      root.addEventListener('keydown', (event) => {
        if (event.key !== 'Enter') return;
        if (!event.target.closest('[data-coupon-input]')) return;
        event.preventDefault();
        this.applyCoupon();
      });
      root.addEventListener('change', (event) => {
        const input = event.target.closest('[data-cart-qty]');
        if (!input) return;
        const item = input.closest('[data-line]');
        this.change(item.dataset.line, Math.max(0, parseInt(input.value, 10) || 0));
      });
    }
    get root_url() { return (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/'; }
    async change(line, quantity) { await this.post('cart/change.js', { line:Number(line), quantity:quantity }); }
    async addUpsell(button) { button.disabled = true; await this.post('cart/add.js', { items:[{ id:Number(button.dataset.variantId), quantity:1 }] }); }
    async post(path, body) {
      try {
        const response = await fetch(this.root_url + path, { method:'POST', headers:{ 'Content-Type':'application/json' }, body:JSON.stringify(body) });
        if (!response.ok) throw new Error('cart request failed');
        await this.refresh();
      } catch (error) { window.location.reload(); }
    }
    async refresh() {
      const response = await fetch(window.location.pathname + '?section_id=' + this.sectionId);
      const html = await response.text();
      const parsed = new DOMParser().parseFromString(html, 'text/html');
      const next = parsed.querySelector('[data-cart-section]');
      if (!next) { window.location.reload(); return; }
      this.root.innerHTML = next.innerHTML;
      // セクションを丸ごと入れ替えるので直前のメッセージは消える。出し直す。
      if (this.pendingStatus) { this.showStatus(this.pendingStatus.message, this.pendingStatus.tone); this.pendingStatus = null; }
      document.dispatchEvent(new CustomEvent('moru:cart:updated'));
    }
    // 文言は locales が正。このブロックでは Liquid が展開されないので、
    // セクションが書き出した JSON を読む。コード名の差し込みは %code%。
    get strings() {
      const tag = this.root.querySelector('[data-coupon-strings]');
      if (!tag) return {};
      try { return JSON.parse(tag.textContent); } catch (error) { return {}; }
    }
    showStatus(message, tone) {
      const el = this.root.querySelector('[data-coupon-status]');
      if (!el) return;
      el.textContent = message; el.dataset.tone = tone || 'info'; el.hidden = false;
    }
    queueStatus(message, tone) { this.pendingStatus = { message:message, tone:tone }; }
    async fetchCart() {
      const response = await fetch(this.root_url + 'cart.js', { headers:{ Accept:'application/json' } });
      if (!response.ok) throw new Error('cart fetch failed');
      return response.json();
    }
    // `discount` は「いま効かせたいコードの全部」を渡す仕様。空文字で全解除(自動割引は無関係)。
    async setDiscount(value) {
      const response = await fetch(this.root_url + 'cart/update.js', { method:'POST', headers:{ 'Content-Type':'application/json', Accept:'application/json' }, body:JSON.stringify({ discount:value }) });
      if (!response.ok) throw new Error('discount update failed');
      return response.json();
    }
    codeDiscountsOf(cart) {
      return ((cart && cart.cart_level_discount_applications) || []).filter((app) => app && app.type === 'discount_code');
    }
    async applyCoupon() {
      const input = this.root.querySelector('[data-coupon-input]');
      const button = this.root.querySelector('[data-coupon-apply]');
      const code = input ? input.value.trim() : '';
      if (!code) { this.showStatus(this.strings.empty, 'error'); if (input) input.focus(); return; }
      if (button) button.disabled = true;
      this.showStatus(this.strings.working, 'info');
      try {
        const before = await this.fetchCart();
        const beforeCodes = this.codeDiscountsOf(before).length;
        const after = await this.setDiscount(code);
        // 効いたかはカートが実際に変わったかで見る。併用できない自動割引のほうが
        // 得な場合 Shopify はコードを採用せず、割引額が動かない。
        const applied = this.codeDiscountsOf(after).length > beforeCodes ||
          Number(after.total_discount || 0) > Number(before.total_discount || 0);
        if (applied) {
          if (input) input.value = '';
          this.queueStatus(this.strings.success.replace('%code%', code), 'success');
        } else {
          // 「コードが誤り」と「他の割引のほうが得」が混ざる。Shopify 側に
          // 区別する手段が無いので、どちらか一方に決めつけない言い方にしてある。
          this.queueStatus(this.strings.notApplied, 'info');
        }
        await this.refresh();
      } catch (error) { this.showStatus(this.strings.error, 'error'); }
      finally { if (button) button.disabled = false; }
    }
    async clearCoupons() {
      try {
        await this.setDiscount('');
        this.queueStatus(this.strings.removed, 'info');
        await this.refresh();
      } catch (error) { this.showStatus(this.strings.error, 'error'); }
    }
  }
  document.querySelectorAll('[data-cart-section]').forEach((root) => { if (root.dataset.moruInit === 'true') return; root.dataset.moruInit = 'true'; new MoruCart(root); });
  document.addEventListener('change', async (event) => {
    const checkbox = event.target.closest('[data-cart-attribute]');
    if (!checkbox) return;
    const root = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
    const attributes = {};
    attributes[checkbox.dataset.cartAttribute] = checkbox.checked ? 'true' : '';
    await fetch(root + 'cart/update.js', { method:'POST', headers:{ 'Content-Type':'application/json' }, body:JSON.stringify({ attributes:attributes }) });
  });
{% endjavascript %}

