    { "type":"assurance", "name":"t:moru.cart.block_assurance_name", "limit":1, "settings":[{ "type":"text", "id":"title", "label":"t:moru.common.title", "default":"t:moru.cart.assurance_title_default" },{ "type":"text", "id":"text", "label":"t:moru.main_product.block_text_label" }] },
    { "type":"upsell", "name":"t:moru.cart.block_upsell_name", "limit":4, "settings":[{ "type":"product", "id":"product", "label":"t:moru.bundle.companion_label" },{ "type":"text", "id":"text", "label":"t:moru.main_product.block_text_label" }] }
