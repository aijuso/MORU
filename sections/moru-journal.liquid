<div class="moru-journal">
  <div class="moru-section-header">
    <h2>{{ section.settings.title }}</h2>
    {% if section.settings.blog != blank %}
      <a class="moru-section-header__link moru-journal__view-all" href="{{ section.settings.blog.url }}">
        {{ section.settings.view_all_label }}
        <svg width="14" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true" focusable="false">
          <path d="M9 1L13 5M13 5L9 9M13 5L1 5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    {% endif %}
  </div>

  <ul class="moru-journal__grid" role="list">
    {% if section.settings.blog != blank and section.settings.blog.articles_count > 0 %}
      {% for article in section.settings.blog.articles limit: section.settings.articles_to_show %}
        <li>
          <a href="{{ article.url }}" class="moru-journal__card">
            <span class="moru-journal__media">
              {% if article.image %}
                {{ article.image | image_url: width: 500, height: 500, crop: 'center' | image_tag: loading: 'lazy' }}
              {% else %}
                {{ 'image' | placeholder_svg_tag }}
              {% endif %}
            </span>
            <span class="moru-journal__body">
              <span class="moru-journal__main">
                <span class="moru-journal__category">
                  {%- if article.tags.size > 0 -%}
                    {{ article.tags | first }}
                  {%- else -%}
                    {{ 'moru.placeholder.article_tag' | t }}
                  {%- endif -%}
                </span>
                <span class="moru-journal__title">{{ article.title }}</span>
                {% if article.excerpt_or_content != blank %}
                  <span class="moru-journal__desc">{{ article.excerpt_or_content | strip_html | truncate: 60 }}</span>
                {% endif %}
              </span>
              <time class="moru-journal__date" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                {{- article.published_at | date: '%Y.%m.%d' -}}
              </time>
            </span>
          </a>
        </li>
      {% endfor %}
    {% else %}
      {% for i in (1..3) %}
        <li>
          <div class="moru-journal__card">
            <span class="moru-journal__media">{{ 'image' | placeholder_svg_tag }}</span>
            <span class="moru-journal__body">
              <span class="moru-journal__main">
                <span class="moru-journal__category">{{ 'moru.placeholder.article_tag' | t }}</span>
                <span class="moru-journal__title">{{ 'moru.placeholder.article_title' | t }}</span>
                <span class="moru-journal__desc">{{ 'moru.placeholder.article_excerpt' | t }}</span>
              </span>
              <span class="moru-journal__date">{{ 'moru.placeholder.article_date' | t }}</span>
            </span>
          </div>
        </li>
      {% endfor %}
    {% endif %}
  </ul>

  {% if section.settings.blog == blank %}
    <p class="moru-journal__hint">{{ 'moru.placeholder.select_blog' | t }}</p>
  {% endif %}
</div>

{% stylesheet %}
  .moru-journal {
    padding-block: var(--space-2xl) var(--space-xl);
  }

  .moru-journal__view-all {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .moru-journal__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .moru-journal__card {
    display: flex;
    gap: var(--space-md);
    align-items: stretch;
    color: var(--color-text);
    text-decoration: none;
  }

  .moru-journal__media {
    flex: 0 0 9rem;
    height: 9rem;
    overflow: hidden;
    background-color: var(--color-bg-alt);
  }

  .moru-journal__media img,
  .moru-journal__media svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  a.moru-journal__card:hover .moru-journal__media img {
    transform: scale(1.06);
  }

  .moru-journal__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .moru-journal__main {
    display: flex;
    flex-direction: column;
  }

  .moru-journal__category {
    font-size: var(--font-size-xs);
    color: var(--color-muted);
    letter-spacing: 0.06em;
    margin-block-end: var(--space-2xs);
  }

  .moru-journal__title {
    font-family: var(--font-heading--family);
    font-size: var(--font-size-md);
    font-weight: 500;
    line-height: 1.55;
    letter-spacing: 0.04em;
    margin-block-end: var(--space-xs);
    transition: color 200ms ease;
  }

  a.moru-journal__card:hover .moru-journal__title {
    color: var(--color-accent-terracotta);
  }

  .moru-journal__desc {
    font-size: var(--font-size-xs);
    line-height: 1.6;
    color: var(--color-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .moru-journal__date {
    font-size: var(--font-size-xs);
    letter-spacing: var(--letter-spacing-wide);
    color: var(--color-muted);
    margin-block-start: var(--space-xs);
  }

  .moru-journal__hint {
    margin-block-start: var(--space-md);
    font-size: var(--font-size-xs);
    opacity: 0.6;
  }

  @media (max-width: 899px) {
    .moru-journal__grid {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }

    .moru-journal__card {
      background-color: var(--color-bg-alt);
      border: 1px solid var(--color-border);
      padding: var(--space-md);
    }

    .moru-journal__media {
      background-color: var(--color-bg);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:moru.journal.name",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:moru.common.title",
      "default": "t:moru.journal.title_default"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "t:moru.journal.blog_label"
    },
    {
      "type": "range",
      "id": "articles_to_show",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "t:moru.journal.articles_to_show_label",
      "default": 3
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "t:moru.common.view_all_label",
      "default": "t:moru.common.view_all_default"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "presets": [
    {
      "name": "t:moru.journal.name"
    }
  ]
}
{% endschema %}
