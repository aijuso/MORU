<div class="moru-page-cta{% if section.settings.background == 'alt' %} moru-page-cta--alt{% endif %}">
  {% if section.settings.eyebrow != blank %}
    <p class="moru-page-cta__eyebrow moru-display">{{ section.settings.eyebrow }}</p>
  {% endif %}

  {% if section.settings.heading != blank %}
    <h2 class="moru-page-cta__heading">{{ section.settings.heading }}</h2>
  {% endif %}

  {% if section.settings.text != blank %}
    <div class="moru-page-cta__text">{{ section.settings.text }}</div>
  {% endif %}

  {% liquid
    assign has_primary = false
    assign has_secondary = false
    if section.settings.button_label != blank and section.settings.button_link != blank
      assign has_primary = true
    endif
    if section.settings.button_2_label != blank and section.settings.button_2_link != blank
      assign has_secondary = true
    endif
  %}

  {% if has_primary or has_secondary %}
    <div class="moru-page-cta__actions">
      {% if has_primary %}
        <a class="moru-button" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
      {% endif %}
      {% if has_secondary %}
        <a class="moru-button moru-button--outline" href="{{ section.settings.button_2_link }}">
          {{- section.settings.button_2_label -}}
        </a>
      {% endif %}
    </div>
  {% endif %}
</div>

{% stylesheet %}
  .moru-page-cta {
    padding-block: var(--space-2xl);
    text-align: center;
  }

  .moru-page-cta--alt {
    padding-inline: var(--space-lg);
    border-radius: var(--radius-card);
    background-color: var(--color-bg-alt);
  }

  .moru-page-cta__eyebrow {
    margin: 0 0 var(--space-xs);
    font-size: var(--font-size-xs);
    color: var(--color-muted);
  }

  .moru-page-cta__heading {
    margin: 0;
    font-size: var(--font-size-xl);
  }

  .moru-page-cta__text {
    max-width: 34rem;
    margin: var(--space-md) auto 0;
    font-size: var(--font-size-sm);
    line-height: var(--line-height-body);
    color: var(--color-muted);
  }

  .moru-page-cta__text > :last-child {
    margin-block-end: 0;
  }

  .moru-page-cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-sm);
    margin-block-start: var(--space-lg);
  }

  .moru-page-cta__actions .moru-button {
    min-width: 14rem;
    padding-block: var(--space-md);
  }

  @media (max-width: 768px) {
    .moru-page-cta {
      padding-block: var(--space-xl);
    }

    .moru-page-cta__actions .moru-button {
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:moru.page_cta.name",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:moru.page_header.eyebrow_label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:moru.common.title",
      "default": "t:moru.page_cta.heading_default"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:moru.page_cta.text_label",
      "default": "t:moru.page_cta.text_default"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:moru.common.button_label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:moru.common.button_link"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "t:moru.page_cta.button_2_label"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "t:moru.page_cta.button_2_link"
    },
    {
      "type": "select",
      "id": "background",
      "label": "t:moru.page_header.background_label",
      "options": [
        { "value": "none", "label": "t:moru.page_header.background_none" },
        { "value": "alt", "label": "t:moru.page_header.background_alt" }
      ],
      "default": "alt"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "presets": [
    {
      "name": "t:moru.page_cta.name"
    }
  ]
}
{% endschema %}
