{% liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = page.title
  endif
  assign align_class = 'moru-page-header--' | append: section.settings.alignment
%}

<div class="moru-page-header {{ align_class }}{% if section.settings.background == 'alt' %} moru-page-header--alt{% endif %}">
  {% if section.settings.show_breadcrumbs %}
    <nav class="moru-breadcrumbs" aria-label="{{ 'moru.product.breadcrumbs' | t }}">
      <ol>
        <li><a href="{{ routes.root_url }}">{{ 'moru.product.home' | t }}</a></li>
        <li aria-current="page">{{ heading }}</li>
      </ol>
    </nav>
  {% endif %}

  <header class="moru-page-header__inner">
    {% if section.settings.eyebrow != blank %}
      <p class="moru-page-header__eyebrow moru-display">{{ section.settings.eyebrow }}</p>
    {% endif %}

    <h1 class="moru-page-header__title">{{ heading }}</h1>

    {% if section.settings.lead != blank %}
      <div class="moru-page-header__lead">{{ section.settings.lead }}</div>
    {% endif %}

    {% if section.settings.updated_at != blank %}
      <p class="moru-page-header__updated">
        {{- 'moru.page.updated_prefix' | t }} {{ section.settings.updated_at -}}
      </p>
    {% endif %}
  </header>
</div>

{% stylesheet %}
  .moru-page-header {
    padding-block-start: var(--space-sm);
  }

  .moru-page-header__inner {
    padding-block: var(--space-xl) var(--space-lg);
    border-block-end: 1px solid var(--color-border);
  }

  .moru-page-header--alt .moru-page-header__inner {
    padding-inline: var(--space-xl);
    border-block-end: 0;
    border-radius: var(--radius-card);
    background-color: var(--color-bg-alt);
  }

  .moru-page-header--center .moru-page-header__inner {
    text-align: center;
  }

  .moru-page-header__eyebrow {
    margin: 0 0 var(--space-xs);
    font-size: var(--font-size-xs);
    color: var(--color-muted);
  }

  .moru-page-header__title {
    margin: 0;
    font-size: var(--font-size-2xl);
  }

  .moru-page-header__lead {
    max-width: 42rem;
    margin-block-start: var(--space-md);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-body);
    color: var(--color-muted);
  }

  .moru-page-header--center .moru-page-header__lead {
    margin-inline: auto;
  }

  .moru-page-header__lead > :last-child {
    margin-block-end: 0;
  }

  .moru-page-header__updated {
    margin: var(--space-md) 0 0;
    font-size: var(--font-size-xs);
    letter-spacing: var(--letter-spacing-wide);
    color: var(--color-muted);
  }

  @media (max-width: 768px) {
    .moru-page-header__inner {
      padding-block: var(--space-lg) var(--space-md);
    }

    .moru-page-header--alt .moru-page-header__inner {
      padding-inline: var(--space-md);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:moru.page_header.name",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "t:moru.main_product.show_breadcrumbs_label",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:moru.page_header.eyebrow_label",
      "info": "t:moru.page_header.eyebrow_info"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:moru.common.title",
      "info": "t:moru.page_header.heading_info"
    },
    {
      "type": "richtext",
      "id": "lead",
      "label": "t:moru.page_header.lead_label"
    },
    {
      "type": "text",
      "id": "updated_at",
      "label": "t:moru.page_header.updated_label",
      "info": "t:moru.page_header.updated_info"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:labels.alignment",
      "options": [
        { "value": "left", "label": "t:moru.page_header.align_left" },
        { "value": "center", "label": "t:moru.page_header.align_center" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "background",
      "label": "t:moru.page_header.background_label",
      "options": [
        { "value": "none", "label": "t:moru.page_header.background_none" },
        { "value": "alt", "label": "t:moru.page_header.background_alt" }
      ],
      "default": "none"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "presets": [
    {
      "name": "t:moru.page_header.name"
    }
  ]
}
{% endschema %}
