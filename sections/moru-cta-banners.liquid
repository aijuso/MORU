{%- liquid
  assign visible_count = 0
  for block in section.blocks
    if block.settings.show_banner
      assign visible_count = visible_count | plus: 1
    endif
  endfor

  assign columns = section.settings.columns
  if visible_count < columns
    assign columns = visible_count
  endif

  # sizes 属性に CSS 変数は書けない(ブラウザが解決できない)ので、ここで実際の幅を出しておく
  assign column_vw = 100 | divided_by: columns
  assign media_sizes = '(max-width: 749px) 100vw, ' | append: column_vw | append: 'vw'
-%}

{%- if visible_count > 0 -%}
  <div
    class="moru-cta-banners moru-cta-banners--{{ section.settings.width }} moru-cta-banners--space-{{ section.settings.spacing }}{% if section.settings.width == 'full' %} full-width{% endif %}"
    style="--moru-cta-columns: {{ columns }}; --moru-cta-ratio: {{ section.settings.ratio }}; --moru-cta-ratio-mobile: {{ section.settings.ratio_mobile }};"
  >
    {%- if section.settings.title != blank -%}
      <div class="moru-section-header">
        <h2>{{ section.settings.title }}</h2>
      </div>
    {%- endif -%}

    <ul class="moru-cta-banners__grid" role="list">
      {%- for block in section.blocks -%}
        {%- if block.settings.show_banner -%}
          {%- liquid
            assign has_text = false
            if block.settings.eyebrow != blank or block.settings.heading != blank or block.settings.subheading != blank
              assign has_text = true
            endif

            assign has_button = false
            if block.settings.button_label != blank and block.settings.link != blank
              assign has_button = true
            endif

            assign image_alt = block.settings.image_alt
            if image_alt == blank
              assign image_alt = block.settings.heading
            endif
          -%}

          {%- capture banner_inner -%}
            <span class="moru-cta-banner__media">
              {%- if block.settings.image != blank -%}
                {%- if block.settings.image_mobile != blank -%}
                  <picture>
                    <source
                      media="(max-width: 749px)"
                      srcset="{{ block.settings.image_mobile | image_url: width: 750 }} 750w, {{ block.settings.image_mobile | image_url: width: 1100 }} 1100w"
                      sizes="100vw"
                    >
                    {{
                      block.settings.image
                      | image_url: width: 1600
                      | image_tag:
                        loading: 'lazy',
                        widths: '600, 900, 1200, 1600',
                        sizes: media_sizes,
                        alt: image_alt
                    }}
                  </picture>
                {%- else -%}
                  {{
                    block.settings.image
                    | image_url: width: 1600
                    | image_tag:
                      loading: 'lazy',
                      widths: '600, 900, 1200, 1600',
                      sizes: media_sizes,
                      alt: image_alt
                  }}
                {%- endif -%}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag }}
              {%- endif -%}
            </span>

            {%- if has_text or has_button -%}
              <span class="moru-cta-banner__content moru-cta-banner__content--{{ block.settings.text_align }}">
                {%- if block.settings.eyebrow != blank -%}
                  <span class="moru-cta-banner__eyebrow">{{ block.settings.eyebrow }}</span>
                {%- endif -%}
                {%- if block.settings.heading != blank -%}
                  <span class="moru-cta-banner__heading">{{ block.settings.heading }}</span>
                {%- endif -%}
                {%- if block.settings.subheading != blank -%}
                  <span class="moru-cta-banner__subheading">{{ block.settings.subheading }}</span>
                {%- endif -%}
                {%- if has_button -%}
                  <span class="moru-cta-banner__button moru-cta-banner__button--{{ block.settings.button_style }}">
                    {{- block.settings.button_label }}
                    <svg width="14" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true" focusable="false">
                      <path
                        d="M9 1L13 5M13 5L9 9M13 5L1 5"
                        stroke="currentColor"
                        stroke-width="1.2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </span>
                {%- endif -%}
              </span>
            {%- endif -%}
          {%- endcapture -%}

          {%- assign banner_class = 'moru-cta-banner moru-cta-banner--bg-' | append: block.settings.background | append: ' moru-cta-banner--text-' | append: block.settings.text_color -%}

          <li class="moru-cta-banners__item" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
              <a class="{{ banner_class }}" href="{{ block.settings.link }}">{{ banner_inner }}</a>
            {%- else -%}
              <div class="{{ banner_class }}">{{ banner_inner }}</div>
            {%- endif -%}
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
{%- endif -%}

{% stylesheet %}
  .moru-cta-banners {
    --moru-cta-columns: 2;
    --moru-cta-ratio: 2.5;
    --moru-cta-ratio-mobile: 1.7778;
  }

  .moru-cta-banners--space-normal {
    padding-block: var(--space-xl);
  }

  .moru-cta-banners--space-narrow {
    padding-block: var(--space-md);
  }

  .moru-cta-banners--space-none {
    padding-block: 0;
  }

  .moru-cta-banners__grid {
    display: grid;
    grid-template-columns: repeat(var(--moru-cta-columns), minmax(0, 1fr));
    gap: var(--space-md);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .moru-cta-banners--full .moru-cta-banners__grid {
    gap: 0;
  }

  /* グリッドのセルを grid にしておくと、文言の長さが違っても隣り合うバナーの高さが揃う */
  .moru-cta-banners__item {
    display: grid;
    min-width: 0;
  }

  .moru-cta-banner {
    position: relative;
    display: flex;
    flex-direction: row-reverse;
    align-items: stretch;
    aspect-ratio: var(--moru-cta-ratio);
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    background-color: var(--color-bg-alt);
  }

  .moru-cta-banners--page .moru-cta-banner {
    border-radius: var(--radius-card);
  }

  .moru-cta-banner__media {
    display: block;
    flex: 0 0 45%;
    min-width: 0;
  }

  .moru-cta-banner__media img,
  .moru-cta-banner__media svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  a.moru-cta-banner:hover .moru-cta-banner__media img {
    transform: scale(1.03);
  }

  .moru-cta-banner__content {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-2xs);
    min-width: 0;
    padding: var(--space-lg);
    text-align: left;
  }

  .moru-cta-banner__content--center {
    align-items: center;
    text-align: center;
  }

  .moru-cta-banner__content--right {
    align-items: flex-end;
    text-align: right;
  }

  /*
   * 背景色なし = 文字を焼き込んだ画像をそのまま貼るケース。
   * 画像を全面に敷き、テーマ側で文字も入れた場合だけその上に重ねる。
   */
  .moru-cta-banner--bg-none .moru-cta-banner__media {
    position: absolute;
    inset: 0;
    flex: none;
  }

  .moru-cta-banner--bg-none .moru-cta-banner__content {
    position: relative;
  }

  /*
   * 写真の上でも文字が読めるように、文字を入れたときだけ薄い膜を敷く。
   * 全面を覆うと絵が濁るので、文字が乗っている側にだけかかるグラデーションにする。
   */
  .moru-cta-banner--bg-none.moru-cta-banner--text-light .moru-cta-banner__content {
    --moru-cta-scrim: color-mix(in srgb, var(--color-text) 62%, transparent);
  }

  .moru-cta-banner--bg-none.moru-cta-banner--text-dark .moru-cta-banner__content {
    --moru-cta-scrim: color-mix(in srgb, var(--color-surface) 72%, transparent);
  }

  .moru-cta-banner--bg-none .moru-cta-banner__content {
    background-image: linear-gradient(
      to right,
      var(--moru-cta-scrim) 0%,
      var(--moru-cta-scrim) 38%,
      transparent 82%
    );
  }

  .moru-cta-banner--bg-none .moru-cta-banner__content--center {
    background-image: linear-gradient(
      to right,
      transparent 0%,
      var(--moru-cta-scrim) 22%,
      var(--moru-cta-scrim) 78%,
      transparent 100%
    );
  }

  .moru-cta-banner--bg-none .moru-cta-banner__content--right {
    background-image: linear-gradient(
      to left,
      var(--moru-cta-scrim) 0%,
      var(--moru-cta-scrim) 38%,
      transparent 82%
    );
  }

  .moru-cta-banner--bg-alt {
    background-color: var(--color-bg-alt);
  }

  .moru-cta-banner--bg-blue {
    background-color: var(--color-accent-blue);
  }

  .moru-cta-banner--bg-terracotta {
    background-color: var(--color-accent-terracotta);
  }

  .moru-cta-banner--bg-olive {
    background-color: var(--color-accent-olive);
  }

  .moru-cta-banner--bg-burgundy {
    background-color: var(--color-accent-burgundy);
  }

  .moru-cta-banner--text-light {
    color: var(--color-surface);
  }

  .moru-cta-banner--text-dark {
    color: var(--color-text);
  }

  .moru-cta-banner__eyebrow {
    font-size: var(--font-size-xs);
    letter-spacing: var(--letter-spacing-wide);
  }

  .moru-cta-banner__heading {
    font-family: var(--font-heading--family);
    font-size: var(--font-size-2xl);
    font-weight: 600;
    line-height: var(--line-height-heading);
    letter-spacing: var(--letter-spacing-heading);
  }

  .moru-cta-banner__subheading {
    font-size: var(--font-size-sm);
    line-height: 1.6;
  }

  .moru-cta-banner__button {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    align-self: flex-start;
    margin-block-start: var(--space-sm);
    padding: var(--space-xs) var(--space-md);
    border: 1px solid transparent;
    border-radius: 999px;
    font-size: var(--font-size-xs);
    letter-spacing: var(--letter-spacing-wide);
    line-height: 1;
    white-space: nowrap;
    transition: opacity 150ms ease;
  }

  .moru-cta-banner__content--center .moru-cta-banner__button {
    align-self: center;
  }

  .moru-cta-banner__content--right .moru-cta-banner__button {
    align-self: flex-end;
  }

  .moru-cta-banner__button--light {
    background-color: var(--color-surface);
    color: var(--color-text);
  }

  .moru-cta-banner__button--dark {
    background-color: var(--color-text);
    color: var(--color-bg);
  }

  .moru-cta-banner__button--terracotta {
    background-color: var(--color-accent-terracotta);
    color: var(--color-surface);
  }

  .moru-cta-banner__button--blue {
    background-color: var(--color-accent-blue);
    color: var(--color-surface);
  }

  .moru-cta-banner__button--outline {
    border-color: currentcolor;
    color: inherit;
  }

  a.moru-cta-banner:hover .moru-cta-banner__button {
    opacity: 0.85;
  }

  @media (max-width: 749px) {
    .moru-cta-banners__grid {
      grid-template-columns: 1fr;
      gap: var(--space-sm);
    }

    .moru-cta-banner {
      aspect-ratio: var(--moru-cta-ratio-mobile);
    }

    /* 背景色つきのバナーは、モバイルでは画像を上・文字を下に積む */
    .moru-cta-banner--bg-alt,
    .moru-cta-banner--bg-blue,
    .moru-cta-banner--bg-terracotta,
    .moru-cta-banner--bg-olive,
    .moru-cta-banner--bg-burgundy {
      flex-direction: column;
      aspect-ratio: auto;
    }

    .moru-cta-banner--bg-alt .moru-cta-banner__media,
    .moru-cta-banner--bg-blue .moru-cta-banner__media,
    .moru-cta-banner--bg-terracotta .moru-cta-banner__media,
    .moru-cta-banner--bg-olive .moru-cta-banner__media,
    .moru-cta-banner--bg-burgundy .moru-cta-banner__media {
      flex: none;
      aspect-ratio: var(--moru-cta-ratio-mobile);
    }

    /*
     * 狭い画面では左右に振り分ける余地がないので、
     * 画像に重ねる文字のスクリムは下から立ち上げる形に切り替える。
     */
    .moru-cta-banner--bg-none .moru-cta-banner__content,
    .moru-cta-banner--bg-none .moru-cta-banner__content--center,
    .moru-cta-banner--bg-none .moru-cta-banner__content--right {
      justify-content: flex-end;
      background-image: linear-gradient(
        to top,
        var(--moru-cta-scrim) 0%,
        var(--moru-cta-scrim) 65%,
        transparent 100%
      );
    }

    .moru-cta-banner__content {
      padding: var(--space-md);
    }

    .moru-cta-banner__heading {
      font-size: var(--font-size-xl);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .moru-cta-banner__media img {
      transition: none;
    }

    a.moru-cta-banner:hover .moru-cta-banner__media img {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:moru.cta_banners.name",
  "tag": "section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:moru.cta_banners.title_label"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "t:moru.cta_banners.columns_label",
      "default": 2
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:moru.cta_banners.width_label",
      "options": [
        { "value": "page", "label": "t:moru.cta_banners.width_page" },
        { "value": "full", "label": "t:moru.cta_banners.width_full" }
      ],
      "default": "page"
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "t:moru.cta_banners.spacing_label",
      "options": [
        { "value": "normal", "label": "t:moru.cta_banners.spacing_normal" },
        { "value": "narrow", "label": "t:moru.cta_banners.spacing_narrow" },
        { "value": "none", "label": "t:moru.cta_banners.spacing_none" }
      ],
      "default": "normal"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "t:moru.cta_banners.ratio_label",
      "options": [
        { "value": "3", "label": "t:moru.cta_banners.ratio_3_1" },
        { "value": "2.5", "label": "t:moru.cta_banners.ratio_5_2" },
        { "value": "1.7778", "label": "t:moru.cta_banners.ratio_16_9" },
        { "value": "1.3333", "label": "t:moru.cta_banners.ratio_4_3" },
        { "value": "1", "label": "t:moru.cta_banners.ratio_1_1" }
      ],
      "default": "2.5"
    },
    {
      "type": "select",
      "id": "ratio_mobile",
      "label": "t:moru.cta_banners.ratio_mobile_label",
      "options": [
        { "value": "2.5", "label": "t:moru.cta_banners.ratio_5_2" },
        { "value": "1.7778", "label": "t:moru.cta_banners.ratio_16_9" },
        { "value": "1.3333", "label": "t:moru.cta_banners.ratio_4_3" },
        { "value": "1", "label": "t:moru.cta_banners.ratio_1_1" }
      ],
      "default": "1.7778"
    }
  ],
  "blocks": [
    {
      "type": "banner",
      "name": "t:moru.cta_banners.block_name",
      "settings": [
        {
          "type": "checkbox",
          "id": "show_banner",
          "label": "t:moru.cta_banners.show_label",
          "default": true
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:moru.common.image"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "t:moru.cta_banners.image_mobile_label"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "t:moru.cta_banners.alt_label",
          "info": "t:moru.cta_banners.alt_info"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:moru.common.link"
        },
        {
          "type": "paragraph",
          "content": "t:moru.cta_banners.content_info"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "t:moru.cta_banners.eyebrow_label"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:moru.common.title"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "t:moru.cta_banners.subheading_label"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "t:moru.common.button_label"
        },
        {
          "type": "select",
          "id": "text_align",
          "label": "t:moru.cta_banners.text_align_label",
          "options": [
            { "value": "left", "label": "t:moru.cta_banners.align_left" },
            { "value": "center", "label": "t:moru.cta_banners.align_center" },
            { "value": "right", "label": "t:moru.cta_banners.align_right" }
          ],
          "default": "left"
        },
        {
          "type": "select",
          "id": "background",
          "label": "t:moru.cta_banners.background_label",
          "options": [
            { "value": "none", "label": "t:moru.cta_banners.bg_none" },
            { "value": "alt", "label": "t:moru.cta_banners.bg_alt" },
            { "value": "blue", "label": "t:moru.cta_banners.bg_blue" },
            { "value": "terracotta", "label": "t:moru.cta_banners.bg_terracotta" },
            { "value": "olive", "label": "t:moru.cta_banners.bg_olive" },
            { "value": "burgundy", "label": "t:moru.cta_banners.bg_burgundy" }
          ],
          "default": "none"
        },
        {
          "type": "select",
          "id": "text_color",
          "label": "t:moru.cta_banners.text_color_label",
          "options": [
            { "value": "dark", "label": "t:moru.cta_banners.text_dark" },
            { "value": "light", "label": "t:moru.cta_banners.text_light" }
          ],
          "default": "dark"
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "t:moru.cta_banners.button_style_label",
          "options": [
            { "value": "dark", "label": "t:moru.cta_banners.button_dark" },
            { "value": "light", "label": "t:moru.cta_banners.button_light" },
            { "value": "terracotta", "label": "t:moru.cta_banners.button_terracotta" },
            { "value": "blue", "label": "t:moru.cta_banners.button_blue" },
            { "value": "outline", "label": "t:moru.cta_banners.button_outline" }
          ],
          "default": "dark"
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "presets": [
    {
      "name": "t:moru.cta_banners.name",
      "blocks": [{ "type": "banner" }, { "type": "banner" }]
    }
  ]
}
{% endschema %}
