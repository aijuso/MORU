{% liquid
  assign features = product.metafields.custom.features.value
  assign use_metafield = false
  if features != blank and features.size > 0
    assign use_metafield = true
  endif

  assign has_block_content = false
  for block in section.blocks
    if block.settings.image != blank or block.settings.heading != blank or block.settings.body != blank
      assign has_block_content = true
      break
    endif
  endfor

  assign show_features = false
  if use_metafield or has_block_content
    assign show_features = true
  endif
%}

{% if show_features %}
<div class="moru-features" style="--moru-features-pt:{{ section.settings.padding_top }}px;--moru-features-pb:{{ section.settings.padding_bottom }}px;">
  <div class="moru-section-header">
    <h2>{% if section.settings.heading != blank %}{{ section.settings.heading }}{% else %}{{ 'moru.features.default_heading' | t }}{% endif %}</h2>
  </div>

  {% if use_metafield %}
    <div class="moru-features__rows">
      {% for feature in features %}
        {% assign side = forloop.index0 | modulo: 2 %}
        <article class="moru-features__row{% if side == 1 %} moru-features__row--flip{% endif %}{% if feature.image.value == blank %} moru-features__row--text-only{% endif %}">
          {% if feature.heading.value != blank %}
            <div class="moru-features__head">
              <h3 class="moru-features__title">{{ feature.heading.value }}</h3>
            </div>
          {% endif %}
          {% if feature.image.value != blank %}
            <div class="moru-features__media moru-card">
              {{ feature.image.value | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400, 700, 1000, 1200', sizes: '(min-width: 750px) 50vw, 100vw', alt: feature.heading.value }}
            </div>
          {% endif %}
          {% if feature.body.value != blank %}
            <div class="moru-features__body">
              <p class="moru-features__text">{{ feature.body.value | newline_to_br }}</p>
            </div>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  {% else %}
    <div class="moru-features__rows">
      {% for block in section.blocks %}
        {% if block.settings.image != blank or block.settings.heading != blank or block.settings.body != blank %}
          {% assign side = forloop.index0 | modulo: 2 %}
          <article class="moru-features__row{% if side == 1 %} moru-features__row--flip{% endif %}{% if block.settings.image == blank %} moru-features__row--text-only{% endif %}" {{ block.shopify_attributes }}>
            {% if block.settings.heading != blank %}
              <div class="moru-features__head">
                <h3 class="moru-features__title">{{ block.settings.heading }}</h3>
              </div>
            {% endif %}
            {% if block.settings.image != blank %}
              <div class="moru-features__media moru-card">
                {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400, 700, 1000, 1200', sizes: '(min-width: 750px) 50vw, 100vw', alt: block.settings.image.alt }}
              </div>
            {% endif %}
            {% if block.settings.body != blank %}
              <div class="moru-features__body">
                <p class="moru-features__text">{{ block.settings.body | newline_to_br }}</p>
              </div>
            {% endif %}
          </article>
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}
</div>
{% endif %}

{% stylesheet %}
  /* 上下の余白はテーマエディタから変える(Owner 指示 2026-08-28)。
     stylesheet タグの中では Liquid が評価されないので、値は
     セクションの style 属性でカスタムプロパティとして渡している。
     ここの数値は設定が空のときのフォールバック。 */
  .moru-features { padding-block: var(--moru-features-pt, 1.5rem) var(--moru-features-pb, 2rem); }
  .moru-features__rows { display:flex; flex-direction:column; gap:var(--space-2xl); }
  /* 記事組みなので1カラム。見出し → 画像 → 説明文 を縦に積む。
     (polish.css も全ビューポートを1カラムに固定しているが、
      ここが2カラムのままだと polish を外した瞬間に崩れるのでベースをそろえる) */
  .moru-features__row { display:grid; grid-template-columns:minmax(0,1fr); gap:var(--space-lg); }
  /* 記事のような縦組み。DOM は「見出し → 画像 → 説明文」の順で、
     表示順もこれに従わせるので order で並べ替えない。
     ⚠️ assets/moru-frontend-polish.css が全ビューポートを1カラムに固定している
     (説明画像を切らないため)。ここで order を触ると、!important が効く flip 行と
     効かない非 flip 行で並びが食い違う。 */
  .moru-features__row .moru-features__media,
  .moru-features__row--flip .moru-features__media { order:0; }

  /* 見出しブロック。左の縦バーが見出しマーク。本文と左端をそろえる */
  .moru-features__head {
    width:min(100%, 54rem);
    margin-inline:auto;
    border-inline-start:3px solid var(--color-accent-terracotta);
    padding-inline-start:var(--space-md);
  }
  /* 説明画像は寸法図・仕様表を含むので切らない(polish.css と同じ方針) */
  .moru-features__media { background-color:var(--color-bg-alt); }
  .moru-features__media img { display:block; width:100%; height:auto; }
  .moru-features__title { margin:0; font-size:var(--font-size-xl); line-height:1.5; }
  .moru-features__text { margin:0; font-size:var(--font-size-sm); line-height:var(--line-height-body); color:var(--color-muted); }
  @media (max-width:768px) {
    .moru-features__row { gap:var(--space-md); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:moru.features.name",
  "settings": [
    { "type": "paragraph", "content": "t:moru.features.intro" },
    { "type": "text", "id": "heading", "label": "t:moru.common.title", "info": "t:moru.features.heading_info" },
    { "type": "header", "content": "t:moru.features.spacing_header" },
    { "type": "range", "id": "padding_top", "label": "t:moru.features.padding_top_label", "info": "t:moru.features.padding_info", "min": 0, "max": 96, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "t:moru.features.padding_bottom_label", "info": "t:moru.features.padding_info", "min": 0, "max": 96, "step": 4, "unit": "px", "default": 32 }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "t:moru.features.block_name",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "t:moru.common.image" },
        { "type": "text", "id": "heading", "label": "t:moru.common.title" },
        { "type": "textarea", "id": "body", "label": "t:moru.features.body_label" }
      ]
    }
  ],
  "enabled_on": { "templates": ["product"] },
  "presets": [{ "name": "t:moru.features.name" }]
}
{% endschema %}
