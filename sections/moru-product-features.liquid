{% liquid
  assign features = product.metafields.custom.features.value
  assign use_metafield = false
  if features != blank and features.size > 0
    assign use_metafield = true
  endif

  assign has_block_content = false
  for block in section.blocks
    if block.settings.image != blank or block.settings.heading != blank or block.settings.body != blank
      assign has_block_content = true
      break
    endif
  endfor

  assign show_features = false
  if use_metafield or has_block_content
    assign show_features = true
  endif
%}

{% if show_features %}
<div class="moru-features">
  <div class="moru-section-header">
    <h2>{% if section.settings.heading != blank %}{{ section.settings.heading }}{% else %}{{ 'moru.features.default_heading' | t }}{% endif %}</h2>
  </div>

  {% if use_metafield %}
    <div class="moru-features__rows">
      {% for feature in features %}
        {% assign side = forloop.index0 | modulo: 2 %}
        <article class="moru-features__row{% if side == 1 %} moru-features__row--flip{% endif %}{% if feature.image.value == blank %} moru-features__row--text-only{% endif %}">
          {% if feature.image.value != blank %}
            <div class="moru-features__media moru-card">
              {{ feature.image.value | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400, 700, 1000, 1200', sizes: '(min-width: 750px) 50vw, 100vw', alt: feature.heading.value }}
            </div>
          {% endif %}
          <div class="moru-features__body">
            <p class="moru-features__index moru-display">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</p>
            {% if feature.heading.value != blank %}<h3 class="moru-features__title">{{ feature.heading.value }}</h3>{% endif %}
            {% if feature.body.value != blank %}<p class="moru-features__text">{{ feature.body.value | newline_to_br }}</p>{% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  {% else %}
    <div class="moru-features__rows">
      {% for block in section.blocks %}
        {% if block.settings.image != blank or block.settings.heading != blank or block.settings.body != blank %}
          {% assign side = forloop.index0 | modulo: 2 %}
          <article class="moru-features__row{% if side == 1 %} moru-features__row--flip{% endif %}{% if block.settings.image == blank %} moru-features__row--text-only{% endif %}" {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}
              <div class="moru-features__media moru-card">
                {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400, 700, 1000, 1200', sizes: '(min-width: 750px) 50vw, 100vw', alt: block.settings.image.alt }}
              </div>
            {% endif %}
            <div class="moru-features__body">
              <p class="moru-features__index moru-display">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</p>
              {% if block.settings.heading != blank %}<h3 class="moru-features__title">{{ block.settings.heading }}</h3>{% endif %}
              {% if block.settings.body != blank %}<p class="moru-features__text">{{ block.settings.body | newline_to_br }}</p>{% endif %}
            </div>
          </article>
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}
</div>
{% endif %}

{% stylesheet %}
  .moru-features { padding-block: var(--space-xl) var(--space-2xl); }
  .moru-features__rows { display:flex; flex-direction:column; gap:var(--space-2xl); }
  .moru-features__row { display:grid; grid-template-columns:1fr 1fr; align-items:center; gap:var(--space-2xl); }
  .moru-features__row--text-only { grid-template-columns:1fr; }
  .moru-features__row--flip .moru-features__media { order:2; }
  .moru-features__media { aspect-ratio:4/3; background-color:var(--color-bg-alt); }
  .moru-features__media img { width:100%; height:100%; object-fit:cover; }
  .moru-features__index { margin:0 0 var(--space-xs); font-size:var(--font-size-xs); color:var(--color-accent-terracotta); }
  .moru-features__title { margin:0 0 var(--space-md); font-size:var(--font-size-xl); }
  .moru-features__text { margin:0; font-size:var(--font-size-sm); line-height:var(--line-height-body); color:var(--color-muted); }
  @media (max-width:768px) { .moru-features__row { grid-template-columns:1fr; gap:var(--space-md); } .moru-features__row--flip .moru-features__media { order:0; } }
{% endstylesheet %}

{% schema %}
{
  "name": "t:moru.features.name",
  "settings": [
    { "type": "paragraph", "content": "t:moru.features.intro" },
    { "type": "text", "id": "heading", "label": "t:moru.common.title", "info": "t:moru.features.heading_info" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "t:moru.features.block_name",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "t:moru.common.image" },
        { "type": "text", "id": "heading", "label": "t:moru.common.title" },
        { "type": "textarea", "id": "body", "label": "t:moru.features.body_label" }
      ]
    }
  ],
  "enabled_on": { "templates": ["product"] },
  "presets": [{ "name": "t:moru.features.name" }]
}
{% endschema %}
