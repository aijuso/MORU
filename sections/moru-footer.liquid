<footer class="moru-footer full-width">
  <div class="moru-footer__inner">
    <div class="moru-footer__columns">
      <div class="moru-footer__brand">
        {% if section.settings.logo %}
          {{ section.settings.logo | image_url: width: 320 | image_tag: alt: shop.name, loading: 'lazy', widths: '160, 320' }}
        {% else %}
          <span class="moru-footer__wordmark">{{ shop.name }}</span>
        {% endif %}
        {% if section.settings.brand_text != blank %}
          <p class="moru-footer__brand-text">{{ section.settings.brand_text | newline_to_br }}</p>
        {% endif %}
      </div>

      {% for block in section.blocks %}
        <nav class="moru-footer__column" {{ block.shopify_attributes }}>
          <p class="moru-footer__heading">{{ block.settings.heading }}</p>
          {% for link in block.settings.menu.links %}
            {{ link.title | link_to: link.url }}
          {% endfor %}
        </nav>
      {% endfor %}

      {% if section.settings.show_newsletter %}
        <div class="moru-footer__column moru-footer__newsletter">
          <p class="moru-footer__heading">{{ section.settings.newsletter_heading }}</p>
          {% if section.settings.newsletter_text != blank %}
            <p class="moru-footer__text">{{ section.settings.newsletter_text }}</p>
          {% endif %}
          {% form 'customer', class: 'moru-footer__form' %}
            {% if form.posted_successfully? %}
              <p class="moru-footer__text">{{ 'moru.footer.newsletter_success' | t }}</p>
            {% else %}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <input
                type="email"
                name="contact[email]"
                required
                placeholder="{{ 'moru.footer.newsletter_placeholder' | t }}"
                aria-label="{{ 'moru.footer.newsletter_placeholder' | t }}"
              >
              <button type="submit" class="moru-footer__submit">{{ 'moru.footer.newsletter_submit' | t }}</button>
            {% endif %}
          {% endform %}

          <div class="moru-footer__social">
            {% if section.settings.instagram_url != blank %}
              <a href="{{ section.settings.instagram_url }}" class="moru-footer__social-icon" aria-label="Instagram" target="_blank" rel="noopener noreferrer">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
                  <rect x="3" y="3" width="18" height="18" rx="5"></rect>
                  <circle cx="12" cy="12" r="4"></circle>
                  <circle cx="17.2" cy="6.8" r="0.8" fill="currentColor" stroke="none"></circle>
                </svg>
              </a>
            {% endif %}
            {% if section.settings.pinterest_url != blank %}
              <a href="{{ section.settings.pinterest_url }}" class="moru-footer__social-icon" aria-label="Pinterest" target="_blank" rel="noopener noreferrer">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                  <path d="M12 17v5"></path>
                  <path d="M9 10.76a2 2 0 0 1-1.11 1.79l-1.78.9A2 2 0 0 0 5 15.24V16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-.76a2 2 0 0 0-1.11-1.79l-1.78-.9A2 2 0 0 1 15 10.76V7a1 1 0 0 1 1-1 2 2 0 0 0 0-4H8a2 2 0 0 0 0 4 1 1 0 0 1 1 1z"></path>
                </svg>
              </a>
            {% endif %}
            {% if section.settings.line_url != blank %}
              <a href="{{ section.settings.line_url }}" class="moru-footer__social-icon" aria-label="LINE" target="_blank" rel="noopener noreferrer">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                  <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path>
                </svg>
              </a>
            {% endif %}
          </div>
        </div>
      {% endif %}
    </div>
  </div>

  <div class="moru-footer__bottom">
    <div class="moru-footer__bottom-inner">
      <p class="moru-footer__copyright">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }} All rights reserved.</p>

      <div class="moru-footer__legal">
        {% if section.settings.legal_menu != blank %}
          {% for link in section.settings.legal_menu.links %}
            {% unless forloop.first %}<span class="moru-footer__legal-divider" aria-hidden="true">|</span>{% endunless %}
            {{ link.title | link_to: link.url }}
          {% endfor %}
        {% else %}
          <span>{{ 'moru.footer.legal_tokushoho' | t }}</span>
          <span class="moru-footer__legal-divider" aria-hidden="true">|</span>
          <span>{{ 'moru.footer.legal_privacy' | t }}</span>
          <span class="moru-footer__legal-divider" aria-hidden="true">|</span>
          <span>{{ 'moru.footer.legal_terms' | t }}</span>
        {% endif %}
      </div>
    </div>
  </div>
</footer>

{% stylesheet %}
  .moru-footer {
    background-color: var(--color-bg);
    color: var(--color-text);
  }

  .moru-footer__inner {
    max-width: var(--page-width);
    margin-inline: auto;
    padding: var(--space-2xl) var(--page-margin) var(--space-xl);
  }

  .moru-footer a {
    color: var(--color-muted);
    text-decoration: none;
    font-size: var(--font-size-sm);
    transition: color 200ms ease, padding-left 200ms ease;
  }

  .moru-footer a:hover {
    color: var(--color-text);
  }

  .moru-footer__columns {
    display: grid;
    grid-template-columns: 1.4fr 0.8fr 0.9fr 0.8fr 1.3fr;
    gap: var(--space-lg);
  }

  .moru-footer__brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    align-items: flex-start;
  }

  .moru-footer__brand img {
    width: 8rem;
    height: auto;
  }

  .moru-footer__wordmark {
    font-family: var(--font-display--family);
    font-size: var(--font-size-2xl);
    font-weight: 500;
    letter-spacing: 0.18em;
    line-height: 1;
    text-transform: uppercase;
    color: var(--color-text);
  }

  .moru-footer__brand-text {
    margin: 0;
    font-size: var(--font-size-xs);
    font-weight: 300;
    line-height: 1.85;
    letter-spacing: 0.03em;
    color: var(--color-muted);
  }

  .moru-footer__column {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    align-items: flex-start;
  }

  nav.moru-footer__column a:hover {
    padding-left: 3px;
  }

  .moru-footer__heading {
    margin: 0 0 var(--space-sm);
    font-size: var(--font-size-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text);
  }

  .moru-footer__text {
    margin: 0 0 var(--space-sm);
    font-size: var(--font-size-xs);
    color: var(--color-muted);
  }

  .moru-footer__form {
    display: flex;
    width: 100%;
    margin-block-end: var(--space-md);
  }

  .moru-footer__form input[type="email"] {
    flex: 1;
    min-width: 0;
    padding: var(--space-xs) var(--space-sm);
    font-size: var(--font-size-xs);
    border: 1px solid var(--color-border);
    border-inline-end: none;
    border-radius: var(--style-border-radius-inputs) 0 0 var(--style-border-radius-inputs);
    background-color: #fff;
    color: var(--color-text);
    transition: border-color 200ms ease;
  }

  .moru-footer__form input[type="email"]:focus {
    outline: none;
    border-color: var(--color-text);
  }

  .moru-footer__form input[type="email"]::placeholder {
    color: var(--color-muted);
  }

  .moru-footer__submit {
    padding: 0 var(--space-md);
    border: 1px solid var(--color-text);
    border-radius: 0 var(--style-border-radius-inputs) var(--style-border-radius-inputs) 0;
    background-color: var(--color-text);
    color: var(--color-bg);
    font-size: var(--font-size-xs);
    letter-spacing: 0.06em;
    white-space: nowrap;
    cursor: pointer;
    transition: opacity 200ms ease;
  }

  .moru-footer__submit:hover {
    opacity: 0.85;
  }

  .moru-footer__social {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .moru-footer__social-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text);
    transition: transform 200ms ease, opacity 200ms ease;
  }

  .moru-footer__social-icon:hover {
    color: var(--color-text);
    transform: translateY(-2px);
    opacity: 0.75;
  }

  .moru-footer__social-icon svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .moru-footer__bottom {
    border-block-start: 1px solid var(--color-border);
  }

  .moru-footer__bottom-inner {
    max-width: var(--page-width);
    margin-inline: auto;
    padding: var(--space-md) var(--page-margin) var(--space-lg);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-md);
    font-size: var(--font-size-xs);
    color: var(--color-muted);
  }

  .moru-footer__copyright {
    margin: 0;
  }

  .moru-footer__legal {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: var(--font-size-xs);
  }

  .moru-footer__legal a {
    font-size: var(--font-size-xs);
  }

  .moru-footer__legal a:hover {
    text-decoration: underline;
  }

  .moru-footer__legal-divider {
    color: var(--color-border);
  }

  @media (max-width: 1079px) {
    .moru-footer__columns {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-xl) var(--space-md);
    }

    .moru-footer__brand,
    .moru-footer__newsletter {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 599px) {
    .moru-footer__columns {
      grid-template-columns: 1fr;
    }

    .moru-footer__bottom-inner {
      flex-direction: column-reverse;
      align-items: flex-start;
      gap: var(--space-sm);
    }

    .moru-footer__legal {
      flex-wrap: wrap;
      gap: var(--space-xs) var(--space-sm);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:moru.footer.name",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:moru.footer.logo_label"
    },
    {
      "type": "textarea",
      "id": "brand_text",
      "label": "t:moru.footer.brand_text_label",
      "default": "t:moru.footer.brand_text_default"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "t:moru.footer.show_newsletter_label",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "t:moru.footer.newsletter_heading_label",
      "default": "t:moru.footer.newsletter_heading_default"
    },
    {
      "type": "text",
      "id": "newsletter_text",
      "label": "t:moru.footer.newsletter_text_label",
      "default": "t:moru.footer.newsletter_text_default"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "t:moru.footer.instagram_url_label"
    },
    {
      "type": "url",
      "id": "pinterest_url",
      "label": "t:moru.footer.pinterest_url_label"
    },
    {
      "type": "url",
      "id": "line_url",
      "label": "t:moru.footer.line_url_label"
    },
    {
      "type": "link_list",
      "id": "legal_menu",
      "label": "t:moru.footer.legal_menu_label"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "t:moru.footer.block_menu_name",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:moru.footer.block_heading_label",
          "default": "t:moru.footer.block_heading_default"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "t:labels.menu"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "enabled_on": {
    "groups": ["footer"]
  },
  "presets": [
    {
      "name": "t:moru.footer.name",
      "blocks": [
        {
          "type": "menu"
        },
        {
          "type": "menu"
        },
        {
          "type": "menu"
        }
      ]
    }
  ]
}
{% endschema %}
