<moru-cart-discount-summary class="moru-cart-discount-summary" aria-hidden="true">
  {% if customer and customer.orders_count == 0 %}
    <template data-moru-member-coupon-template>
      {% if request.locale.iso_code == 'ja' %}
        <div class="moru-cart__member-coupon" data-moru-member-coupon>
          <div class="moru-cart__member-coupon-copy">
            <p class="moru-cart__member-coupon-eyebrow">新規会員特典</p>
            <p class="moru-cart__member-coupon-title">¥500 OFFクーポン</p>
          </div>
          <div class="moru-cart__member-coupon-code-row">
            <span class="moru-cart__member-coupon-code" aria-label="クーポンコード MORU500">MORU500</span>
            <button type="button" class="moru-cart__member-coupon-button" data-moru-member-coupon-copy data-code="MORU500" aria-label="クーポンコード MORU500 をコピー">コピー</button>
          </div>
          <p class="moru-cart__member-coupon-note">他の割引の方がお得な場合は、自動的にお得な割引が優先されます。</p>
          <p class="moru-cart__member-coupon-status" data-moru-member-coupon-status role="status" aria-live="polite" hidden>コピーしました</p>
        </div>
      {% else %}
        <div class="moru-cart__member-coupon" data-moru-member-coupon>
          <div class="moru-cart__member-coupon-copy">
            <p class="moru-cart__member-coupon-eyebrow">NEW MEMBER BENEFIT</p>
            <p class="moru-cart__member-coupon-title">¥500 OFF coupon</p>
          </div>
          <div class="moru-cart__member-coupon-code-row">
            <span class="moru-cart__member-coupon-code" aria-label="Coupon code MORU500">MORU500</span>
            <button type="button" class="moru-cart__member-coupon-button" data-moru-member-coupon-copy data-code="MORU500" aria-label="Copy coupon code MORU500">Copy</button>
          </div>
          <p class="moru-cart__member-coupon-note">If another discount gives you a better price, Shopify will automatically prioritize the better discount.</p>
          <p class="moru-cart__member-coupon-status" data-moru-member-coupon-status role="status" aria-live="polite" hidden>Copied</p>
        </div>
      {% endif %}
    </template>
  {% endif %}
</moru-cart-discount-summary>

{% stylesheet %}
  .moru-cart-discount-summary { display:none; }
  .moru-cart__item-price.has-moru-discount span { color:var(--color-accent-terracotta); font-weight:700; }
  .moru-cart__item-saving { margin-top:2px; color:var(--color-accent-terracotta); font-size:10px; font-weight:700; white-space:nowrap; }
  .moru-cart__discount-summary { display:grid; gap:5px; margin:0 0 var(--space-md); padding:var(--space-sm) 0 var(--space-md); border-bottom:1px solid var(--color-border); }
  .moru-cart__discount-summary-row { display:flex; align-items:baseline; justify-content:space-between; gap:var(--space-md); color:var(--color-muted); font-size:var(--font-size-xs); }
  .moru-cart__discount-summary-row--saving { color:var(--color-accent-terracotta); }
  .moru-cart__discount-summary-row--saving strong { font-size:var(--font-size-sm); }
  .moru-cart__discount-summary-total { margin:2px 0 0; color:var(--color-accent-terracotta); font-size:10px; font-weight:700; text-align:right; }
  .moru-cart__member-coupon { margin:0 0 var(--space-md); padding:var(--space-md); border:1px solid color-mix(in srgb, var(--color-accent-blue) 35%, var(--color-border)); border-radius:8px; background:color-mix(in srgb, var(--color-accent-blue) 5%, var(--color-surface)); }
  .moru-cart__member-coupon-copy { display:flex; align-items:baseline; justify-content:space-between; gap:var(--space-sm); margin:0 0 var(--space-sm); }
  .moru-cart__member-coupon-eyebrow { margin:0; color:var(--color-accent-blue); font-size:10px; font-weight:700; letter-spacing:.08em; }
  .moru-cart__member-coupon-title { margin:0; color:var(--color-text); font-size:var(--font-size-sm); font-weight:700; }
  .moru-cart__member-coupon-code-row { display:grid; grid-template-columns:1fr auto; gap:var(--space-xs); align-items:stretch; }
  .moru-cart__member-coupon-code { display:flex; align-items:center; min-height:2.625rem; padding:var(--space-xs) var(--space-sm); border:1px dashed color-mix(in srgb, var(--color-accent-blue) 55%, var(--color-border)); border-radius:4px; background:var(--color-surface); color:var(--color-text); font-size:var(--font-size-sm); font-weight:700; letter-spacing:.08em; }
  .moru-cart__member-coupon-button { min-width:4.5rem; min-height:2.625rem; padding:var(--space-xs) var(--space-md); border:1px solid var(--color-accent-blue); border-radius:4px; background:var(--color-accent-blue); color:#fff; font-family:inherit; font-size:var(--font-size-xs); font-weight:600; cursor:pointer; transition:opacity 180ms ease; }
  .moru-cart__member-coupon-button:hover { opacity:.84; }
  .moru-cart__member-coupon-button:focus-visible { outline:2px solid var(--color-text); outline-offset:2px; }
  .moru-cart__member-coupon-note { margin:var(--space-xs) 0 0; color:var(--color-muted); font-size:10px; line-height:1.6; }
  .moru-cart__member-coupon-status { margin:var(--space-2xs) 0 0; color:var(--color-accent-olive); font-size:10px; font-weight:600; }
  @media (max-width:579px) {
    .moru-cart__member-coupon-copy { align-items:flex-start; flex-direction:column; gap:2px; }
    .moru-cart__member-coupon-code-row { grid-template-columns:minmax(0,1fr) auto; }
  }
{% endstylesheet %}

{% javascript %}
  class MoruCartDiscountSummary extends HTMLElement {
    connectedCallback() {
      if (this.dataset.initialized === 'true') return;
      this.dataset.initialized = 'true';
      this.currency = 'JPY';
      this.onUpdated = () => this.refresh();
      this.onClick = (event) => {
        const button = event.target.closest('[data-moru-member-coupon-copy]');
        if (!button) return;
        this.copyMemberCoupon(button);
      };
      document.addEventListener('moru:cart:updated', this.onUpdated);
      document.addEventListener('click', this.onClick);
      this.renderMemberCoupon();
      this.refresh();
    }

    disconnectedCallback() {
      document.removeEventListener('moru:cart:updated', this.onUpdated);
      document.removeEventListener('click', this.onClick);
    }

    get rootUrl() { return (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/'; }

    formatMoney(cents) {
      try { return new Intl.NumberFormat('ja-JP', { style:'currency', currency:this.currency, maximumFractionDigits:0 }).format(cents / 100); }
      catch (error) { return '¥' + Math.round(cents / 100).toLocaleString('ja-JP'); }
    }

    renderMemberCoupon() {
      const summary = document.querySelector('.moru-cart__summary');
      if (!summary) return;
      summary.querySelector('[data-moru-member-coupon]')?.remove();
      const template = this.querySelector('[data-moru-member-coupon-template]');
      if (!template) return;
      const couponBlock = summary.querySelector('[data-coupon-block]');
      const card = template.content.firstElementChild.cloneNode(true);
      if (couponBlock) summary.insertBefore(card, couponBlock);
      else summary.prepend(card);
    }

    async copyMemberCoupon(button) {
      const code = button.dataset.code || '';
      if (!code) return;
      let copied = false;
      try {
        if (navigator.clipboard && window.isSecureContext) {
          await navigator.clipboard.writeText(code);
          copied = true;
        }
      } catch (error) {}
      if (!copied) {
        const input = document.createElement('textarea');
        input.value = code;
        input.setAttribute('readonly', '');
        input.style.position = 'fixed';
        input.style.opacity = '0';
        document.body.appendChild(input);
        input.select();
        try { copied = document.execCommand('copy'); } catch (error) {}
        input.remove();
      }
      if (!copied) return;
      const card = button.closest('[data-moru-member-coupon]');
      const status = card && card.querySelector('[data-moru-member-coupon-status]');
      if (status) {
        status.hidden = false;
        window.clearTimeout(this.copyStatusTimer);
        this.copyStatusTimer = window.setTimeout(() => { status.hidden = true; }, 2400);
      }
    }

    async refresh() {
      this.renderMemberCoupon();
      try {
        const response = await fetch(this.rootUrl + 'cart.js', { headers:{ Accept:'application/json' } });
        if (!response.ok) return;
        const cart = await response.json();
        this.currency = cart.currency || this.currency;
        this.updateLines(cart);
        this.updateSummary(cart);
      } catch (error) {}
    }

    updateLines(cart) {
      const rows = Array.from(document.querySelectorAll('.moru-cart__item'));
      rows.forEach((row, index) => {
        const price = row.querySelector('.moru-cart__item-price');
        if (!price) return;
        price.querySelector('.moru-cart__item-saving')?.remove();
        price.classList.remove('has-moru-discount');
        const item = cart.items && cart.items[index];
        if (!item) return;
        const saving = Math.max(0, Number(item.original_line_price || 0) - Number(item.final_line_price || 0));
        if (saving <= 0) return;
        price.classList.add('has-moru-discount');
        const badge = document.createElement('small');
        badge.className = 'moru-cart__item-saving';
        badge.textContent = this.formatMoney(saving) + ' お得';
        price.appendChild(badge);
      });
    }

    updateSummary(cart) {
      const summary = document.querySelector('.moru-cart__summary');
      const total = summary && summary.querySelector('.moru-cart__total');
      if (!summary || !total) return;
      summary.querySelector('[data-moru-cart-discount-summary]')?.remove();
      const totalLabel = total.querySelector('.moru-cart__total-label');
      const discount = Number(cart.total_discount || 0);
      if (discount <= 0) {
        if (totalLabel && totalLabel.dataset.moruOriginalLabel) totalLabel.textContent = totalLabel.dataset.moruOriginalLabel;
        return;
      }

      if (totalLabel) {
        if (!totalLabel.dataset.moruOriginalLabel) totalLabel.dataset.moruOriginalLabel = totalLabel.textContent.trim();
        totalLabel.textContent = '割引後合計';
      }

      const original = Number(cart.original_total_price || 0) || (Number(cart.total_price || 0) + discount);
      const box = document.createElement('div');
      box.className = 'moru-cart__discount-summary';
      box.dataset.moruCartDiscountSummary = 'true';
      box.innerHTML = `
        <div class="moru-cart__discount-summary-row"><span>通常合計</span><s>${this.formatMoney(original)}</s></div>
        <div class="moru-cart__discount-summary-row moru-cart__discount-summary-row--saving"><span>割引合計</span><strong>−${this.formatMoney(discount)}</strong></div>
        <p class="moru-cart__discount-summary-total">合計 ${this.formatMoney(discount)} お得</p>
      `;
      total.parentNode.insertBefore(box, total);
    }
  }

  if (!customElements.get('moru-cart-discount-summary')) customElements.define('moru-cart-discount-summary', MoruCartDiscountSummary);
{% endjavascript %}

