{%- comment -%}
  Shopify のセクションは縦にしか積めないため、#MORUのある暮らし(Instagram)と読みものを
  PC で横に並べるにはこの1セクションに統合する必要がある。
  単体で使う moru-instagram / moru-journal は他ページ用に残してある。
{%- endcomment -%}

<div class="moru-cj">
  {%- comment -%} 左: #MORUのある暮らし {%- endcomment -%}
  <section class="moru-cj__col moru-cj__col--social" aria-labelledby="moru-cj-social-{{ section.id }}">
    <div class="moru-section-header">
      <h2 id="moru-cj-social-{{ section.id }}">{{ section.settings.social_title }}</h2>
      {%- if section.settings.social_link != blank -%}
        <a class="moru-section-header__link" href="{{ section.settings.social_link }}">
          {{ section.settings.view_all_label }}
          <svg width="14" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true" focusable="false">
            <path d="M9 1L13 5M13 5L9 9M13 5L1 5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      {%- endif -%}
    </div>

    <ul class="moru-cj__insta-grid" role="list">
      {%- liquid
        assign photo_count = 0
        for block in section.blocks
          if block.type == 'photo'
            assign photo_count = photo_count | plus: 1
          endif
        endfor
      -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'photo' -%}
          <li class="moru-cj__insta-cell" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
              <a class="moru-cj__insta-media" href="{{ block.settings.link }}">
            {%- else -%}
              <span class="moru-cj__insta-media">
            {%- endif -%}
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 600
                | image_tag:
                  loading: 'lazy',
                  widths: '200, 300, 400, 600',
                  sizes: '(max-width: 899px) 25vw, 12vw',
                  alt: block.settings.image_alt
              }}
            {%- else -%}
              {{ 'lifestyle-2' | placeholder_svg_tag }}
            {%- endif -%}
            {%- if block.settings.link != blank -%}
              </a>
            {%- else -%}
              </span>
            {%- endif -%}
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>

    {%- if section.settings.social_handle != blank and section.settings.social_link != blank -%}
      <div class="moru-cj__insta-callout">
        {%- if section.settings.social_callout != blank -%}
          <p class="moru-cj__insta-callout-text">{{ section.settings.social_callout }}</p>
        {%- endif -%}
        <a class="moru-cj__insta-follow" href="{{ section.settings.social_link }}">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
            <rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.6"/>
            <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.6"/>
            <circle cx="17.5" cy="6.5" r="1.1" fill="currentColor"/>
          </svg>
          {{ section.settings.social_handle }}
        </a>
      </div>
    {%- endif -%}
  </section>

  {%- comment -%} 右: 読みもの {%- endcomment -%}
  <section class="moru-cj__col moru-cj__col--journal" aria-labelledby="moru-cj-journal-{{ section.id }}">
    <div class="moru-section-header">
      <h2 id="moru-cj-journal-{{ section.id }}">{{ section.settings.journal_title }}</h2>
      {%- if section.settings.blog != blank -%}
        <a class="moru-section-header__link" href="{{ section.settings.blog.url }}">
          {{ section.settings.view_all_label }}
          <svg width="14" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true" focusable="false">
            <path d="M9 1L13 5M13 5L9 9M13 5L1 5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      {%- endif -%}
    </div>

    <ul class="moru-cj__articles" role="list">
      {%- if section.settings.blog != blank and section.settings.blog.articles_count > 0 -%}
        {%- for article in section.settings.blog.articles limit: 3 -%}
          <li>
            <a class="moru-cj__article" href="{{ article.url }}">
              <span class="moru-cj__article-media">
                {%- if article.image -%}
                  {{ article.image | image_url: width: 520 | image_tag: loading: 'lazy', alt: '' }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag }}
                {%- endif -%}
              </span>
              <span class="moru-cj__article-body">
                <span class="moru-cj__article-tag">
                  {%- if article.tags.size > 0 -%}
                    {{- article.tags | first -}}
                  {%- else -%}
                    {{- 'moru.placeholder.article_tag' | t -}}
                  {%- endif -%}
                </span>
                <span class="moru-cj__article-title">{{ article.title }}</span>
                <time class="moru-cj__article-date" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                  {{- article.published_at | date: '%Y.%m.%d' -}}
                </time>
              </span>
            </a>
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..3) -%}
          <li>
            <div class="moru-cj__article">
              <span class="moru-cj__article-media">{{ 'image' | placeholder_svg_tag }}</span>
              <span class="moru-cj__article-body">
                <span class="moru-cj__article-tag">{{ 'moru.placeholder.article_tag' | t }}</span>
                <span class="moru-cj__article-title">{{ 'moru.placeholder.article_title' | t }}</span>
                <span class="moru-cj__article-date">{{ 'moru.placeholder.article_date' | t }}</span>
              </span>
            </div>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>

    {%- if section.settings.blog == blank -%}
      <p class="moru-cj__hint">{{ 'moru.placeholder.select_blog' | t }}</p>
    {%- endif -%}
  </section>
</div>

{% stylesheet %}
  .moru-cj {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: var(--space-xl);
    padding-block: var(--space-2xl) var(--space-xl);
    align-items: start;
  }

  .moru-cj__col {
    min-width: 0;
  }

  .moru-cj__insta-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .moru-cj__insta-cell {
    min-width: 0;
  }

  .moru-cj__insta-media {
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--radius-card);
    background-color: var(--color-bg-alt);
  }

  .moru-cj__insta-media img,
  .moru-cj__insta-media svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms ease;
  }

  a.moru-cj__insta-media:hover img {
    transform: scale(1.06);
  }

  .moru-cj__insta-callout {
    margin-block-start: var(--space-md);
    text-align: center;
  }

  .moru-cj__insta-callout-text {
    margin: 0 0 var(--space-xs);
    font-size: var(--font-size-xs);
    color: var(--color-muted);
  }

  .moru-cj__insta-follow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-xs) var(--space-lg);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background-color: var(--color-surface);
    font-size: var(--font-size-xs);
    font-weight: 600;
    color: var(--color-text);
    text-decoration: none;
    transition: border-color 200ms ease;
  }

  .moru-cj__insta-follow:hover {
    border-color: var(--color-accent-terracotta);
    color: var(--color-accent-terracotta);
  }

  .moru-cj__articles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .moru-cj__article {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    height: 100%;
    color: var(--color-text);
    text-decoration: none;
  }

  .moru-cj__article-media {
    display: block;
    width: 100%;
    aspect-ratio: 1.3;
    overflow: hidden;
    margin-block-end: var(--space-xs);
    border-radius: var(--radius-card);
    background-color: var(--color-bg-alt);
  }

  .moru-cj__article-media img,
  .moru-cj__article-media svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms ease;
  }

  a.moru-cj__article:hover .moru-cj__article-media img {
    transform: scale(1.05);
  }

  .moru-cj__article-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
  }

  .moru-cj__article-tag {
    display: inline-block;
    margin-block-end: var(--space-2xs);
    padding: 2px var(--space-xs);
    border-radius: 999px;
    background-color: var(--color-bg-alt);
    font-size: var(--font-size-xs);
    color: var(--color-muted);
  }

  .moru-cj__article-title {
    flex: 1;
    font-size: var(--font-size-xs);
    font-weight: 600;
    line-height: 1.5;
    margin-block-end: var(--space-xs);
  }

  a.moru-cj__article:hover .moru-cj__article-title {
    color: var(--color-accent-terracotta);
  }

  .moru-cj__article-date {
    font-size: var(--font-size-xs);
    color: var(--color-muted);
    letter-spacing: var(--letter-spacing-wide);
  }

  .moru-cj__hint {
    margin-block-start: var(--space-md);
    font-size: var(--font-size-xs);
    opacity: 0.6;
  }

  /* スマホは縦積み。左(#MORUのある暮らし)が上に来る */
  @media (max-width: 899px) {
    .moru-cj {
      grid-template-columns: 1fr;
      gap: var(--space-2xl);
    }

    .moru-cj__articles {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }

    /* 画像を左、文字を右に。文字は body にまとめてあるので横一列に散らばらない */
    .moru-cj__article {
      flex-direction: row;
      gap: var(--space-md);
      align-items: flex-start;
    }

    .moru-cj__article-media {
      flex: 0 0 6.5rem;
      width: 6.5rem;
      aspect-ratio: 1;
      margin-block-end: 0;
    }

    .moru-cj__article-title {
      font-size: var(--font-size-sm);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .moru-cj__insta-media img,
    .moru-cj__article-media img {
      transition: none;
    }

    a.moru-cj__insta-media:hover img,
    a.moru-cj__article:hover .moru-cj__article-media img {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:moru.community_journal.name",
  "tag": "section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:moru.community_journal.section_info"
    },
    {
      "type": "header",
      "content": "t:moru.community_journal.social_header"
    },
    {
      "type": "text",
      "id": "social_title",
      "label": "t:moru.common.title",
      "default": "t:moru.community_journal.social_title_default"
    },
    {
      "type": "text",
      "id": "social_callout",
      "label": "t:moru.community_journal.callout_label",
      "default": "t:moru.community_journal.callout_default"
    },
    {
      "type": "text",
      "id": "social_handle",
      "label": "t:moru.instagram.handle_label",
      "default": "t:moru.community_journal.handle_default"
    },
    {
      "type": "url",
      "id": "social_link",
      "label": "t:moru.instagram.link_label"
    },
    {
      "type": "header",
      "content": "t:moru.community_journal.journal_header"
    },
    {
      "type": "text",
      "id": "journal_title",
      "label": "t:moru.common.title",
      "default": "t:moru.journal.title_default"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "t:moru.journal.blog_label"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "t:moru.common.view_all_label",
      "default": "t:moru.common.view_all_default"
    }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "t:moru.instagram.block_image_name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:moru.common.image"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "t:moru.cta_banners.alt_label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:moru.instagram.block_url_label"
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "presets": [
    {
      "name": "t:moru.community_journal.name",
      "blocks": [
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" }
      ]
    }
  ]
}
{% endschema %}
