{% liquid
  assign sale_title = section.settings.sale_link_title | strip
  assign wordmark = section.settings.wordmark | default: shop.name
%}

<moru-header class="moru-header full-width">
  <div class="moru-header__inner">
    <button class="moru-header__menu-toggle" type="button" data-menu-open aria-label="{{ 'moru.header.menu' | t }}">
      <svg class="moru-header__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <line x1="3" y1="7" x2="21" y2="7"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="17" x2="21" y2="17"></line>
      </svg>
    </button>

    <nav class="moru-header__nav" aria-label="{{ 'moru.header.menu' | t }}">
      <ul class="moru-header__nav-list" role="list">
        {% for link in section.settings.menu.links %}
          <li>
            <a
              class="moru-header__nav-link{% if sale_title != blank and link.title == sale_title %} moru-header__nav-link--sale{% endif %}"
              href="{{ link.url }}"
              {% if link.current %}aria-current="page"{% endif %}
            >
              {{- link.title -}}
            </a>
          </li>
        {% endfor %}
      </ul>
    </nav>

    <div class="moru-header__logo">
      <a
        class="moru-header__logo-link"
        href="{{ routes.root_url }}"
        style="--logo-width: {{ section.settings.logo_width }}px"
      >
        {% if section.settings.logo %}
          {{ section.settings.logo | image_url: width: 480 | image_tag: alt: shop.name, widths: '240, 480' }}
        {% else %}
          {{ wordmark }}
        {% endif %}
      </a>
    </div>

    <div class="moru-header__actions">
      <button class="moru-header__action" type="button" data-search-toggle aria-label="{{ 'moru.header.search' | t }}">
        <span class="moru-header__action-text">{{ 'moru.header.search' | t }}</span>
        <svg class="moru-header__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <circle cx="10.5" cy="10.5" r="7.5"></circle>
          <line x1="16" y1="16" x2="22" y2="22"></line>
        </svg>
      </button>

      {% if section.settings.show_login %}
        <a class="moru-header__action" href="{{ routes.account_login_url }}" aria-label="{{ 'moru.header.login' | t }}">
          <span class="moru-header__action-text">{{ 'moru.header.login' | t }}</span>
          <svg class="moru-header__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
        </a>
      {% endif %}

      <a class="moru-header__action moru-header__cart" href="{{ routes.cart_url }}" aria-label="{{ 'moru.header.cart' | t }}">
        <svg class="moru-header__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <circle cx="9" cy="20" r="1.2"></circle>
          <circle cx="18" cy="20" r="1.2"></circle>
          <path d="M1 2.5h3.5l2.2 11.5a1.8 1.8 0 0 0 1.8 1.5h10.2a1.8 1.8 0 0 0 1.8-1.4l1.6-8.1H5.2"></path>
        </svg>
        <span class="moru-header__cart-badge">{{ cart.item_count }}</span>
      </a>
    </div>
  </div>

  <div class="moru-header__search" data-search-drawer>
    <form class="moru-header__search-form" action="{{ routes.search_url }}" method="get" role="search">
      <input
        class="moru-header__search-input"
        type="search"
        name="q"
        data-search-input
        placeholder="{{ 'moru.header.search_placeholder' | t }}"
        aria-label="{{ 'moru.header.search' | t }}"
      >
      <button class="moru-header__search-close" type="button" data-search-close aria-label="{{ 'moru.header.close' | t }}">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </form>
  </div>

  <div class="moru-header__backdrop" data-nav-backdrop></div>

  <aside class="moru-header__drawer" data-nav-drawer aria-hidden="true" aria-label="{{ 'moru.header.menu' | t }}">
    <button class="moru-header__drawer-close" type="button" data-menu-close aria-label="{{ 'moru.header.close' | t }}">✕</button>
    <ul class="moru-header__drawer-list" role="list">
      {% for link in section.settings.menu.links %}
        <li>
          <a
            {% if sale_title != blank and link.title == sale_title %}class="moru-header__nav-link--sale"{% endif %}
            href="{{ link.url }}"
          >
            {{- link.title -}}
          </a>
        </li>
      {% endfor %}
    </ul>
  </aside>
</moru-header>

{% javascript %}
  class MoruHeader extends HTMLElement {
    connectedCallback() {
      this.searchDrawer = this.querySelector('[data-search-drawer]');
      this.searchInput = this.querySelector('[data-search-input]');
      this.navDrawer = this.querySelector('[data-nav-drawer]');
      this.backdrop = this.querySelector('[data-nav-backdrop]');

      this.querySelector('[data-search-toggle]')?.addEventListener('click', () => this.toggleSearch());
      this.querySelector('[data-search-close]')?.addEventListener('click', () => this.closeSearch());
      this.querySelector('[data-menu-open]')?.addEventListener('click', () => this.openMenu());
      this.querySelector('[data-menu-close]')?.addEventListener('click', () => this.closeMenu());
      this.backdrop?.addEventListener('click', () => this.closeMenu());

      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;
        this.closeSearch();
        this.closeMenu();
      });
    }

    toggleSearch() {
      const isOpen = this.searchDrawer.classList.toggle('is-open');
      if (isOpen) setTimeout(() => this.searchInput?.focus(), 150);
    }

    closeSearch() {
      this.searchDrawer?.classList.remove('is-open');
    }

    openMenu() {
      this.navDrawer?.classList.add('is-open');
      this.navDrawer?.setAttribute('aria-hidden', 'false');
      this.backdrop?.classList.add('is-open');
      document.body.style.overflow = 'hidden';
    }

    closeMenu() {
      this.navDrawer?.classList.remove('is-open');
      this.navDrawer?.setAttribute('aria-hidden', 'true');
      this.backdrop?.classList.remove('is-open');
      document.body.style.overflow = '';
    }
  }

  if (!customElements.get('moru-header')) {
    customElements.define('moru-header', MoruHeader);
  }
{% endjavascript %}

{% stylesheet %}
  .moru-header-section {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--color-bg);
    box-shadow: 0 1px 0 rgb(0 0 0 / 0.04);
    transition: all 0.3s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .moru-header {
    display: block;
  }

  .moru-header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    max-width: 1440px;
    height: 84px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .moru-header__nav {
    display: flex;
    align-items: center;
  }

  .moru-header__nav-list {
    display: flex;
    align-items: center;
    gap: 30px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .moru-header__nav-link {
    position: relative;
    padding: 6px 0;
    color: var(--color-text);
    font-size: 13.5px;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-decoration: none;
    white-space: nowrap;
    transition: opacity 0.25s ease;
  }

  .moru-header__nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 0;
    height: 1px;
    background-color: currentcolor;
    opacity: 0.7;
    transition: width 0.3s cubic-bezier(0.25, 1, 0.5, 1), left 0.3s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .moru-header__nav-link:hover::after {
    width: 100%;
    left: 0;
  }

  .moru-header__nav-link:hover {
    color: var(--color-text);
  }

  .moru-header__nav-link--sale {
    color: var(--color-sale);
    font-weight: 500;
  }

  .moru-header__nav-link--sale:hover {
    color: var(--color-sale);
  }

  .moru-header__logo {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .moru-header__logo-link {
    display: inline-block;
    margin-left: 0.22em;
    color: var(--color-logo);
    font-family: var(--font-display--family);
    font-size: 38px;
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0.22em;
    text-decoration: none;
    text-transform: uppercase;
    transition: opacity 0.3s ease;
  }

  .moru-header__logo-link:hover {
    color: var(--color-logo);
    opacity: 0.8;
  }

  .moru-header__logo-link img {
    display: block;
    width: var(--logo-width);
    height: auto;
    margin-left: -0.22em;
  }

  .moru-header__actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 26px;
  }

  .moru-header__action {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 4px;
    border: none;
    outline: none;
    background: none;
    color: var(--color-text);
    font-family: inherit;
    font-size: 13.5px;
    letter-spacing: 0.05em;
    text-decoration: none;
    cursor: pointer;
    transition: opacity 0.25s ease;
  }

  .moru-header__action:hover {
    color: var(--color-text);
    opacity: 0.65;
  }

  .moru-header__icon {
    width: 19px;
    height: 19px;
    fill: none;
    stroke: currentcolor;
    stroke-width: 1.35;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .moru-header__cart {
    position: relative;
    justify-content: center;
  }

  .moru-header__cart-badge {
    position: absolute;
    top: -1px;
    right: -6px;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 16px;
    height: 16px;
    padding: 0 2px;
    border-radius: 50%;
    background-color: var(--color-text);
    color: var(--color-bg);
    font-size: 10px;
    font-weight: 500;
    transform: scale(0.9);
  }

  .moru-header__search {
    max-height: 0;
    padding: 0 40px;
    overflow: hidden;
    background-color: var(--color-bg);
    border-block-start: 1px solid var(--color-border);
    transition: max-height 0.4s cubic-bezier(0.16, 1, 0.3, 1), padding 0.4s ease;
  }

  .moru-header__search.is-open {
    max-height: 90px;
    padding: 20px 40px;
  }

  .moru-header__search-form {
    position: relative;
    display: flex;
    align-items: center;
    max-width: 580px;
    margin: 0 auto;
    border-block-end: 1px solid var(--color-text);
  }

  .moru-header__search-input {
    width: 100%;
    padding: 8px 36px 8px 4px;
    border: none;
    outline: none;
    background: transparent;
    color: var(--color-text);
    font-family: inherit;
    font-size: 14px;
    letter-spacing: 0.05em;
  }

  .moru-header__search-input::placeholder {
    color: var(--color-muted);
    font-size: 13px;
    opacity: 0.75;
  }

  .moru-header__search-close {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4px;
    border: none;
    background: none;
    color: var(--color-muted);
    cursor: pointer;
    transition: color 0.2s ease;
  }

  .moru-header__search-close:hover {
    color: var(--color-text);
  }

  .moru-header__menu-toggle {
    display: none;
    padding: 6px;
    border: none;
    background: none;
    color: var(--color-text);
    cursor: pointer;
  }

  .moru-header__backdrop {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 998;
    background-color: rgb(0 0 0 / 0.3);
    backdrop-filter: blur(2px);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.35s ease, visibility 0.35s ease;
  }

  .moru-header__backdrop.is-open {
    opacity: 1;
    visibility: visible;
  }

  .moru-header__drawer {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 999;
    display: flex;
    flex-direction: column;
    width: 82%;
    max-width: 320px;
    height: 100vh;
    padding: 30px 24px;
    background-color: var(--color-bg);
    box-shadow: 10px 0 25px rgb(0 0 0 / 0.05);
    transform: translateX(-100%);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .moru-header__drawer.is-open {
    transform: translateX(0);
  }

  .moru-header__drawer-close {
    align-self: flex-end;
    margin-block-end: 24px;
    border: none;
    background: none;
    color: var(--color-muted);
    font-size: 24px;
    cursor: pointer;
  }

  .moru-header__drawer-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .moru-header__drawer-list a {
    display: block;
    padding: 4px 0;
    color: var(--color-text);
    font-size: 16px;
    letter-spacing: 0.08em;
    text-decoration: none;
  }

  @media (max-width: 1024px) {
    .moru-header__inner {
      height: 76px;
      padding: 0 24px;
    }

    .moru-header__nav-list {
      gap: 18px;
    }

    .moru-header__actions {
      gap: 18px;
    }

    .moru-header__logo-link {
      font-size: 32px;
    }
  }

  @media (max-width: 860px) {
    .moru-header__inner {
      grid-template-columns: auto 1fr auto;
    }

    .moru-header__nav {
      display: none;
    }

    .moru-header__menu-toggle {
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .moru-header__action-text {
      display: none;
    }

    .moru-header__logo-link {
      font-size: 28px;
    }

    .moru-header__search,
    .moru-header__search.is-open {
      padding-inline: 24px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:moru.header.name",
  "class": "moru-header-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:moru.header.logo_label",
      "info": "t:moru.header.logo_info"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 80,
      "max": 240,
      "step": 10,
      "unit": "px",
      "label": "t:moru.header.logo_width_label",
      "default": 140
    },
    {
      "type": "text",
      "id": "wordmark",
      "label": "t:moru.header.wordmark_label",
      "info": "t:moru.header.wordmark_info",
      "default": "t:moru.header.wordmark_default"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "main-menu"
    },
    {
      "type": "text",
      "id": "sale_link_title",
      "label": "t:moru.header.sale_link_title_label",
      "info": "t:moru.header.sale_link_title_info",
      "default": "t:moru.header.sale_link_title_default"
    },
    {
      "type": "checkbox",
      "id": "show_login",
      "label": "t:moru.header.show_login_label",
      "info": "t:moru.header.show_login_info",
      "default": true
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  },
  "presets": [
    {
      "name": "t:moru.header.name"
    }
  ]
}
{% endschema %}
