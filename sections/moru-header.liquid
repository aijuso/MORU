<header class="moru-header">
  <details class="moru-header__drawer">
    <summary aria-label="{{ 'moru.header.menu' | t }}">
      <span class="moru-header__burger" aria-hidden="true"></span>
    </summary>
    <nav class="moru-header__drawer-nav">
      {% for link in section.settings.menu.links %}
        {{ link.title | link_to: link.url }}
      {% endfor %}
    </nav>
  </details>

  <nav class="moru-header__nav" aria-label="{{ 'moru.header.menu' | t }}">
    {% for link in section.settings.menu.links %}
      {{ link.title | link_to: link.url }}
    {% endfor %}
  </nav>

  <a class="moru-header__logo" href="{{ routes.root_url }}" style="--logo-width: {{ section.settings.logo_width }}px">
    {% if section.settings.logo %}
      {{ section.settings.logo | image_url: width: 480 | image_tag: alt: shop.name, widths: '240, 480' }}
    {% else %}
      <span class="moru-header__wordmark">{{ shop.name }}</span>
    {% endif %}
  </a>

  <div class="moru-header__icons">
    <a href="{{ routes.search_url }}" aria-label="{{ 'moru.header.search' | t }}">
      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
        <circle cx="9" cy="9" r="6"></circle>
        <path d="m13.5 13.5 4 4"></path>
      </svg>
    </a>
    {% if shop.customer_accounts_enabled %}
      <shopify-account menu="{{ section.settings.customer_account_menu }}">
        {{ 'icon-account.svg' | inline_asset_content }}
      </shopify-account>
    {% endif %}
    <a href="{{ routes.cart_url }}" aria-label="{{ 'moru.header.cart' | t }}">
      {% if cart.item_count > 0 %}
        <sup>{{ cart.item_count }}</sup>
      {% endif %}
      {{ 'icon-cart.svg' | inline_asset_content }}
    </a>
  </div>
</header>

{% stylesheet %}
  .moru-header-section {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--color-bg);
    border-block-end: 1px solid var(--color-border);
  }

  .moru-header {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-md);
    min-height: 4.75rem;
  }

  .moru-header a {
    color: var(--color-text);
    text-decoration: none;
  }

  .moru-header__nav {
    display: flex;
    gap: var(--space-md);
    font-size: var(--font-size-sm);
  }

  .moru-header__nav a {
    position: relative;
    padding-block: var(--space-2xs);
  }

  .moru-header__nav a::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 1px;
    background-color: var(--color-text);
    transition: width 300ms ease;
  }

  .moru-header__nav a:hover::after {
    width: 100%;
  }

  .moru-header__logo {
    justify-self: center;
  }

  .moru-header__logo img {
    width: var(--logo-width);
    height: auto;
  }

  .moru-header__wordmark {
    font-family: var(--font-display--family);
    font-size: var(--font-size-2xl);
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .moru-header__icons {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: var(--space-md);
  }

  .moru-header__icons a {
    position: relative;
    display: flex;
    align-items: center;
    transition: color 150ms ease, transform 150ms ease;
  }

  .moru-header__icons a:hover {
    color: var(--color-accent-terracotta);
    transform: translateY(-1px);
  }

  .moru-header__icons svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .moru-header__icons sup {
    position: absolute;
    top: -0.3rem;
    right: -0.5rem;
    display: grid;
    place-items: center;
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    background-color: var(--color-text);
    color: var(--color-bg);
    font-size: 0.625rem;
    line-height: 1;
  }

  .moru-header__drawer {
    display: none;
  }

  .moru-header__burger {
    display: block;
    width: 1.25rem;
    height: 2px;
    background-color: var(--color-text);
    box-shadow: 0 -6px 0 var(--color-text), 0 6px 0 var(--color-text);
  }

  .moru-header__drawer summary {
    list-style: none;
    cursor: pointer;
    padding-block: var(--space-xs);
  }

  .moru-header__drawer summary::-webkit-details-marker {
    display: none;
  }

  .moru-header__drawer-nav {
    position: absolute;
    inset-inline: 0;
    top: 100%;
    z-index: 10;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding: var(--space-md) var(--page-margin);
    background-color: var(--color-bg);
    border-block: 1px solid var(--color-bg-alt);
  }

  @media (max-width: 749px) {
    .moru-header {
      position: relative;
    }

    .moru-header__nav {
      display: none;
    }

    .moru-header__drawer {
      display: block;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:moru.header.name",
  "class": "moru-header-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:moru.header.logo_label",
      "info": "t:moru.header.logo_info"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 80,
      "max": 240,
      "step": 10,
      "unit": "px",
      "label": "t:moru.header.logo_width_label",
      "default": 140
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "main-menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  },
  "presets": [
    {
      "name": "t:moru.header.name"
    }
  ]
}
{% endschema %}
