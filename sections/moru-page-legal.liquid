<div class="moru-page-legal">
  {% if section.settings.heading != blank %}
    <h2 class="moru-page-legal__heading">{{ section.settings.heading }}</h2>
  {% endif %}

  {% if section.settings.intro != blank %}
    <div class="moru-page-legal__intro">{{ section.settings.intro }}</div>
  {% endif %}

  {% if section.blocks.size > 0 %}
    <dl class="moru-page-legal__table">
      {% for block in section.blocks %}
        <div class="moru-page-legal__row" {{ block.shopify_attributes }}>
          <dt class="moru-page-legal__label">{{ block.settings.label }}</dt>
          <dd class="moru-page-legal__value">
            {%- if block.settings.content != blank -%}
              {{ block.settings.content }}
            {%- else -%}
              <p class="moru-page-legal__todo">{{ 'moru.page.legal_todo' | t }}</p>
            {%- endif -%}
          </dd>
        </div>
      {% endfor %}
    </dl>
  {% else %}
    <p class="moru-page-legal__empty">{{ 'moru.page.legal_empty' | t }}</p>
  {% endif %}

  {% if section.settings.note != blank %}
    <div class="moru-page-legal__note">{{ section.settings.note }}</div>
  {% endif %}
</div>

{% stylesheet %}
  .moru-page-legal {
    max-width: 52rem;
    padding-block: var(--space-xl) var(--space-2xl);
  }

  .moru-page-legal__heading {
    margin: 0 0 var(--space-md);
    font-size: var(--font-size-xl);
  }

  .moru-page-legal__intro {
    margin-block-end: var(--space-lg);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-body);
    color: var(--color-muted);
  }

  .moru-page-legal__table {
    margin: 0;
    border-block-start: 1px solid var(--color-border);
  }

  .moru-page-legal__row {
    display: grid;
    grid-template-columns: 14rem 1fr;
    gap: var(--space-md);
    padding-block: var(--space-md);
    border-block-end: 1px solid var(--color-border);
  }

  .moru-page-legal__label {
    font-size: var(--font-size-sm);
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  .moru-page-legal__value {
    margin: 0;
    font-size: var(--font-size-sm);
    line-height: var(--line-height-body);
    color: var(--color-muted);
  }

  .moru-page-legal__value > :first-child {
    margin-block-start: 0;
  }

  .moru-page-legal__value > :last-child {
    margin-block-end: 0;
  }

  .moru-page-legal__todo {
    color: var(--color-accent-terracotta);
  }

  .moru-page-legal__empty {
    margin: 0;
    padding: var(--space-lg);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-card);
    font-size: var(--font-size-xs);
    color: var(--color-muted);
  }

  .moru-page-legal__note {
    margin-block-start: var(--space-lg);
    font-size: var(--font-size-xs);
    line-height: 1.9;
    color: var(--color-muted);
  }

  @media (max-width: 768px) {
    .moru-page-legal__row {
      grid-template-columns: 1fr;
      gap: var(--space-2xs);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:moru.page_legal.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:moru.common.title",
      "info": "t:moru.page_content.heading_info"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "t:moru.page_legal.intro_label"
    },
    {
      "type": "richtext",
      "id": "note",
      "label": "t:moru.page_legal.note_label",
      "info": "t:moru.page_legal.note_info"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "t:moru.page_legal.block_row_name",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:moru.page_legal.row_label_label",
          "default": "t:moru.page_legal.row_label_default"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "t:moru.page_legal.row_content_label",
          "info": "t:moru.page_legal.row_content_info"
        }
      ]
    }
  ],
  "max_blocks": 24,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "presets": [
    {
      "name": "t:moru.page_legal.name",
      "blocks": [{ "type": "row" }, { "type": "row" }, { "type": "row" }]
    }
  ]
}
{% endschema %}
