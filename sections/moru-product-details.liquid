{% liquid
  assign rating_value = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value | default: 0
  assign has_reviews = false
  if rating_value != blank and rating_count > 0
    assign has_reviews = true
  endif

  assign app_blocks = section.blocks | where: 'type', '@app'
  assign accordion_blocks = section.blocks | where: 'type', 'accordion'
%}

<div class="moru-details">
  <div class="moru-details__reviews">
    <h2 class="moru-details__heading">{{ section.settings.reviews_title }}</h2>

    {% if has_reviews %}
      {% liquid
        assign rating = rating_value.rating
        assign rating_rounded = rating | round
      %}
      <div class="moru-details__score">
        <div class="moru-details__score-big">
          <span class="moru-details__score-num">{{ rating }}</span>
          <span class="moru-rating-stars" aria-hidden="true">
            {%- for i in (1..5) -%}
              {%- if i <= rating_rounded -%}★{%- else -%}☆{%- endif -%}
            {%- endfor -%}
          </span>
          <span class="moru-details__score-count">{{ 'moru.product.review_count' | t: count: rating_count }}</span>
        </div>
        {% if section.settings.reviews_note != blank %}
          <p class="moru-details__score-note">{{ section.settings.reviews_note }}</p>
        {% endif %}
      </div>
    {% else %}
      <p class="moru-details__empty">{{ 'moru.product.no_reviews' | t }}</p>
    {% endif %}

    {% for block in app_blocks %}
      <div class="moru-details__app" {{ block.shopify_attributes }}>
        {% render block %}
      </div>
    {% endfor %}
  </div>

  <div class="moru-details__accordions">
    {% for block in accordion_blocks %}
      <details
        class="moru-accordion"
        {% if block.settings.open_by_default %}open{% endif %}
        {{ block.shopify_attributes }}
      >
        <summary class="moru-accordion__summary">
          <span>{{ block.settings.heading }}</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </summary>
        <div class="moru-accordion__content">
          {% if block.settings.use_description and product.description != blank %}
            {{ product.description }}
          {% else %}
            {{ block.settings.content }}
          {% endif %}
        </div>
      </details>
    {% endfor %}
  </div>
</div>

{% stylesheet %}
  .moru-details {
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    gap: var(--space-3xl);
    padding-block: var(--space-2xl);
  }

  .moru-details__heading {
    margin: 0 0 var(--space-lg);
    font-size: var(--font-size-lg);
    letter-spacing: 0.04em;
  }

  .moru-details__score {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    padding: var(--space-md);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background-color: var(--color-bg-alt);
  }

  .moru-details__score-big {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 6.5rem;
  }

  .moru-details__score-num {
    font-size: 3rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .moru-details__score-big .moru-rating-stars {
    margin-block: var(--space-2xs);
    font-size: var(--font-size-sm);
  }

  .moru-details__score-count,
  .moru-details__score-note {
    margin: 0;
    font-size: var(--font-size-xs);
    color: var(--color-muted);
    line-height: 1.7;
  }

  .moru-details__empty {
    margin: 0;
    padding: var(--space-lg);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-card);
    font-size: var(--font-size-sm);
    color: var(--color-muted);
    text-align: center;
  }

  .moru-details__app {
    margin-block-start: var(--space-md);
  }

  .moru-details__accordions {
    display: flex;
    flex-direction: column;
    border-block-start: 1px solid var(--color-border);
  }

  .moru-accordion {
    border-block-end: 1px solid var(--color-border);
  }

  .moru-accordion__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding-block: var(--space-md);
    font-size: var(--font-size-sm);
    font-weight: 500;
    list-style: none;
    cursor: pointer;
  }

  .moru-accordion__summary::-webkit-details-marker {
    display: none;
  }

  .moru-accordion__summary svg {
    flex-shrink: 0;
    width: 1rem;
    height: 1rem;
    transition: transform 300ms ease;
  }

  .moru-accordion[open] .moru-accordion__summary svg {
    transform: rotate(180deg);
  }

  .moru-accordion__content {
    padding-block-end: var(--space-md);
    font-size: var(--font-size-sm);
    line-height: 1.8;
    color: var(--color-muted);
  }

  .moru-accordion__content > :last-child {
    margin-block-end: 0;
  }

  @media (max-width: 989px) {
    .moru-details {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:moru.product_details.name",
  "settings": [
    {
      "type": "text",
      "id": "reviews_title",
      "label": "t:moru.product_details.reviews_title_label",
      "default": "t:moru.product_details.reviews_title_default"
    },
    {
      "type": "textarea",
      "id": "reviews_note",
      "label": "t:moru.product_details.reviews_note_label",
      "info": "t:moru.product_details.reviews_note_info"
    }
  ],
  "blocks": [
    {
      "type": "accordion",
      "name": "t:moru.product_details.block_accordion_name",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:moru.common.title",
          "default": "t:moru.product_details.block_heading_default"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "t:moru.product_details.block_content_label"
        },
        {
          "type": "checkbox",
          "id": "use_description",
          "label": "t:moru.product_details.block_use_description_label",
          "info": "t:moru.product_details.block_use_description_info",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "open_by_default",
          "label": "t:moru.product_details.block_open_label",
          "default": false
        }
      ]
    },
    {
      "type": "@app"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "presets": [
    {
      "name": "t:moru.product_details.name",
      "blocks": [
        {
          "type": "accordion",
          "settings": {
            "use_description": true,
            "open_by_default": true
          }
        },
        {
          "type": "accordion"
        },
        {
          "type": "accordion"
        },
        {
          "type": "accordion"
        },
        {
          "type": "accordion"
        }
      ]
    }
  ]
}
{% endschema %}
