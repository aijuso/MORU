{% liquid
  assign accordion_blocks = section.blocks | where: 'type', 'accordion'
%}

{% if accordion_blocks.size > 0 %}
  <div class="moru-details">
    <div class="moru-details__accordions">
      {% for block in accordion_blocks %}
        {% liquid
          assign hide_accordion = false
          if block.settings.use_specs_metafield and product.metafields.custom.specs == blank
            assign hide_accordion = true
          endif
        %}
        {% unless hide_accordion %}
          <details class="moru-accordion" {% if block.settings.open_by_default %}open{% endif %} {{ block.shopify_attributes }}>
            <summary class="moru-accordion__summary">
              <span>{{ block.settings.heading }}</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </summary>
            <div class="moru-accordion__content">
              {% if block.settings.use_description and product.description != blank %}
                {{ product.description }}
              {% elsif block.settings.use_specs_metafield and product.metafields.custom.specs != blank %}
                {{ product.metafields.custom.specs | metafield_tag }}
              {% else %}
                {{ block.settings.content }}
              {% endif %}
            </div>
          </details>
        {% endunless %}
      {% endfor %}
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .moru-details { width: 100%; max-width: 64rem; margin-inline: auto; padding-block: var(--space-2xl); }
  .moru-details__accordions, .moru-details .moru-accordion { width: 100%; }
  .moru-details__accordions { display: flex; flex-direction: column; border-block-start: 1px solid var(--color-border); }
  .moru-details .moru-accordion__summary { width: 100%; box-sizing: border-box; padding-inline: 0; text-align: left; }
  .moru-details .moru-accordion__summary > span { flex: 1 1 auto; min-width: 0; text-align: left; }
  .moru-details .moru-accordion__content { width: 100%; box-sizing: border-box; padding-inline: 0; text-align: left; }
  .moru-details .moru-accordion__content p { margin: 0; }
  .moru-details .moru-accordion__content p + p { margin-block-start: 1em; }
  .moru-details .moru-accordion__content p:empty { display: block; min-height: 1em; }
  .moru-details .moru-accordion__content :is(ul, ol) { margin-block: 0.85em; padding-inline-start: 1.4em; }
  .moru-details .moru-accordion__content li + li { margin-block-start: 0.35em; }
  .moru-details .moru-accordion__content :is(h2, h3, h4) { margin-block: 1.2em 0.55em; line-height: 1.5; }
  .moru-details .moru-accordion__content > :first-child { margin-block-start: 0; }
  .moru-details .moru-accordion__content > :last-child { margin-block-end: 0; }
  @media (max-width: 749px) {
    .moru-details { padding-block: var(--space-xl); }
    .moru-details .moru-accordion__summary { min-height: 52px; padding-block: 0.9rem; }
    .moru-details .moru-accordion__content { padding-block-end: 1.1rem; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "商品詳細アコーディオン",
  "blocks": [
    {
      "type": "accordion",
      "name": "t:moru.product_details.block_accordion_name",
      "settings": [
        { "type": "text", "id": "heading", "label": "t:moru.common.title", "default": "t:moru.product_details.block_heading_default" },
        { "type": "richtext", "id": "content", "label": "t:moru.product_details.block_content_label" },
        { "type": "checkbox", "id": "use_description", "label": "t:moru.product_details.block_use_description_label", "info": "t:moru.product_details.block_use_description_info", "default": false },
        { "type": "checkbox", "id": "use_specs_metafield", "label": "t:moru.product_details.block_use_specs_label", "info": "t:moru.product_details.block_use_specs_info", "default": false },
        { "type": "checkbox", "id": "open_by_default", "label": "t:moru.product_details.block_open_label", "default": false }
      ]
    }
  ],
  "disabled_on": { "groups": ["header", "footer"] },
  "presets": [{ "name": "商品詳細アコーディオン", "blocks": [
    { "type": "accordion", "settings": { "use_description": true, "open_by_default": true } },
    { "type": "accordion" }, { "type": "accordion" }, { "type": "accordion" }, { "type": "accordion" }
  ] }]
}
{% endschema %}
