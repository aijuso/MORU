{%- liquid
  assign visible_count = 0
  for block in section.blocks
    if block.settings.heading != blank or block.settings.subheading != blank
      assign visible_count = visible_count | plus: 1
    endif
  endfor
-%}

{%- if visible_count > 0 -%}
  <div class="moru-usp moru-usp--{{ section.settings.background }}">
    <ul class="moru-usp__grid" role="list" style="--moru-usp-columns: {{ section.settings.columns }};">
      {%- for block in section.blocks -%}
        {%- if block.settings.heading != blank or block.settings.subheading != blank -%}
          <li class="moru-usp__item" {{ block.shopify_attributes }}>
            <span class="moru-usp__icon" aria-hidden="true">
              {%- case block.settings.icon -%}
                {%- when 'truck' -%}
                  <svg viewBox="0 0 32 32" fill="none" width="30" height="30">
                    <path d="M2 8h16v13H2z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
                    <path d="M18 12h6l4 5v4h-10z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
                    <circle cx="9" cy="24" r="2.4" stroke="currentColor" stroke-width="1.4"/>
                    <circle cx="23" cy="24" r="2.4" stroke="currentColor" stroke-width="1.4"/>
                  </svg>
                {%- when 'calendar' -%}
                  <svg viewBox="0 0 32 32" fill="none" width="30" height="30">
                    <rect x="4" y="7" width="24" height="21" rx="2" stroke="currentColor" stroke-width="1.4"/>
                    <path d="M4 13h24M10 4v6M22 4v6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                    <circle cx="16" cy="20" r="1.6" fill="currentColor"/>
                  </svg>
                {%- when 'shield' -%}
                  <svg viewBox="0 0 32 32" fill="none" width="30" height="30">
                    <path d="M16 3l11 4v9c0 7-4.7 11.4-11 13-6.3-1.6-11-6-11-13V7z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
                    <path d="M11 16l3.5 3.5L21 13" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                {%- when 'paw' -%}
                  <svg viewBox="0 0 32 32" fill="none" width="30" height="30">
                    <ellipse cx="10" cy="10" rx="2.6" ry="3.4" stroke="currentColor" stroke-width="1.4"/>
                    <ellipse cx="17" cy="8" rx="2.6" ry="3.4" stroke="currentColor" stroke-width="1.4"/>
                    <ellipse cx="24" cy="12" rx="2.6" ry="3.2" stroke="currentColor" stroke-width="1.4"/>
                    <path d="M16 16c4 0 7 2.8 7 6.2 0 2.6-2 4.3-4.6 4.3-1.6 0-2-.6-3.4-.6s-1.8.6-3.4.6C9 26.5 7 24.8 7 22.2 7 18.8 12 16 16 16z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
                  </svg>
                {%- when 'leaf' -%}
                  <svg viewBox="0 0 32 32" fill="none" width="30" height="30">
                    <path d="M27 5C13 5 6 11 6 20c0 3 1 5 1 5s3-9 20-13c0 0-8 4-14 11-2 2.4-3 5-3 5s4 1 8-1c7-3.6 9-11 9-22z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
                  </svg>
                {%- else -%}
                  <svg viewBox="0 0 32 32" fill="none" width="30" height="30">
                    <circle cx="16" cy="16" r="12" stroke="currentColor" stroke-width="1.4"/>
                    <path d="M11 16l3.5 3.5L21 13" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
              {%- endcase -%}
            </span>
            <span class="moru-usp__text">
              {%- if block.settings.heading != blank -%}
                <span class="moru-usp__heading">{{ block.settings.heading }}</span>
              {%- endif -%}
              {%- if block.settings.subheading != blank -%}
                <span class="moru-usp__sub">{{ block.settings.subheading }}</span>
              {%- endif -%}
            </span>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
{%- endif -%}

{% stylesheet %}
  .moru-usp {
    margin-block: var(--space-lg);
  }

  .moru-usp--alt {
    padding: var(--space-md) var(--space-lg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background-color: var(--color-bg-alt);
  }

  .moru-usp--none {
    padding-block: var(--space-md);
    border-block: 1px solid var(--color-border);
  }

  .moru-usp__grid {
    display: grid;
    grid-template-columns: repeat(var(--moru-usp-columns, 4), minmax(0, 1fr));
    gap: var(--space-md);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .moru-usp__item {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    min-width: 0;
  }

  .moru-usp__icon {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text);
  }

  .moru-usp__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .moru-usp__heading {
    font-size: var(--font-size-xs);
    font-weight: 700;
    line-height: 1.4;
    color: var(--color-text);
  }

  .moru-usp__sub {
    font-size: var(--font-size-xs);
    line-height: 1.4;
    color: var(--color-muted);
  }

  @media (max-width: 1024px) {
    .moru-usp__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 480px) {
    .moru-usp__grid {
      gap: var(--space-sm);
    }

    .moru-usp--alt {
      padding: var(--space-md);
    }

    .moru-usp__item {
      gap: var(--space-xs);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:moru.usp.name",
  "tag": "section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:moru.usp.section_info"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "t:moru.usp.columns_label",
      "info": "t:moru.usp.columns_info",
      "default": 4
    },
    {
      "type": "select",
      "id": "background",
      "label": "t:moru.common.background_label",
      "options": [
        { "value": "alt", "label": "t:moru.usp.bg_alt" },
        { "value": "none", "label": "t:moru.usp.bg_none" }
      ],
      "default": "alt"
    }
  ],
  "blocks": [
    {
      "type": "usp",
      "name": "t:moru.usp.block_name",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:moru.usp.icon_label",
          "options": [
            { "value": "truck", "label": "t:moru.usp.icon_truck" },
            { "value": "calendar", "label": "t:moru.usp.icon_calendar" },
            { "value": "shield", "label": "t:moru.usp.icon_shield" },
            { "value": "paw", "label": "t:moru.usp.icon_paw" },
            { "value": "leaf", "label": "t:moru.usp.icon_leaf" },
            { "value": "check", "label": "t:moru.usp.icon_check" }
          ],
          "default": "check"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:moru.common.title"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "t:moru.usp.sub_label"
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "presets": [
    {
      "name": "t:moru.usp.name",
      "blocks": [
        { "type": "usp", "settings": { "icon": "truck" } },
        { "type": "usp", "settings": { "icon": "calendar" } },
        { "type": "usp", "settings": { "icon": "shield" } },
        { "type": "usp", "settings": { "icon": "paw" } }
      ]
    }
  ]
}
{% endschema %}
