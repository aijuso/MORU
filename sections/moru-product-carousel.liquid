<div class="moru-carousel">
  <div class="moru-section-header">
    <h2>{{ section.settings.title }}</h2>
    {% if section.settings.collection != blank %}
      <a class="moru-section-header__link" href="{{ section.settings.collection.url }}">{{ section.settings.view_all_label }} &rarr;</a>
    {% endif %}
  </div>

  <ul class="moru-carousel__track" role="list">
    {% if section.settings.collection != blank %}
      {% for product in section.settings.collection.products limit: section.settings.products_to_show %}
        <li class="moru-carousel__item">
          {% render 'moru-product-card', product: product %}
        </li>
      {% endfor %}
    {% else %}
      {% for i in (1..6) %}
        <li class="moru-carousel__item">
          {% render 'moru-product-card', ph_index: forloop.index %}
        </li>
      {% endfor %}
    {% endif %}
  </ul>

  {% if section.settings.collection == blank %}
    <p class="moru-carousel__hint">{{ 'moru.placeholder.select_collection' | t }}</p>
  {% endif %}
</div>

{% stylesheet %}
  .moru-carousel {
    padding-block: var(--section-padding-block);
  }

  .moru-carousel__track {
    display: flex;
    gap: var(--space-md);
    margin: 0;
    padding: 0 0 var(--space-sm);
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: var(--color-wood) var(--color-bg-alt);
  }

  .moru-carousel__track::-webkit-scrollbar {
    height: 3px;
  }

  .moru-carousel__track::-webkit-scrollbar-thumb {
    background-color: var(--color-wood);
  }

  .moru-carousel__track::-webkit-scrollbar-track {
    background-color: var(--color-bg-alt);
  }

  .moru-carousel__item {
    flex: 0 0 calc((100% - 3 * var(--space-md)) / 4);
    scroll-snap-align: start;
  }

  .moru-carousel__hint {
    margin-block-start: var(--space-md);
    font-size: var(--font-size-xs);
    opacity: 0.6;
  }

  @media (max-width: 749px) {
    .moru-carousel__item {
      flex: 0 0 70%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:moru.product_carousel.name",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:moru.common.title",
      "default": "t:moru.product_carousel.title_default"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:moru.common.collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 1,
      "label": "t:moru.product_carousel.products_to_show_label",
      "default": 6
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "t:moru.common.view_all_label",
      "default": "t:moru.common.view_all_default"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "presets": [
    {
      "name": "t:moru.product_carousel.name"
    }
  ]
}
{% endschema %}
