{% liquid
  assign has_cloud = false
  assign has_mushroom = false
  for item in cart.items
    if item.product.handle == 'cloud-side-table'
      assign has_cloud = true
    elsif item.product.handle == 'mushroom-cordless-table-lamp'
      assign has_mushroom = true
    endif
  endfor
  assign pair_companion_title = ''
  assign pair_companion_url = ''
  if has_cloud and has_mushroom == false
    assign pair_companion_title = 'マッシュルーム コードレステーブルランプ'
    assign pair_companion_url = '/products/mushroom-cordless-table-lamp'
  elsif has_mushroom and has_cloud == false
    assign pair_companion_title = 'クラウド サイドテーブル'
    assign pair_companion_url = '/products/cloud-side-table'
  endif
%}

<moru-cart-drawer-v2 class="moru-cart-drawer-v2 full-width" data-cart-drawer data-section-id="{{ section.id }}" data-intercept-add="{{ section.settings.open_on_add }}" data-page-type="{{ request.page_type }}" aria-hidden="true">
  <div class="moru-cart-drawer-v2__backdrop" data-drawer-backdrop></div>
  <aside class="moru-cart-drawer-v2__panel" role="dialog" aria-modal="true" aria-label="カート">
    <header class="moru-cart-drawer-v2__head">
      <h2 class="moru-cart-drawer-v2__title">カート <span>{{ cart.item_count }}点</span></h2>
      <button class="moru-cart-drawer-v2__close" type="button" data-drawer-close aria-label="カートを閉じる"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg></button>
    </header>

    <div class="moru-cart-drawer-v2__body" data-drawer-body>
      {% if cart.item_count == 0 %}
        <div class="moru-cart-drawer-v2__empty"><p>カートは空です。</p><a class="moru-button moru-button--outline" href="{{ routes.all_products_collection_url }}">アイテムを見る</a></div>
      {% else %}
        <ul class="moru-cart-drawer-v2__items" role="list">
          {% for item in cart.items %}
            {% assign line_saving = item.original_line_price | minus: item.final_line_price %}
            <li class="moru-cart-drawer-v2__item{% if line_saving > 0 %} has-discount{% endif %}" data-line="{{ forloop.index }}">
              <a class="moru-cart-drawer-v2__media" href="{{ item.url }}">{% if item.image %}{{ item.image | image_url: width: 180, height: 180, crop: 'center' | image_tag: loading: 'lazy', alt: item.image.alt }}{% else %}{{ 'product-1' | placeholder_svg_tag }}{% endif %}</a>
              <div class="moru-cart-drawer-v2__item-body">
                <a class="moru-cart-drawer-v2__item-title" href="{{ item.url }}">{{ item.product.title }}</a>
                {% unless item.product.has_only_default_variant %}<p class="moru-cart-drawer-v2__variant">{{ item.variant.title }}</p>{% endunless %}
                {% if item.line_level_discount_allocations.size > 0 %}<ul class="moru-cart-drawer-v2__line-discounts" role="list">{% for allocation in item.line_level_discount_allocations %}<li><span>{{ allocation.discount_application.title }}</span><strong>−{{ allocation.amount | money }}</strong></li>{% endfor %}</ul>{% endif %}
                {% if line_saving > 0 %}<p class="moru-cart-drawer-v2__saved">{{ line_saving | money }} お得</p>{% endif %}
                <div class="moru-cart-drawer-v2__controls"><div class="moru-cart-drawer-v2__stepper" aria-label="数量"><button type="button" data-drawer-minus aria-label="数量を減らす">−</button><span data-drawer-qty>{{ item.quantity }}</span><button type="button" data-drawer-plus aria-label="数量を増やす">＋</button></div><button class="moru-cart-drawer-v2__remove" type="button" data-drawer-remove>削除</button></div>
              </div>
              <div class="moru-cart-drawer-v2__price">{% if line_saving > 0 %}<s>{{ item.original_line_price | money }}</s><strong class="moru-cart-drawer-v2__final-price">{{ item.final_line_price | money }}</strong><span class="moru-cart-drawer-v2__discount-badge">−{{ line_saving | money }}</span>{% else %}<span>{{ item.final_line_price | money }}</span>{% endif %}</div>
            </li>
          {% endfor %}
        </ul>

        {% if pair_companion_title != blank %}
          <div class="moru-cart-drawer-v2__upsell">
            <p class="moru-cart-drawer-v2__upsell-eyebrow">PAIR 15% OFF</p>
            <p class="moru-cart-drawer-v2__upsell-title">{{ pair_companion_title }}を追加するとPAIR対象</p>
            <p class="moru-cart-drawer-v2__upsell-copy">クラウド サイドテーブルとマッシュルーム コードレステーブルランプを一緒に選ぶと、対象の組み合わせに15%OFFが適用されます。</p>
            <a href="{{ pair_companion_url }}">対象商品を見る →</a>
          </div>
        {% endif %}
      {% endif %}
    </div>

    {% if cart.item_count > 0 %}
      {% assign original_cart_total = cart.total_price | plus: cart.total_discount %}
      <footer class="moru-cart-drawer-v2__foot{% if cart.total_discount > 0 %} has-discount{% endif %}">
        {% if cart.cart_level_discount_applications.size > 0 %}<ul class="moru-cart-drawer-v2__discounts" role="list">{% for discount in cart.cart_level_discount_applications %}<li><span>{{ discount.title }}</span><strong>−{{ discount.total_allocated_amount | money }}</strong></li>{% endfor %}</ul>{% endif %}
        {%- comment -%}
          ここは割引の「名前」しか出していないので、前に入れたクーポンが残っていても
          それがクーポンだと分からず、外す手段も無かった。コードで入った割引が
          あるときだけ、外せる場所(カートページ)へ案内する。
          外す操作はカートページ1箇所に寄せてある。
        {%- endcomment -%}
        {%- assign code_discounts = cart.discount_applications | where: 'type', 'discount_code' -%}
        {% if code_discounts.size > 0 %}<a class="moru-cart-drawer-v2__codes-link" href="{{ routes.cart_url }}">{{ 'moru.cart.coupon_manage' | t }}</a>{% endif %}
        {% if cart.total_discount > 0 %}
          <div class="moru-cart-drawer-v2__summary-row moru-cart-drawer-v2__summary-row--original"><span>通常合計</span><s>{{ original_cart_total | money }}</s></div>
          <div class="moru-cart-drawer-v2__summary-row moru-cart-drawer-v2__summary-row--discount"><span>割引</span><strong>−{{ cart.total_discount | money }}</strong></div>
          <div class="moru-cart-drawer-v2__subtotal moru-cart-drawer-v2__subtotal--discounted"><span>割引後小計</span><strong>{{ cart.total_price | money }}</strong></div>
          <p class="moru-cart-drawer-v2__total-saved">合計 {{ cart.total_discount | money }} お得</p>
        {% else %}<div class="moru-cart-drawer-v2__subtotal"><span>小計</span><strong>{{ cart.total_price | money }}</strong></div>{% endif %}
        <p class="moru-cart-drawer-v2__note">割引はShopifyで実際に適用された金額のみ表示しています。送料などの最終金額はチェックアウトでご確認ください。</p>
        <form class="moru-cart-drawer-v2__actions" action="{{ routes.cart_url }}" method="post"><a class="moru-button moru-button--outline" href="{{ routes.cart_url }}">カートを見る</a><button class="moru-button" type="submit" name="checkout">購入手続きへ</button></form>
      </footer>
    {% endif %}
  </aside>
</moru-cart-drawer-v2>

{% stylesheet %}
  .moru-cart-drawer-v2 { position:fixed; inset:0 auto auto 0; z-index:1001; display:block; width:100%; height:0; pointer-events:none; }
  .moru-cart-drawer-v2__backdrop { position:fixed; inset:0; background:rgb(0 0 0 / .35); opacity:0; visibility:hidden; transition:opacity 250ms ease,visibility 250ms ease; }
  .moru-cart-drawer-v2__panel { position:fixed; inset:0 0 0 auto; display:flex; flex-direction:column; width:min(440px,94vw); height:100vh; height:100dvh; background:var(--color-bg); box-shadow:-10px 0 30px rgb(0 0 0 / .08); transform:translateX(100%); transition:transform 320ms cubic-bezier(.16,1,.3,1); }
  .moru-cart-drawer-v2.is-open { pointer-events:auto; }.moru-cart-drawer-v2.is-open .moru-cart-drawer-v2__backdrop { opacity:1; visibility:visible; }.moru-cart-drawer-v2.is-open .moru-cart-drawer-v2__panel { transform:translateX(0); }.moru-cart-drawer-v2.is-busy .moru-cart-drawer-v2__body { opacity:.5; pointer-events:none; }
  .moru-cart-drawer-v2__head { display:flex; align-items:center; justify-content:space-between; gap:var(--space-md); padding:var(--space-md); border-bottom:1px solid var(--color-border); }.moru-cart-drawer-v2__title { display:flex; align-items:baseline; gap:var(--space-xs); margin:0; font-size:var(--font-size-lg); }.moru-cart-drawer-v2__title span { font-family:var(--font-body--family); font-size:var(--font-size-xs); font-weight:400; color:var(--color-muted); }.moru-cart-drawer-v2__close { display:flex; padding:var(--space-2xs); border:0; background:none; color:var(--color-text); cursor:pointer; }
  .moru-cart-drawer-v2__body { flex:1; overflow-y:auto; padding:var(--space-md); transition:opacity 180ms ease; }.moru-cart-drawer-v2__empty { display:flex; flex-direction:column; align-items:center; gap:var(--space-md); padding-block:var(--space-2xl); color:var(--color-muted); text-align:center; }.moru-cart-drawer-v2__items { display:flex; flex-direction:column; gap:var(--space-md); margin:0; padding:0; list-style:none; }.moru-cart-drawer-v2__item { display:grid; grid-template-columns:72px 1fr auto; gap:var(--space-sm); padding-bottom:var(--space-md); border-bottom:1px solid var(--color-border); }.moru-cart-drawer-v2__item.has-discount { border-bottom-color:color-mix(in srgb,var(--color-accent-terracotta) 35%,var(--color-border)); }.moru-cart-drawer-v2__media { display:block; overflow:hidden; border-radius:var(--radius-card); background:var(--color-bg-alt); }.moru-cart-drawer-v2__media img,.moru-cart-drawer-v2__media svg { width:100%; aspect-ratio:1; object-fit:cover; }
  .moru-cart-drawer-v2__item-body { display:flex; flex-direction:column; gap:4px; min-width:0; }.moru-cart-drawer-v2__item-title { color:var(--color-text); font-size:var(--font-size-sm); line-height:1.55; text-decoration:none; }.moru-cart-drawer-v2__variant { margin:0; color:var(--color-muted); font-size:var(--font-size-xs); }.moru-cart-drawer-v2__line-discounts { display:flex; flex-direction:column; gap:2px; margin:2px 0 0; padding:0; color:var(--color-accent-terracotta); font-size:var(--font-size-xs); list-style:none; }.moru-cart-drawer-v2__line-discounts li { display:flex; flex-wrap:wrap; gap:4px; }.moru-cart-drawer-v2__line-discounts strong { font-weight:700; }.moru-cart-drawer-v2__saved { display:inline-flex; align-self:flex-start; margin:1px 0 0; padding:2px 6px; border-radius:999px; background:color-mix(in srgb,var(--color-accent-terracotta) 10%,transparent); color:var(--color-accent-terracotta); font-size:11px; font-weight:700; }.moru-cart-drawer-v2__controls { display:flex; align-items:center; gap:var(--space-md); margin-top:var(--space-2xs); }.moru-cart-drawer-v2__stepper { display:flex; align-items:center; border:1px solid var(--color-border); }.moru-cart-drawer-v2__stepper button { width:28px; height:28px; border:0; background:none; color:var(--color-text); cursor:pointer; }.moru-cart-drawer-v2__stepper span { min-width:24px; font-size:var(--font-size-xs); text-align:center; }.moru-cart-drawer-v2__remove { border:0; background:none; color:var(--color-muted); font:inherit; font-size:var(--font-size-xs); text-decoration:underline; cursor:pointer; }.moru-cart-drawer-v2__price { display:flex; flex-direction:column; align-items:flex-end; gap:2px; font-size:var(--font-size-sm); white-space:nowrap; }.moru-cart-drawer-v2__price s { color:var(--color-muted); font-size:var(--font-size-xs); }.moru-cart-drawer-v2__final-price { color:var(--color-accent-terracotta); font-size:var(--font-size-sm); }.moru-cart-drawer-v2__discount-badge { color:var(--color-accent-terracotta); font-size:11px; font-weight:700; }
  .moru-cart-drawer-v2__upsell { margin-top:var(--space-lg); padding:var(--space-md); border:1px solid var(--color-border); border-radius:var(--radius-card); background:var(--color-bg-alt); }.moru-cart-drawer-v2__upsell-eyebrow { margin:0 0 6px; color:var(--color-accent-blue); font-size:10px; font-weight:700; letter-spacing:.16em; }.moru-cart-drawer-v2__upsell-title { margin:0; color:var(--color-text); font-size:var(--font-size-sm); font-weight:700; }.moru-cart-drawer-v2__upsell-copy { margin:6px 0 12px; color:var(--color-muted); font-size:var(--font-size-xs); line-height:1.7; }.moru-cart-drawer-v2__upsell a { color:var(--color-text); font-size:var(--font-size-xs); font-weight:600; text-decoration:none; }.moru-cart-drawer-v2__upsell a:hover { color:var(--color-accent-blue); }
  .moru-cart-drawer-v2__foot { padding:var(--space-md); border-top:1px solid var(--color-border); background:var(--color-bg); }.moru-cart-drawer-v2__discounts { margin:0 0 var(--space-xs); padding:0; color:var(--color-accent-terracotta); font-size:var(--font-size-sm); font-weight:600; list-style:none; }.moru-cart-drawer-v2__discounts li,.moru-cart-drawer-v2__summary-row,.moru-cart-drawer-v2__subtotal { display:flex; justify-content:space-between; gap:var(--space-md); }.moru-cart-drawer-v2__summary-row { align-items:baseline; margin-bottom:5px; color:var(--color-muted); font-size:var(--font-size-sm); }.moru-cart-drawer-v2__summary-row--discount { color:var(--color-accent-terracotta); }.moru-cart-drawer-v2__subtotal { align-items:baseline; font-size:var(--font-size-sm); }.moru-cart-drawer-v2__subtotal strong { font-size:var(--font-size-lg); }.moru-cart-drawer-v2__subtotal--discounted strong { color:var(--color-accent-terracotta); font-size:calc(var(--font-size-lg) * 1.08); }.moru-cart-drawer-v2__total-saved { margin:5px 0 0; color:var(--color-accent-terracotta); font-size:var(--font-size-xs); font-weight:700; text-align:right; }.moru-cart-drawer-v2__codes-link { display:inline-block; margin:0 0 var(--space-xs); color:var(--color-muted); font-size:var(--font-size-xs); text-decoration:underline; }.moru-cart-drawer-v2__codes-link:hover { color:var(--color-text); }.moru-cart-drawer-v2__note { margin:6px 0 0; color:var(--color-muted); font-size:10.5px; line-height:1.6; }.moru-cart-drawer-v2__actions { display:grid; grid-template-columns:1fr 1fr; gap:var(--space-xs); margin-top:var(--space-md); }@media(max-width:480px) { .moru-cart-drawer-v2__actions { grid-template-columns:1fr; } }
{% endstylesheet %}

{% javascript %}
  class MoruCartDrawerV2 extends HTMLElement {
    connectedCallback() {
      this.sectionId = this.dataset.sectionId; this.opener = null;
      this.addEventListener('click', (event) => { if (event.target.closest('[data-drawer-close]') || event.target.closest('[data-drawer-backdrop]')) { this.close(); return; } const minus=event.target.closest('[data-drawer-minus]'); const plus=event.target.closest('[data-drawer-plus]'); const remove=event.target.closest('[data-drawer-remove]'); if(!minus&&!plus&&!remove)return; const item=(minus||plus||remove).closest('[data-line]'); if(!item)return; if(remove){this.change(item.dataset.line,0);return;} const current=parseInt(item.querySelector('[data-drawer-qty]').textContent,10)||0; this.change(item.dataset.line,Math.max(0,current+(plus?1:-1))); });
      document.addEventListener('click',(event)=>{const toggle=event.target.closest('[data-cart-drawer-toggle]');if(!toggle||this.dataset.pageType==='cart')return;event.preventDefault();this.open(toggle);});
      document.addEventListener('keydown',(event)=>{if(event.key==='Escape'&&this.classList.contains('is-open'))this.close();});
      if(this.dataset.interceptAdd==='true'&&this.dataset.pageType!=='cart')document.addEventListener('submit',(event)=>this.onProductSubmit(event));
    }
    get rootUrl(){return(window.Shopify&&window.Shopify.routes&&window.Shopify.routes.root)||'/';}
    open(opener){if(opener)this.opener=opener;this.classList.add('is-open');this.setAttribute('aria-hidden','false');document.body.style.overflow='hidden';window.setTimeout(()=>this.querySelector('[data-drawer-close]')?.focus(),100);}
    close(){this.classList.remove('is-open');this.setAttribute('aria-hidden','true');document.body.style.overflow='';this.opener?.focus?.();}
    async onProductSubmit(event){if(event.defaultPrevented)return;const form=event.target.closest('form');if(!form||!(form.getAttribute('action')||'').includes('/cart/add'))return;event.preventDefault();const button=form.querySelector('[type="submit"]');if(button)button.disabled=true;try{const response=await fetch(this.rootUrl+'cart/add.js',{method:'POST',headers:{Accept:'application/json'},body:new FormData(form)});if(!response.ok)throw new Error('add failed');await this.refresh();this.open();}catch(error){form.submit();}finally{if(button)button.disabled=false;}}
    async change(line,quantity){this.classList.add('is-busy');try{const response=await fetch(this.rootUrl+'cart/change.js',{method:'POST',headers:{'Content-Type':'application/json',Accept:'application/json'},body:JSON.stringify({line:Number(line),quantity})});if(!response.ok)throw new Error('change failed');await this.refresh();}catch(error){window.location.reload();}finally{this.classList.remove('is-busy');}}
    async refresh(){const response=await fetch(window.location.pathname+'?section_id='+this.sectionId);const parsed=new DOMParser().parseFromString(await response.text(),'text/html');const next=parsed.querySelector('[data-cart-drawer]');if(!next){window.location.reload();return;}const wasOpen=this.classList.contains('is-open');this.innerHTML=next.innerHTML;if(wasOpen)this.classList.add('is-open');await this.syncBadge();document.dispatchEvent(new CustomEvent('moru:cart:updated'));}
    async syncBadge(){try{const response=await fetch(this.rootUrl+'cart.js',{headers:{Accept:'application/json'}});const cart=await response.json();document.querySelectorAll('[data-cart-count]').forEach((badge)=>{badge.textContent=cart.item_count;});}catch(error){}}
  }
  if(!customElements.get('moru-cart-drawer-v2'))customElements.define('moru-cart-drawer-v2',MoruCartDrawerV2);
{% endjavascript %}

{% schema %}
{"name":"MORU Cart Drawer v2","settings":[{"type":"checkbox","id":"open_on_add","label":"商品追加時に開く","default":true}],"enabled_on":{"groups":["header"]},"presets":[{"name":"MORU Cart Drawer v2"}]}
{% endschema %}