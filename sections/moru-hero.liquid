<div class="moru-hero full-width">
  <div class="moru-hero__media">
    {% if section.settings.image %}
      {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '750, 1200, 1800, 2400', sizes: '100vw' }}
    {% else %}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'moru-hero__placeholder' }}
    {% endif %}
  </div>

  <div class="moru-hero__overlay">
    <div class="moru-hero__content">
      <h1 class="moru-hero__title">{{ section.settings.title }}</h1>
      {% if section.settings.subtitle != blank %}
        <p class="moru-hero__subtitle">{{ section.settings.subtitle }}</p>
      {% endif %}
      {% if section.settings.button_label != blank %}
        <a class="moru-hero__button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
          {{ section.settings.button_label }}
        </a>
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  .moru-hero {
    position: relative;
    height: 520px;
    overflow: hidden;
    background-color: var(--color-bg-alt);
  }

  @media (max-width: 749px) {
    .moru-hero {
      height: 420px;
    }
  }

  .moru-hero__media,
  .moru-hero__media img,
  .moru-hero__media svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
  }

  .moru-hero__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    background: linear-gradient(to right, rgb(0 0 0 / 0.4) 0%, rgb(0 0 0 / 0.15) 50%, rgb(0 0 0 / 0) 100%);
  }

  .moru-hero__content {
    max-width: 34rem;
    padding-inline: clamp(var(--page-margin), 6vw, 5rem);
    color: #fff;
    text-shadow: 0 2px 10px rgb(0 0 0 / 0.15);
  }

  .moru-hero__title {
    margin: 0;
    color: #fff;
    font-size: var(--font-size-2xl);
    line-height: 1.45;
    letter-spacing: var(--letter-spacing-wide);
  }

  .moru-hero__subtitle {
    margin-block: var(--space-md) 0;
    font-size: var(--font-size-sm);
    letter-spacing: var(--letter-spacing-wide);
    color: rgb(255 255 255 / 0.9);
  }

  .moru-hero__button {
    display: inline-block;
    margin-block-start: var(--space-lg);
    padding: var(--space-sm) var(--space-lg);
    border: 1px solid rgb(255 255 255 / 0.85);
    border-radius: var(--style-border-radius-inputs);
    background: rgb(255 255 255 / 0.12);
    backdrop-filter: blur(6px);
    color: #fff;
    font-size: var(--font-size-sm);
    letter-spacing: var(--letter-spacing-wide);
    text-decoration: none;
    transition: background-color 300ms ease, color 300ms ease;
  }

  .moru-hero__button:hover {
    background-color: #fff;
    color: var(--color-text);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:moru.hero.name",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:moru.hero.image_label"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:moru.common.title",
      "default": "t:moru.hero.title_default"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "t:moru.hero.subtitle_label",
      "default": "t:moru.hero.subtitle_default"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:moru.common.button_label",
      "default": "t:moru.hero.button_label_default"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:moru.common.button_link"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "presets": [
    {
      "name": "t:moru.hero.name"
    }
  ]
}
{% endschema %}
