{% liquid
  assign fade_strength = section.settings.fade_strength | default: 85
  assign fade_opacity = fade_strength | times: 0.01
  assign fade_strength_sp = section.settings.fade_strength_sp | default: fade_strength
  assign fade_opacity_sp = fade_strength_sp | times: 0.01
%}

{% liquid
  assign frame_ratio = section.settings.frame_ratio | default: '12 / 5'
  assign frame_ratio_sp = section.settings.frame_ratio_mobile | default: '4 / 5'
%}
<moru-hero-slideshow
  class="moru-hero full-width{% unless frame_ratio == 'legacy' %} moru-hero--ratio{% endunless %}"
  data-interval="{{ section.settings.autoplay_interval | times: 1000 }}"
  aria-roledescription="carousel"
  style="--moru-hero-text-color: {{ section.settings.text_color | default: '#2E2E2E' }}; --moru-hero-fade-opacity: {{ fade_opacity }}; --moru-hero-fade-opacity-sp: {{ fade_opacity_sp }};{% unless frame_ratio == 'legacy' %} --moru-hero-ratio-pc: {{ frame_ratio }};{% endunless %} --moru-hero-ratio-sp: {{ frame_ratio_sp }};"
>
  <div class="moru-hero__slides">
    {% for block in section.blocks %}
      <div
        class="moru-hero__slide{% if forloop.first %} is-active{% endif %}"
        data-slide-index="{{ forloop.index0 }}"
        data-desktop-position="{{ block.settings.desktop_content_position }}"
        data-mobile-position="{{ block.settings.mobile_content_position }}"
        {% if block.settings.sp_hide_subtitle %}data-sp-hide-subtitle{% endif %}
        style="--moru-copy-ox-pc: {{ block.settings.pc_offset_x | default: 0 }}%; --moru-copy-oy-pc: {{ block.settings.pc_offset_y | default: 0 }}%; --moru-copy-ox-sp: {{ block.settings.sp_offset_x | default: 0 }}%; --moru-copy-oy-sp: {{ block.settings.sp_offset_y | default: 0 }}%;"
        {{ block.shopify_attributes }}
      >
        <div class="moru-hero__media">
          {% liquid
            assign loading_mode = 'lazy'
            if forloop.first
              assign loading_mode = 'eager'
            endif
            assign ph_variant = forloop.index | modulo: 2
            assign desktop_image = block.settings.image
            assign mobile_image = block.settings.mobile_image
            assign fallback_image = desktop_image
            if fallback_image == blank
              assign fallback_image = mobile_image
            endif
          %}
          {% if fallback_image %}
            <picture class="moru-hero__picture">
              {% if mobile_image %}
                <source media="(max-width: 749px)" srcset="{{ mobile_image | image_url: width: 750 }} 750w, {{ mobile_image | image_url: width: 1200 }} 1200w" sizes="100vw">
              {% endif %}
              {{ fallback_image | image_url: width: 2400 | image_tag: loading: loading_mode, widths: '750, 1200, 1800, 2400', sizes: '100vw' }}
            </picture>
          {% elsif ph_variant == 1 %}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'moru-hero__placeholder' }}
          {% else %}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'moru-hero__placeholder' }}
          {% endif %}
        </div>

        <div class="moru-hero__overlay"></div>

        <div class="moru-hero__content">
          {% if block.settings.title != blank %}<h2 class="moru-hero__title">{{ block.settings.title | newline_to_br }}</h2>{% endif %}
          {% if block.settings.subtitle != blank %}<p class="moru-hero__subtitle">{{ block.settings.subtitle | newline_to_br }}</p>{% endif %}
          {% if block.settings.button_label != blank %}
            <div class="moru-hero__button-wrap">
              <a class="moru-hero__button" href="{{ block.settings.button_link | default: routes.all_products_collection_url }}">{{ block.settings.button_label }}</a>
            </div>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>

  {% if section.blocks.size > 1 %}
    <div class="moru-hero__dots">
      {% for block in section.blocks %}
        <button type="button" class="moru-hero__dot{% if forloop.first %} is-active{% endif %}" data-dot-index="{{ forloop.index0 }}" aria-label="{{ 'moru.hero.go_to_slide' | t: index: forloop.index }}"></button>
      {% endfor %}
    </div>
  {% endif %}
</moru-hero-slideshow>

{% stylesheet %}
  .moru-hero { position: relative; display: block; height: 580px; overflow: hidden; background-color: var(--color-bg-alt); }
  .moru-hero__slides { position: relative; width: 100%; height: 100%; }
  .moru-hero__slide { position: absolute; inset: 0; opacity: 0; visibility: hidden; transition: opacity 800ms cubic-bezier(0.4,0,0.2,1), visibility 800ms; z-index: 1; }
  .moru-hero__slide.is-active { opacity: 1; visibility: visible; z-index: 2; }
  .moru-hero__media, .moru-hero__picture, .moru-hero__picture img, .moru-hero__media svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .moru-hero__picture { display: block; }
  .moru-hero__picture img, .moru-hero__media svg { object-fit: cover; object-position: center 35%; }
  .moru-hero__media img { transform: scale(1.015); transition: transform 7s cubic-bezier(0.1,1,0.1,1); }
  .moru-hero__slide.is-active .moru-hero__media img { transform: scale(1); }

  .moru-hero__overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: var(--moru-hero-fade-opacity, 0.85);
    background: linear-gradient(90deg, rgb(255 255 255 / 0.96) 0%, rgb(255 255 255 / 0.76) 23%, rgb(255 255 255 / 0.30) 42%, transparent 62%);
  }

  .moru-hero__content { position: absolute; inset: 0; z-index: 3; display: flex; flex-direction: column; padding: var(--space-2xl) clamp(var(--page-margin), 6vw, 4.5rem) 4rem; transform: translate(var(--moru-copy-ox-pc, 0%), var(--moru-copy-oy-pc, 0%)); }
  /* content は inset:0 でヒーローと同サイズなので、transform の % =
     ヒーローに対する % になる。X/Y微調整はプリセット位置からのずらし量 */
  .moru-hero__title, .moru-hero__subtitle, .moru-hero__button-wrap { width: min(48rem, 52vw); }
  .moru-hero__title, .moru-hero__subtitle { background: transparent; }
  .moru-hero__title { margin: 0; font-size: var(--font-size-3xl); font-weight: 700; line-height: 1.5; letter-spacing: 0.02em; color: var(--moru-hero-text-color, var(--color-text)); transform: translateY(20px); opacity: 0; transition: all 600ms cubic-bezier(0.25,1,0.5,1) 150ms; }
  .moru-hero__subtitle { margin: var(--space-md) 0 0; font-size: var(--font-size-md); line-height: 1.85; letter-spacing: 0.02em; color: color-mix(in srgb, var(--moru-hero-text-color, #2e2e2e) 78%, transparent); transform: translateY(20px); opacity: 0; transition: all 600ms cubic-bezier(0.25,1,0.5,1) 250ms; }
  .moru-hero__button-wrap { margin-block-start: var(--space-xl); transform: translateY(20px); opacity: 0; transition: all 600ms cubic-bezier(0.25,1,0.5,1) 350ms; }
  .moru-hero__slide.is-active .moru-hero__title, .moru-hero__slide.is-active .moru-hero__subtitle, .moru-hero__slide.is-active .moru-hero__button-wrap { transform: translateY(0); opacity: 1; }
  .moru-hero__button { display: inline-block; padding: var(--space-sm) var(--space-lg); border: 1px solid var(--color-text); border-radius: var(--style-border-radius-inputs); background-color: rgb(255 255 255 / 0.52); backdrop-filter: blur(4px); color: var(--color-text); font-size: var(--font-size-sm); letter-spacing: var(--letter-spacing-wide); text-decoration: none; transition: background-color 300ms ease,color 300ms ease,box-shadow 300ms ease; }
  .moru-hero__button:hover { background-color: var(--color-text); color: var(--color-bg); box-shadow: 0 4px 14px rgb(0 0 0 / 0.2); }

  .moru-hero__slide[data-desktop-position^='top_'] .moru-hero__content { justify-content: flex-start; }
  .moru-hero__slide[data-desktop-position^='middle_'] .moru-hero__content { justify-content: center; }
  .moru-hero__slide[data-desktop-position^='bottom_'] .moru-hero__content { justify-content: flex-end; }
  .moru-hero__slide[data-desktop-position$='_left'] .moru-hero__content { align-items: flex-start; text-align: left; }
  .moru-hero__slide[data-desktop-position$='_center'] .moru-hero__content { align-items: center; text-align: center; }
  .moru-hero__slide[data-desktop-position$='_right'] .moru-hero__content { align-items: flex-end; text-align: right; }
  .moru-hero__slide[data-desktop-position$='_right'] .moru-hero__overlay { background: linear-gradient(270deg, rgb(255 255 255 / 0.96) 0%, rgb(255 255 255 / 0.76) 23%, rgb(255 255 255 / 0.30) 42%, transparent 62%); }
  .moru-hero__slide[data-desktop-position$='_center'] .moru-hero__overlay { background: linear-gradient(90deg, transparent 15%, rgb(255 255 255 / 0.14) 32%, rgb(255 255 255 / 0.72) 50%, rgb(255 255 255 / 0.14) 68%, transparent 85%); }

  .moru-hero__dots { position: absolute; bottom: 22px; left: 50%; transform: translateX(-50%); display: flex; gap: 9px; z-index: 10; padding: 6px 12px; border-radius: 20px; background: rgb(0 0 0 / 0.08); backdrop-filter: blur(2px); }
  .moru-hero__dot { width: 8px; height: 8px; padding: 0; border: none; border-radius: 50%; background: rgb(255 255 255 / 0.55); cursor: pointer; transition: all 300ms cubic-bezier(0.4,0,0.2,1); }
  .moru-hero__dot.is-active { width: 22px; border-radius: 6px; background: #fff; box-shadow: 0 1px 4px rgb(0 0 0 / 0.25); }

  @media (max-width: 899px) and (min-width: 750px) { .moru-hero { height: 520px; } }
  /* 縦横比モード(既定)。枠を画像と同じ比率にすると object-fit:cover でも
     一切トリミングされず、入れた画像がそのまま全体表示される。
     「従来(580px固定)」を選んだときだけ上の固定高さが生きる。
     スマホ(〜749px)は従来どおり 4:5 固定(下の media が後勝ち)。 */
  @media (min-width: 750px) {
    .moru-hero--ratio { height: auto; aspect-ratio: var(--moru-hero-ratio-pc, 12 / 5); }
    .moru-hero--ratio .moru-hero__picture img, .moru-hero--ratio .moru-hero__media svg { object-position: center center; }
  }
  @media (max-width: 749px) {
    /* スマホの枠。比率はセクション設定(既定4:5)。同じ比率の画像なら切り抜きゼロ */
    .moru-hero { height: auto; aspect-ratio: var(--moru-hero-ratio-sp, 4 / 5); }
    .moru-hero__picture img, .moru-hero__media svg { object-position: center center; }
    .moru-hero__content { padding: 1.75rem var(--page-margin) 4.25rem; transform: translate(var(--moru-copy-ox-sp, 0%), var(--moru-copy-oy-sp, 0%)); }
    .moru-hero__title, .moru-hero__subtitle, .moru-hero__button-wrap { width: min(100%, 30rem); }
    .moru-hero__slide[data-mobile-position^='top_'] .moru-hero__content { justify-content: flex-start; }
    .moru-hero__slide[data-mobile-position^='middle_'] .moru-hero__content { justify-content: center; }
    .moru-hero__slide[data-mobile-position^='bottom_'] .moru-hero__content { justify-content: flex-end; }
    .moru-hero__slide[data-mobile-position$='_left'] .moru-hero__content { align-items: flex-start; text-align: left; }
    .moru-hero__slide[data-mobile-position$='_center'] .moru-hero__content { align-items: center; text-align: center; }
    .moru-hero__slide[data-mobile-position$='_right'] .moru-hero__content { align-items: flex-end; text-align: right; }
    .moru-hero__slide[data-mobile-position^='bottom_'] .moru-hero__overlay { background: linear-gradient(to bottom, transparent 28%, transparent 48%, rgb(255 255 255 / 0.28) 65%, rgb(255 255 255 / 0.78) 86%, rgb(255 255 255 / 0.96) 100%); }
    .moru-hero__slide[data-mobile-position^='top_'] .moru-hero__overlay { background: linear-gradient(to bottom, rgb(255 255 255 / 0.96) 0%, rgb(255 255 255 / 0.76) 19%, rgb(255 255 255 / 0.26) 38%, transparent 58%); }
    .moru-hero__slide[data-mobile-position^='middle_'] .moru-hero__overlay { background: linear-gradient(to bottom, transparent 18%, rgb(255 255 255 / 0.18) 34%, rgb(255 255 255 / 0.72) 50%, rgb(255 255 255 / 0.18) 66%, transparent 82%); }
    /* スマホはコピーを一回り小さく(コピー塊がヒーローの半分を超えないように) */
    .moru-hero__title { font-size: clamp(1.4rem, 5.6vw, 1.8rem); line-height: 1.4; }
    .moru-hero__button-wrap { margin-block-start: var(--space-sm); }
    /* スマホは箱型ボタンではなく下線付きテキストリンク(Owner 指定・2026-08-29)。
       箱をやめて写真の見せ場を隠さない。PC は従来のボタンのまま */
    .moru-hero__button {
      padding: 0;
      border: none;
      border-radius: 0;
      background: transparent;
      backdrop-filter: none;
      font-size: var(--font-size-xs);
      font-weight: 600;
      letter-spacing: 0.04em;
      text-decoration: underline;
      text-underline-offset: 0.45em;
      text-decoration-thickness: 1px;
    }
    .moru-hero__button::after { content: '\203A'; margin-inline-start: 0.4em; display: inline-block; text-decoration: none; }
    .moru-hero__button:hover, .moru-hero__button:active {
      background: transparent;
      color: var(--moru-hero-text-color, var(--color-text));
      box-shadow: none;
    }
    .moru-hero__slide[data-sp-hide-subtitle] .moru-hero__subtitle { display: none; }
    /* スマホは白フェードの強さを別スライダーで制御(未設定時はPCの値に追従) */
    .moru-hero__overlay { opacity: var(--moru-hero-fade-opacity-sp, var(--moru-hero-fade-opacity, 0.85)); }
    .moru-hero__subtitle { margin-block-start: var(--space-xs); font-size: var(--font-size-xs); line-height: 1.7; }
    .moru-hero__button-wrap { margin-block-start: var(--space-md); }
  }
{% endstylesheet %}

{% javascript %}
  class MoruHeroSlideshow extends HTMLElement {
    connectedCallback() {
      this.slides = Array.from(this.querySelectorAll('.moru-hero__slide'));
      this.dots = Array.from(this.querySelectorAll('.moru-hero__dot'));
      this.current = 0;
      this.timer = null;
      this.interval = parseInt(this.dataset.interval, 10) || 6000;
      this.reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (this.slides.length < 2) return;
      this.dots.forEach((dot) => dot.addEventListener('click', () => { this.goTo(parseInt(dot.dataset.dotIndex, 10)); this.restart(); }));
      this.addEventListener('mouseenter', () => this.stop());
      this.addEventListener('mouseleave', () => this.start());
      this.touchStartX = 0;
      this.addEventListener('touchstart', (e) => { this.touchStartX = e.changedTouches[0].screenX; }, { passive: true });
      this.addEventListener('touchend', (e) => {
        const delta = e.changedTouches[0].screenX - this.touchStartX;
        if (Math.abs(delta) > 45) { this.goTo(this.current + (delta < 0 ? 1 : -1)); this.restart(); }
      }, { passive: true });
      this.start();
    }
    disconnectedCallback() { this.stop(); }
    goTo(index) {
      const total = this.slides.length;
      const next = (index + total) % total;
      if (next === this.current) return;
      this.slides[this.current].classList.remove('is-active');
      this.dots[this.current].classList.remove('is-active');
      this.current = next;
      this.slides[this.current].classList.add('is-active');
      this.dots[this.current].classList.add('is-active');
    }
    start() { if (this.reducedMotion) return; this.stop(); this.timer = setInterval(() => this.goTo(this.current + 1), this.interval); }
    stop() { if (this.timer) { clearInterval(this.timer); this.timer = null; } }
    restart() { this.stop(); this.start(); }
  }
  if (!customElements.get('moru-hero-slideshow')) customElements.define('moru-hero-slideshow', MoruHeroSlideshow);
{% endjavascript %}

{% schema %}
{
  "name": "t:moru.hero.name",
  "settings": [
    {
      "type": "select", "id": "frame_ratio", "label": "PCの枠の縦横比",
      "info": "画像をこの比率で作ると切り抜きゼロで全体表示されます。高さは画面幅に比例します",
      "default": "12 / 5",
      "options": [
        { "value": "12 / 5", "label": "12:5（2400×1000）おすすめ" },
        { "value": "16 / 9", "label": "16:9（2400×1350）" },
        { "value": "3 / 1", "label": "3:1（2400×800）" },
        { "value": "legacy", "label": "従来（高さ580px固定・画面幅により切り抜き）" }
      ]
    },
    {
      "type": "select", "id": "frame_ratio_mobile", "label": "スマホの枠の縦横比",
      "info": "画像をこの比率で作ると切り抜きゼロで全体表示されます。横長にするほどコピー・ボタンの置き場が狭くなります",
      "default": "4 / 5",
      "options": [
        { "value": "4 / 5", "label": "4:5（1200×1500）縦長・従来" },
        { "value": "1 / 1", "label": "1:1（1200×1200）" },
        { "value": "4 / 3", "label": "4:3（1600×1200）" },
        { "value": "16 / 9", "label": "16:9（1600×900）横長" }
      ]
    },
    { "type": "range", "id": "autoplay_interval", "min": 4, "max": 10, "step": 1, "unit": "s", "label": "t:moru.hero.autoplay_interval_label", "default": 6 },
    { "type": "color", "id": "text_color", "label": "テキスト色", "default": "#2E2E2E" },
    { "type": "range", "id": "fade_strength", "min": 0, "max": 100, "step": 5, "unit": "%", "label": "白フェードの強さ（PC）", "default": 85 },
    { "type": "range", "id": "fade_strength_sp", "min": 0, "max": 100, "step": 5, "unit": "%", "label": "白フェードの強さ（スマホ）", "info": "0で完全になし。文字が読みにくくならない範囲で下げてください", "default": 85 }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "t:moru.hero.block_slide_name",
      "limit": 5,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "PC画像（推奨 2400×1000px）", "info": "下の「PCの枠の縦横比」と同じ比率で作ると、トリミングなしで画像全体がそのまま表示されます（既定は12:5 = 2400×1000）。比率が違う画像は中央基準で切り抜かれます。" },
        { "type": "image_picker", "id": "mobile_image", "label": "スマホ画像", "info": "「スマホの枠の縦横比」と同じ比率で作ると、トリミングなしで全体が表示されます（既定は4:5 = 1200×1500）。未設定の場合はPC画像を中央基準で切り抜いて使用します。" },
        {
          "type": "select", "id": "desktop_content_position", "label": "PC：タイトル・説明・ボタンの位置", "default": "middle_left",
          "options": [
            { "value": "top_left", "label": "左上" }, { "value": "top_center", "label": "中央上" }, { "value": "top_right", "label": "右上" },
            { "value": "middle_left", "label": "左中央" }, { "value": "middle_center", "label": "中央" }, { "value": "middle_right", "label": "右中央" },
            { "value": "bottom_left", "label": "左下" }, { "value": "bottom_center", "label": "中央下" }, { "value": "bottom_right", "label": "右下" }
          ]
        },
        {
          "type": "select", "id": "mobile_content_position", "label": "スマホ：タイトル・説明・ボタンの位置", "info": "スマホは「左下」がおすすめです。4:5画像の上側を見せつつ、下側にコピーとボタンを置きやすくなります。", "default": "bottom_left",
          "options": [
            { "value": "top_left", "label": "左上" }, { "value": "top_center", "label": "中央上" }, { "value": "top_right", "label": "右上" },
            { "value": "middle_left", "label": "左中央" }, { "value": "middle_center", "label": "中央" }, { "value": "middle_right", "label": "右中央" },
            { "value": "bottom_left", "label": "左下" }, { "value": "bottom_center", "label": "中央下" }, { "value": "bottom_right", "label": "右下" }
          ]
        },
        { "type": "range", "id": "pc_offset_x", "label": "PC：横の微調整", "info": "プリセット位置からのずらし量。マイナスで左、プラスで右", "min": -40, "max": 40, "step": 1, "unit": "%", "default": 0 },
        { "type": "range", "id": "pc_offset_y", "label": "PC：縦の微調整", "info": "マイナスで上、プラスで下", "min": -40, "max": 40, "step": 1, "unit": "%", "default": 0 },
        { "type": "range", "id": "sp_offset_x", "label": "スマホ：横の微調整", "info": "白フェードもコピーに追従します", "min": -40, "max": 40, "step": 1, "unit": "%", "default": 0 },
        { "type": "range", "id": "sp_offset_y", "label": "スマホ：縦の微調整", "info": "白フェードもコピーに追従します", "min": -40, "max": 40, "step": 1, "unit": "%", "default": 0 },
        { "type": "checkbox", "id": "sp_hide_subtitle", "label": "スマホ：サブコピーを非表示", "info": "PCでは表示したまま、スマホだけ見出しとボタンにできます", "default": false },
        { "type": "textarea", "id": "title", "label": "t:moru.common.title", "default": "t:moru.hero.title_default" },
        { "type": "textarea", "id": "subtitle", "label": "t:moru.hero.subtitle_label", "default": "t:moru.hero.subtitle_default" },
        { "type": "text", "id": "button_label", "label": "t:moru.common.button_label", "default": "t:moru.hero.button_label_default" },
        { "type": "url", "id": "button_link", "label": "t:moru.common.button_link" }
      ]
    }
  ],
  "max_blocks": 5,
  "disabled_on": { "groups": ["header", "footer"] },
  "presets": [{ "name": "t:moru.hero.name", "blocks": [{ "type": "slide" }, { "type": "slide" }, { "type": "slide" }] }]
}
{% endschema %}
