<div
  class="moru-categories moru-categories--{{ section.settings.shape }}{% if section.settings.background == 'alt' %} moru-categories--boxed{% endif %}"
  style="--moru-cat-columns: {{ section.settings.columns }};"
>
  <div class="moru-section-header">
    <h2>{{ section.settings.title }}</h2>
    {% if section.settings.view_all_link != blank %}
      <a class="moru-section-header__link" href="{{ section.settings.view_all_link }}">{{ section.settings.view_all_label }} &rarr;</a>
    {% endif %}
  </div>

  <ul class="moru-categories__circles" role="list">
    {% for block in section.blocks %}
      <li class="moru-categories__circle-item" {{ block.shopify_attributes }}>
        {% liquid
          assign circle_url = '#'
          if block.settings.collection != blank
            assign circle_url = block.settings.collection.url
          endif
        %}
        <a href="{{ circle_url }}" class="moru-categories__circle-link">
          <span class="moru-categories__circle">
            <span class="moru-categories__circle-inner">
              {% if block.settings.image %}
                {{ block.settings.image | image_url: width: 240, height: 240, crop: 'center' | image_tag: loading: 'lazy' }}
              {% else %}
                {{ 'collection-1' | placeholder_svg_tag }}
              {% endif %}
            </span>
          </span>
          <span class="moru-categories__label">
            {%- if block.settings.label != blank -%}
              {{ block.settings.label }}
            {%- else -%}
              {{ 'moru.placeholder.category' | t }}
            {%- endif -%}
          </span>
        </a>
      </li>
    {% endfor %}
  </ul>
</div>

{% stylesheet %}
  .moru-categories {
    padding-block: var(--space-2xl) var(--space-xl);
  }

  .moru-categories__circles {
    display: grid;
    grid-template-columns: repeat(var(--moru-cat-columns, 8), minmax(0, 1fr));
    gap: var(--space-md);
    margin: 0;
    padding: 0;
    list-style: none;
    text-align: center;
  }

  .moru-categories__circle-item {
    display: flex;
    justify-content: center;
  }

  .moru-categories__circle-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
    color: var(--color-text);
    text-decoration: none;
    font-size: var(--font-size-sm);
  }

  .moru-categories__circle {
    display: block;
    width: 6.875rem;
    height: 6.875rem;
    padding: var(--space-2xs);
    border-radius: 50%;
    border: 1px solid var(--color-border);
    background-color: var(--color-bg-alt);
    transition: transform 300ms ease, border-color 300ms ease;
  }

  .moru-categories__circle-inner {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    overflow: hidden;
  }

  .moru-categories__circle-inner img,
  .moru-categories__circle-inner svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms ease;
  }

  .moru-categories__circle-link:hover .moru-categories__circle {
    transform: translateY(-4px);
    border-color: var(--color-muted);
  }

  .moru-categories__circle-link:hover .moru-categories__circle-inner img {
    transform: scale(1.08);
  }

  /*
   * 参考デザインは、クリーム地の枠の中に白い正方形カードが並ぶ形。
   * 丸("circle")も設定から選べるよう、どちらも同じマークアップで出し分ける。
   */
  .moru-categories--boxed {
    padding: var(--space-lg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background-color: var(--color-bg-alt);
  }

  .moru-categories--square .moru-categories__circle-item {
    display: block;
  }

  .moru-categories--square .moru-categories__circle-link {
    gap: var(--space-xs);
  }

  .moru-categories--square .moru-categories__circle {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    padding: var(--space-xs);
    border-radius: var(--radius-card);
    background-color: var(--color-surface);
  }

  .moru-categories--square .moru-categories__circle-inner {
    border-radius: 0;
  }

  .moru-categories--square .moru-categories__circle-inner img,
  .moru-categories--square .moru-categories__circle-inner svg {
    object-fit: contain;
  }

  .moru-categories--square .moru-categories__label {
    font-size: var(--font-size-xs);
  }

  @media (max-width: 1024px) {
    .moru-categories__circles {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (max-width: 749px) {
    .moru-categories__circles {
      gap: var(--space-xs);
    }

    .moru-categories--circle .moru-categories__circle {
      width: 4.25rem;
      height: 4.25rem;
    }

    .moru-categories--boxed {
      padding: var(--space-md);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .moru-categories__circle,
    .moru-categories__circle-inner img {
      transition: none;
    }

    .moru-categories__circle-link:hover .moru-categories__circle {
      transform: none;
    }

    .moru-categories__circle-link:hover .moru-categories__circle-inner img {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:moru.category_browser.name",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:moru.common.title",
      "default": "t:moru.category_browser.title_default"
    },
    {
      "type": "select",
      "id": "shape",
      "label": "t:moru.category_browser.shape_label",
      "options": [
        { "value": "square", "label": "t:moru.category_browser.shape_square" },
        { "value": "circle", "label": "t:moru.category_browser.shape_circle" }
      ],
      "default": "square"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 4,
      "max": 8,
      "step": 1,
      "label": "t:moru.category_browser.columns_label",
      "default": 8
    },
    {
      "type": "select",
      "id": "background",
      "label": "t:moru.common.background_label",
      "options": [
        { "value": "alt", "label": "t:moru.usp.bg_alt" },
        { "value": "none", "label": "t:moru.usp.bg_none" }
      ],
      "default": "alt"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "t:moru.category_browser.view_all_link_label"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "t:moru.common.view_all_label",
      "default": "t:moru.common.view_all_default"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "t:moru.category_browser.block_category_name",
      "limit": 10,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:moru.category_browser.block_label_label"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:moru.category_browser.block_image_label"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "t:moru.common.collection"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "presets": [
    {
      "name": "t:moru.category_browser.name",
      "blocks": [
        {
          "type": "category"
        },
        {
          "type": "category"
        },
        {
          "type": "category"
        },
        {
          "type": "category"
        },
        {
          "type": "category"
        }
      ]
    }
  ]
}
{% endschema %}
