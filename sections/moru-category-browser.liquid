<div class="moru-categories">
  <div class="moru-section-header">
    <h2>{{ section.settings.title }}</h2>
    {% if section.settings.view_all_link != blank %}
      <a class="moru-section-header__link" href="{{ section.settings.view_all_link }}">{{ section.settings.view_all_label }} &rarr;</a>
    {% endif %}
  </div>

  <ul class="moru-categories__circles" role="list">
    {% for block in section.blocks %}
      <li class="moru-categories__circle-item" {{ block.shopify_attributes }}>
        {% liquid
          assign circle_url = '#'
          if block.settings.collection != blank
            assign circle_url = block.settings.collection.url
          endif
        %}
        <a href="{{ circle_url }}" class="moru-categories__circle-link">
          <span class="moru-categories__circle">
            <span class="moru-categories__circle-inner">
              {% if block.settings.image %}
                {{ block.settings.image | image_url: width: 240, height: 240, crop: 'center' | image_tag: loading: 'lazy' }}
              {% else %}
                {{ 'collection-1' | placeholder_svg_tag }}
              {% endif %}
            </span>
          </span>
          <span class="moru-categories__label">
            {%- if block.settings.label != blank -%}
              {{ block.settings.label }}
            {%- else -%}
              {{ 'moru.placeholder.category' | t }}
            {%- endif -%}
          </span>
        </a>
      </li>
    {% endfor %}
  </ul>
</div>

{% stylesheet %}
  .moru-categories {
    padding-block: var(--space-2xl) var(--space-xl);
  }

  .moru-categories__circles {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--space-md);
    margin: 0;
    padding: 0;
    list-style: none;
    text-align: center;
  }

  .moru-categories__circle-item {
    display: flex;
    justify-content: center;
  }

  .moru-categories__circle-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
    color: var(--color-text);
    text-decoration: none;
    font-size: var(--font-size-sm);
  }

  .moru-categories__circle {
    display: block;
    width: 6.875rem;
    height: 6.875rem;
    padding: var(--space-2xs);
    border-radius: 50%;
    border: 1px solid var(--color-border);
    background-color: var(--color-bg-alt);
    transition: transform 300ms ease, border-color 300ms ease;
  }

  .moru-categories__circle-inner {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    overflow: hidden;
  }

  .moru-categories__circle-inner img,
  .moru-categories__circle-inner svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms ease;
  }

  .moru-categories__circle-link:hover .moru-categories__circle {
    transform: translateY(-4px);
    border-color: var(--color-muted);
  }

  .moru-categories__circle-link:hover .moru-categories__circle-inner img {
    transform: scale(1.08);
  }

  @media (max-width: 749px) {
    .moru-categories__circles {
      gap: var(--space-xs);
    }

    .moru-categories__circle {
      width: 4.25rem;
      height: 4.25rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:moru.category_browser.name",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:moru.common.title",
      "default": "t:moru.category_browser.title_default"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "t:moru.category_browser.view_all_link_label"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "t:moru.common.view_all_label",
      "default": "t:moru.common.view_all_default"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "t:moru.category_browser.block_category_name",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:moru.category_browser.block_label_label"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:moru.category_browser.block_image_label"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "t:moru.common.collection"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "presets": [
    {
      "name": "t:moru.category_browser.name",
      "blocks": [
        {
          "type": "category"
        },
        {
          "type": "category"
        },
        {
          "type": "category"
        },
        {
          "type": "category"
        },
        {
          "type": "category"
        }
      ]
    }
  ]
}
{% endschema %}
