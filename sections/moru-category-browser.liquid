{% liquid
  assign active_block = section.blocks | first
%}

<div class="moru-categories">
  <div class="moru-section-header">
    <h2>{{ section.settings.title }}</h2>
    {% if active_block and active_block.settings.collection != blank %}
      <a class="moru-section-header__link" href="{{ active_block.settings.collection.url }}">{{ section.settings.view_all_label }} &rarr;</a>
    {% endif %}
  </div>

  <ul class="moru-categories__circles" role="list">
    {% for block in section.blocks %}
      <li class="moru-categories__circle-item" {{ block.shopify_attributes }}>
        {% liquid
          assign circle_url = '#'
          if block.settings.collection != blank
            assign circle_url = block.settings.collection.url
          endif
        %}
        <a href="{{ circle_url }}" class="moru-categories__circle-link{% if forloop.first %} is-active{% endif %}">
          <span class="moru-categories__circle">
            {% if block.settings.image %}
              {{ block.settings.image | image_url: width: 240, height: 240, crop: 'center' | image_tag: loading: 'lazy' }}
            {% else %}
              {{ 'collection-1' | placeholder_svg_tag }}
            {% endif %}
          </span>
          <span class="moru-categories__label">
            {%- if block.settings.label != blank -%}
              {{ block.settings.label }}
            {%- else -%}
              {{ 'moru.placeholder.category' | t }}
            {%- endif -%}
          </span>
        </a>
      </li>
    {% endfor %}
  </ul>

  <ul class="moru-categories__grid" role="list">
    {% if active_block and active_block.settings.collection != blank %}
      {% for product in active_block.settings.collection.products limit: 8 %}
        <li>{% render 'moru-product-card', product: product %}</li>
      {% endfor %}
    {% else %}
      {% for i in (1..8) %}
        <li>{% render 'moru-product-card', ph_index: forloop.index %}</li>
      {% endfor %}
    {% endif %}
  </ul>

  <div class="moru-categories__footer">
    {% if active_block and active_block.settings.collection != blank %}
      <a class="moru-button moru-button--outline" href="{{ active_block.settings.collection.url }}">{{ section.settings.view_all_label }}</a>
    {% else %}
      <p class="moru-categories__hint">{{ 'moru.placeholder.select_collection' | t }}</p>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .moru-categories {
    padding-block: var(--section-padding-block);
  }

  .moru-categories__circles {
    display: flex;
    gap: var(--space-lg);
    margin: 0 0 var(--space-lg);
    padding: 0;
    list-style: none;
    overflow-x: auto;
  }

  .moru-categories__circle-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
    color: var(--color-text);
    text-decoration: none;
    font-size: var(--font-size-sm);
  }

  .moru-categories__circle {
    display: block;
    width: 6rem;
    height: 6rem;
    padding: var(--space-2xs);
    border-radius: 50%;
    border: 1px solid var(--color-border);
    background-color: var(--color-bg-alt);
    transition: transform 300ms ease, border-color 300ms ease;
  }

  .moru-categories__circle-link.is-active .moru-categories__circle {
    border: 2px solid var(--color-wood);
  }

  .moru-categories__circle-link:hover .moru-categories__circle {
    transform: translateY(-4px);
    border-color: var(--color-wood);
  }

  .moru-categories__circle img,
  .moru-categories__circle svg {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
  }

  .moru-categories__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md) var(--space-md);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .moru-categories__footer {
    display: flex;
    justify-content: center;
    margin-block-start: var(--space-lg);
  }

  .moru-categories__hint {
    font-size: var(--font-size-xs);
    opacity: 0.6;
  }

  @media (max-width: 749px) {
    .moru-categories__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:moru.category_browser.name",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:moru.common.title",
      "default": "t:moru.category_browser.title_default"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "t:moru.common.view_all_label",
      "default": "t:moru.common.view_all_default"
    },
    {
      "type": "paragraph",
      "content": "t:moru.category_browser.wireframe_info"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "t:moru.category_browser.block_category_name",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:moru.category_browser.block_label_label"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:moru.category_browser.block_image_label"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "t:moru.common.collection"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "presets": [
    {
      "name": "t:moru.category_browser.name",
      "blocks": [
        {
          "type": "category"
        },
        {
          "type": "category"
        },
        {
          "type": "category"
        },
        {
          "type": "category"
        },
        {
          "type": "category"
        }
      ]
    }
  ]
}
{% endschema %}
