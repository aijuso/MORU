<moru-category-tabs class="moru-category-tabs" data-section-id="{{ section.id }}">
  <div class="moru-category-tabs__inner">
    <div class="moru-section-header">
      <h2>{{ section.settings.title }}</h2>
    </div>

    <div class="moru-category-tabs__tablist-wrap">
      <div class="moru-category-tabs__tablist" role="tablist" aria-label="{{ section.settings.title | escape }}">
        {%- for block in section.blocks -%}
          {%- liquid
            assign category = block.settings.collection
            assign category_label = block.settings.label
            if category_label == blank and category != blank
              assign category_label = category.title
            endif
            assign tab_id = 'moru-category-tab-' | append: section.id | append: '-' | append: block.id
            assign panel_id = 'moru-category-panel-' | append: section.id | append: '-' | append: block.id
          -%}
          <button
            id="{{ tab_id }}"
            class="moru-category-tabs__tab{% if forloop.first %} is-active{% endif %}"
            type="button"
            role="tab"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            aria-controls="{{ panel_id }}"
            tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
            data-moru-category-tab
            data-target="{{ panel_id }}"
            {{ block.shopify_attributes }}
          >
            {{ category_label | default: 'カテゴリー' }}
          </button>
        {%- endfor -%}
      </div>
    </div>

    <div class="moru-category-tabs__panels">
      {%- for block in section.blocks -%}
        {%- liquid
          assign category = block.settings.collection
          assign category_label = block.settings.label
          if category_label == blank and category != blank
            assign category_label = category.title
          endif
          assign tab_id = 'moru-category-tab-' | append: section.id | append: '-' | append: block.id
          assign panel_id = 'moru-category-panel-' | append: section.id | append: '-' | append: block.id
        -%}
        <div
          id="{{ panel_id }}"
          class="moru-category-tabs__panel"
          role="tabpanel"
          aria-labelledby="{{ tab_id }}"
          data-moru-category-panel
          {% unless forloop.first %}hidden{% endunless %}
        >
          <ul
            class="moru-category-tabs__grid"
            role="list"
            style="--moru-category-columns: {{ section.settings.columns }};"
          >
            {%- if category != blank -%}
              {%- for product in category.products limit: section.settings.products_to_show -%}
                <li class="moru-category-tabs__product">
                  {%- render 'moru-product-card', product: product, show_subtitle: false -%}
                </li>
              {%- else -%}
                <li class="moru-category-tabs__empty">現在表示できる商品はありません。</li>
              {%- endfor -%}
            {%- else -%}
              <li class="moru-category-tabs__empty">コレクションを選択してください。</li>
            {%- endif -%}
          </ul>

          {%- if section.settings.show_view_all and category != blank -%}
            <div class="moru-category-tabs__footer">
              <a class="moru-category-tabs__view-all" href="{{ category.url }}">
                {{ category_label }}を{{ section.settings.view_all_label }}
                <svg width="16" height="12" viewBox="0 0 16 12" fill="none" aria-hidden="true" focusable="false">
                  <path d="M10 1L15 6M15 6L10 11M15 6H1" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</moru-category-tabs>

{% stylesheet %}
  .moru-category-tabs {
    display: block;
    padding-block: var(--space-2xl);
  }

  .moru-category-tabs__inner {
    padding: var(--space-lg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-bg-alt);
  }

  .moru-category-tabs__tablist-wrap {
    margin-block-end: var(--space-lg);
    overflow: hidden;
  }

  .moru-category-tabs__tablist {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    min-width: max-content;
    border-bottom: 1px solid var(--color-border);
  }

  .moru-category-tabs__tab {
    position: relative;
    appearance: none;
    padding: 0 0 var(--space-sm);
    border: 0;
    background: transparent;
    color: var(--color-muted);
    font: inherit;
    font-size: var(--font-size-sm);
    font-weight: 500;
    line-height: 1.4;
    white-space: nowrap;
    cursor: pointer;
    transition: color 180ms ease;
  }

  .moru-category-tabs__tab::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    height: 2px;
    background: var(--color-accent-blue);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 180ms ease;
  }

  .moru-category-tabs__tab:hover {
    color: var(--color-accent-terracotta);
  }

  .moru-category-tabs__tab.is-active {
    color: var(--color-text);
  }

  .moru-category-tabs__tab.is-active::after {
    transform: scaleX(1);
  }

  .moru-category-tabs__tab:focus-visible {
    outline: 2px solid var(--color-accent-blue);
    outline-offset: 4px;
  }

  .moru-category-tabs__panel[hidden] {
    display: none;
  }

  .moru-category-tabs__grid {
    display: grid;
    grid-template-columns: repeat(var(--moru-category-columns, 4), minmax(0, 1fr));
    gap: var(--space-lg) var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .moru-category-tabs__product {
    min-width: 0;
  }

  .moru-category-tabs__empty {
    grid-column: 1 / -1;
    padding-block: var(--space-xl);
    color: var(--color-muted);
    font-size: var(--font-size-sm);
    text-align: center;
  }

  .moru-category-tabs__footer {
    display: flex;
    justify-content: center;
    margin-block-start: var(--space-xl);
  }

  .moru-category-tabs__view-all {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding-block: var(--space-xs);
    color: var(--color-text);
    font-size: var(--font-size-sm);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    transition: color 180ms ease;
  }

  .moru-category-tabs__view-all:hover {
    color: var(--color-accent-terracotta);
  }

  @media (max-width: 1023px) {
    .moru-category-tabs__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 749px) {
    .moru-category-tabs {
      padding-block: var(--space-xl);
    }

    .moru-category-tabs__inner {
      padding: var(--space-md);
    }

    .moru-category-tabs__tablist-wrap {
      margin-inline: calc(var(--space-md) * -1);
      padding-inline: var(--space-md);
      overflow-x: auto;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }

    .moru-category-tabs__tablist-wrap::-webkit-scrollbar {
      display: none;
    }

    .moru-category-tabs__tablist {
      gap: var(--space-md);
    }

    .moru-category-tabs__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-md) var(--space-xs);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .moru-category-tabs__tab,
    .moru-category-tabs__tab::after,
    .moru-category-tabs__view-all {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  class MoruCategoryTabs extends HTMLElement {
    connectedCallback() {
      this.tabs = Array.from(this.querySelectorAll('[data-moru-category-tab]'));
      this.panels = Array.from(this.querySelectorAll('[data-moru-category-panel]'));

      this.onClick = this.onClick || this.handleClick.bind(this);
      this.onKeydown = this.onKeydown || this.handleKeydown.bind(this);

      this.addEventListener('click', this.onClick);
      this.addEventListener('keydown', this.onKeydown);
    }

    disconnectedCallback() {
      if (this.onClick) this.removeEventListener('click', this.onClick);
      if (this.onKeydown) this.removeEventListener('keydown', this.onKeydown);
    }

    handleClick(event) {
      const tab = event.target.closest('[data-moru-category-tab]');
      if (!tab || !this.contains(tab)) return;
      this.activate(tab, false);
    }

    handleKeydown(event) {
      const tab = event.target.closest('[data-moru-category-tab]');
      if (!tab || !this.contains(tab)) return;

      const index = this.tabs.indexOf(tab);
      if (index < 0) return;

      let nextIndex = null;
      if (event.key === 'ArrowRight') nextIndex = (index + 1) % this.tabs.length;
      if (event.key === 'ArrowLeft') nextIndex = (index - 1 + this.tabs.length) % this.tabs.length;
      if (event.key === 'Home') nextIndex = 0;
      if (event.key === 'End') nextIndex = this.tabs.length - 1;
      if (nextIndex === null) return;

      event.preventDefault();
      this.activate(this.tabs[nextIndex], true);
    }

    activate(activeTab, shouldFocus) {
      const targetId = activeTab.dataset.target;

      this.tabs.forEach((tab) => {
        const isActive = tab === activeTab;
        tab.classList.toggle('is-active', isActive);
        tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
        tab.tabIndex = isActive ? 0 : -1;
      });

      this.panels.forEach((panel) => {
        panel.hidden = panel.id !== targetId;
      });

      if (shouldFocus) activeTab.focus();
    }
  }

  if (!customElements.get('moru-category-tabs')) {
    customElements.define('moru-category-tabs', MoruCategoryTabs);
  }
{% endjavascript %}

{% schema %}
{
  "name": "カテゴリー切替グリッド",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "見出し",
      "default": "カテゴリーから探す"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 1,
      "label": "カテゴリーごとの表示商品数",
      "default": 8
    },
    {
      "type": "select",
      "id": "columns",
      "label": "PCの商品列数",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "「すべて見る」を表示",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "「すべて見る」文言",
      "default": "すべて見る"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "カテゴリー",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "表示名"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "コレクション"
        }
      ]
    }
  ],
  "max_blocks": 7,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "presets": [
    {
      "name": "カテゴリー切替グリッド",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
