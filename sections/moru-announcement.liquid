<div class="moru-announcement full-width">
  {% if section.settings.link != blank %}
    <a class="moru-announcement__text" href="{{ section.settings.link }}">{{ section.settings.text }}</a>
  {% else %}
    <p class="moru-announcement__text">{{ section.settings.text }}</p>
  {% endif %}
</div>

{% stylesheet %}
  .moru-announcement {
    padding: 9px 16px;
    background-color: var(--color-bg-alt);
    border-block-end: 1px solid rgb(0 0 0 / 0.03);
    text-align: center;
  }

  .moru-announcement__text {
    display: block;
    margin: 0;
    color: var(--color-muted);
    font-size: 11.5px;
    font-weight: 400;
    letter-spacing: 0.06em;
    text-decoration: none;
  }

  @media (max-width: 860px) {
    .moru-announcement {
      padding: 7px 12px;
    }

    .moru-announcement__text {
      font-size: 10.5px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:moru.announcement.name",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "t:moru.announcement.text_label",
      "default": "t:moru.announcement.text_default"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:moru.announcement.link_label"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  },
  "presets": [
    {
      "name": "t:moru.announcement.name"
    }
  ]
}
{% endschema %}
