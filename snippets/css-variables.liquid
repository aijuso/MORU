{% style %}
  {% # Loads display, heading and body font variations with display: swap %}
  {{ settings.type_display_font | font_face: font_display: 'swap' }}
  {{ settings.type_heading_font | font_face: font_display: 'swap' }}
  {{ settings.type_body_font | font_face: font_display: 'swap' }}
  {{ settings.type_body_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}

  :root {
    --font-display--family: {{ settings.type_display_font.family }}, {{ settings.type_display_font.fallback_families }};
    --font-display--style: {{ settings.type_display_font.style }};
    --font-display--weight: {{ settings.type_display_font.weight }};
    --font-heading--family: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};
    --font-heading--style: {{ settings.type_heading_font.style }};
    --font-heading--weight: {{ settings.type_heading_font.weight }};
    --font-body--family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
    --font-body--style: {{ settings.type_body_font.style }};
    --font-body--weight: {{ settings.type_body_font.weight }};

    --page-width: {{ settings.max_page_width }};
    --page-margin: {{ settings.min_page_margin }}px;

    {% # MORU design tokens (docs/01) — always reference these, never raw HEX %}
    --color-bg: {{ settings.background_color }};
    --color-bg-alt: {{ settings.background_alt_color }};
    --color-wood: {{ settings.wood_color }};
    --color-text: {{ settings.foreground_color }};
    --color-accent-olive: {{ settings.accent_olive_color }};
    --color-accent-terracotta: {{ settings.accent_terracotta_color }};
    --color-accent-blue: {{ settings.accent_blue_color }};
    --color-accent-burgundy: {{ settings.accent_burgundy_color }};
    --color-muted: {{ settings.muted_text_color }};
    --color-border: {{ settings.border_color }};
    --color-sale: {{ settings.sale_color }};

    {% # Aliases kept for Skeleton base styles %}
    --color-background: var(--color-bg);
    --color-foreground: var(--color-text);

    --style-border-radius-inputs: {{ settings.input_corner_radius }}px;
    --radius-card: {{ settings.card_corner_radius }}px;
  }
{% endstyle %}
